{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "node.ts",
    "app.ts",
    "core/**/*.ts",
    "carriers/**/*.ts",
    "providers/**/*.ts",
    "places/**/*.ts",
    "facade/**/*.ts",
    "server/**/*.ts",
    "cli/**/*.ts",
    "scripts/carrier-canary.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.live.test.ts",
    "core/testing",
    "node_modules",
    "dist"
  ]
}
