{
  "id": "huuneh",
  "displayName": "Huuneh",
  "aliases": [],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#347db8"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "huuneh",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "sender_name",
    "receiver_name",
    "receiver_address"
  ],
  "portal": {
    "url": "https://huuneh.com/dashboard/track.php?order_track={trackingNumber}",
    "searchUrl": "https://huuneh.com/dashboard/tracking.php",
    "canaryUrl": "https://huuneh.com/dashboard/tracking.php",
    "shows": [
      "status",
      "history",
      "remarks",
      "sender_name",
      "sender_address",
      "receiver_name",
      "receiver_address",
      "origin",
      "destination",
      "shipped_on",
      "pieces",
      "contents"
    ],
    "scraped": [
      "status",
      "history",
      "remarks",
      "sender_name",
      "receiver_name",
      "receiver_address"
    ],
    "discarded": [
      "sender_address",
      "origin",
      "shipped_on",
      "pieces",
      "contents"
    ],
    "unavailable": [
      "location",
      "offset_timestamps",
      "eta",
      "weight",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "huuneh.com",
        "www.huuneh.com"
      ],
      "pathPattern": "^/dashboard/track\\.php$",
      "params": [
        "order_track"
      ]
    }
  ],
  "detection": []
}
