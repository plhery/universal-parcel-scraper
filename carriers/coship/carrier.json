{
  "id": "coship",
  "displayName": "COSHIP",
  "aliases": [
    "Canada Orient Shipping",
    "Canada Orient Shipping Ltd.",
    "캐나다쉬핑"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#e40613"
  },
  "selectable": true,
  "timezone": "America/Vancouver",
  "tracking": {
    "mode": "automatic",
    "adapter": "coship",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.coship.ca/tracking/?no={trackingNumber}",
    "searchUrl": "https://www.coship.ca/tracking/",
    "helpUrl": "https://www.coship.ca/contact/",
    "canaryUrl": "https://www.coship.ca/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "progress_rail",
      "route"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "provider_code"
    ],
    "discarded": [
      "progress_rail",
      "route",
      "recipient_name",
      "recipient_address",
      "contents",
      "piece_count",
      "order_reference",
      "remarks",
      "signed_by",
      "driver_name"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "sender_name",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.coship.ca",
        "coship.ca"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "no"
      ]
    }
  ],
  "detection": []
}
