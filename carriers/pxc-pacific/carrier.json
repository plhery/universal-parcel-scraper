{
  "id": "pxc-pacific",
  "displayName": "PXC Pacific Global",
  "aliases": [
    "Pacific express",
    "PXC Pacific Global Private Limited"
  ],
  "region": {
    "countries": [
      "IN",
      "GB"
    ]
  },
  "brand": {
    "color": "#1c4b8c"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "pxc-pacific",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://pacificexp.net/tracking-details.html?awbno={trackingNumber}",
    "searchUrl": "https://pacificexp.net/tracking-details.html",
    "helpUrl": "https://pacificexp.net/contact-us.html",
    "canaryUrl": "https://pacificexp.net/tracking-details.html",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "recipient_name",
      "signatory",
      "delivered_at",
      "awb_date",
      "service_name",
      "remarks",
      "delivery_tracking_number",
      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "recipient_name",
      "signatory",
      "delivered_at",
      "awb_date",
      "service_name",
      "remarks"
    ],
    "unavailable": [
      "eta",
      "sender_name",
      "recipient_address",
      "weight",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "pacificexp.net",
        "www.pacificexp.net"
      ],
      "pathPattern": "^/tracking-details\\.html$",
      "params": [
        "awbno"
      ]
    }
  ],
  "detection": []
}
