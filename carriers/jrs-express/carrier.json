{
  "id": "jrs-express",
  "displayName": "JRS Express",
  "aliases": [
    "JRS",
    "JRS Business Corporation"
  ],
  "region": {
    "countries": [
      "PH"
    ]
  },
  "brand": {
    "color": "#046a38"
  },
  "selectable": true,
  "timezone": "Asia/Manila",
  "tracking": {
    "mode": "automatic",
    "adapter": "jrs-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://jrs-express.com/track?or={trackingNumber}",
    "searchUrl": "https://jrs-express.com/track",
    "canaryUrl": "https://jrs-express.com/track",
    "shows": [
      "status",
      "history",
      "scan_times",
      "location",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "scan_times",
      "location"
    ],
    "discarded": [
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery",
      "origin",
      "destination"
    ]
  },
  "links": [
    {
      "domains": [
        "jrs-express.com",
        "www.jrs-express.com"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "or"
      ]
    }
  ],
  "detection": []
}
