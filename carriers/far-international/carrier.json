{
  "id": "far-international",
  "displayName": "FAR International",
  "aliases": [
    "FAR",
    "FAR International Logistics",
    "Far International Logistics",
    "泛远国际",
    "泛远国际物流"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#003b75"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "far-international",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "offset_timestamps",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.far800.com/logistics/result?key={trackingNumber}",
    "searchUrl": "https://www.far800.com/",
    "canaryUrl": "https://www.far800.com/",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at",
      "delivery_tracking_number"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "destination_country",
      "delivery_partner",
      "sender_name",
      "recipient_name",
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": [
        "www.far800.com"
      ],
      "pathPattern": "^/(?:en/)?logistics/result/?$",
      "params": [
        "key"
      ],
      "ownNumbersOnly": true
    }
  ],
  "detection": [
    {
      "id": "far-international-1",
      "pattern": "^FAR[A-Z]{2}\\d{10}YQ$",
      "confidence": "high"
    }
  ]
}
