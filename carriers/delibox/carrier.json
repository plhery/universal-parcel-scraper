{
  "id": "delibox",
  "displayName": "Delibox",
  "aliases": [
    "딜리박스",
    "딜리박스중앙 주식회사"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#f04e23"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "delibox",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.dbox.co.kr/delivery.php?laasInvcNo={trackingNumber}",
    "searchUrl": "https://www.dbox.co.kr/delivery.php",
    "canaryUrl": "https://www.dbox.co.kr/delivery.php",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "driver_name",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "driver_name",
      "proof_of_delivery"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "dbox.co.kr",
        "www.dbox.co.kr"
      ],
      "pathPattern": "^/delivery\\.php$",
      "params": [
        "laasInvcNo"
      ]
    }
  ],
  "detection": []
}
