{
  "id": "libanpost",
  "displayName": "LibanPost",
  "aliases": [
    "Liban Post",
    "ليبان بوست"
  ],
  "region": {
    "countries": [
      "LB"
    ]
  },
  "brand": {
    "color": "#006db7"
  },
  "selectable": true,
  "timezone": "Asia/Beirut",
  "tracking": {
    "mode": "automatic",
    "adapter": "libanpost",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.libanpost.com/TrackandTraceMobile.aspx?sn={trackingNumber}&lang=2",
    "searchUrl": "https://www.libanpost.com/english/tools-support/track-and-trace",
    "canaryUrl": "https://www.libanpost.com/english/tools-support/track-and-trace",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "origin_country",
      "destination_country",
      "signatory",
      "sending_date"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name",
      "destination_country"
    ],
    "discarded": [
      "origin_country",
      "signatory",
      "sending_date"
    ],
    "unavailable": [
      "eta",
      "weight",
      "offset_timestamps",
      "recipient_name",
      "sender_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.libanpost.com",
        "libanpost.com"
      ],
      "pathPattern": "^/(?:english|arabic)/tools-support/track-and-trace/?$",
      "params": [
        "sn"
      ]
    },
    {
      "domains": [
        "www.libanpost.com",
        "libanpost.com"
      ],
      "pathPattern": "^/TrackandTraceMobile\\.aspx$",
      "params": [
        "sn"
      ]
    }
  ],
  "detection": []
}
