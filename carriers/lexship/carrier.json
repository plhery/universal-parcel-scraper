{
  "id": "lexship",
  "displayName": "LEXSHIP",
  "aliases": [
    "LogiLink India Pvt Ltd"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#0097d6"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "lexship",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "destination_country"
  ],
  "portal": {
    "url": "https://track.lexship.biz/?tracking={trackingNumber}",
    "searchUrl": "https://track.lexship.biz/",
    "helpUrl": "https://www.lexship.com/contact",
    "canaryUrl": "https://track.lexship.biz/",
    "shows": [
      "status",
      "history",
      "scan_times",
      "origin",
      "destination",
      "recipient_name"
    ],
    "scraped": [
      "status",
      "history",
      "scan_times",
      "destination_country"
    ],
    "discarded": [
      "origin",
      "destination",
      "recipient_name"
    ],
    "unavailable": [
      "location",
      "eta",
      "offset_timestamps",
      "weight",
      "sender_name",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "track.lexship.biz"
      ],
      "pathPattern": "^/$",
      "params": [
        "tracking"
      ]
    }
  ],
  "detection": []
}
