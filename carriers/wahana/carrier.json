{
  "id": "wahana",
  "displayName": "Wahana Express",
  "aliases": [
    "Wahana",
    "Wahana Prestasi Logistik",
    "PT Wahana Prestasi Logistik"
  ],
  "region": {
    "countries": [
      "ID"
    ]
  },
  "brand": {
    "color": "#1e4eb8"
  },
  "selectable": true,
  "timezone": "Asia/Jakarta",
  "tracking": {
    "mode": "automatic",
    "adapter": "wahana",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://www.wahana.com/lacak-kiriman?noresi={trackingNumber}",
    "searchUrl": "https://www.wahana.com/",
    "canaryUrl": "https://www.wahana.com/",
    "shows": [
      "status",
      "history",
      "origin",
      "destination",
      "sender_name",
      "recipient_name",
      "phone_numbers"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [
      "origin",
      "destination",
      "sender_name",
      "recipient_name",
      "phone_numbers"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.wahana.com",
        "wahana.com"
      ],
      "pathPattern": "^/lacak-kiriman/?$",
      "params": [
        "noresi"
      ]
    }
  ],
  "detection": []
}
