{
  "id": "gel-express",
  "displayName": "GEL Express",
  "aliases": [
    "GEL Express Logistik",
    "GEL Express Logistik GmbH"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#d9002b"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "gel-express",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "delivered_at"
  ],
  "portal": {
    "url": "https://www.gel-express.de/de/sendungsverfolgung/?snr={trackingNumber}",
    "searchUrl": "https://www.gel-express.de/de/sendungsverfolgung/",
    "helpUrl": "https://www.gel-express.de/de/kontakt/",
    "canaryUrl": "https://www.gel-express.de/de/sendungsverfolgung/",
    "shows": [
      "status",
      "scan_times",
      "ship_date",
      "piece_count",
      "shipper_reference",
      "progress_rail"
    ],
    "scraped": [
      "status",
      "scan_times",
      "delivered_at"
    ],
    "discarded": [
      "ship_date",
      "piece_count",
      "shipper_reference",
      "progress_rail"
    ],
    "unavailable": [
      "history",
      "location",
      "offset_timestamps",
      "eta",
      "weight",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "gel-express.de"
      ],
      "pathPattern": "^/(?:(?:de|en)/)?sendungsverfolgung/?$",
      "params": [
        "snr"
      ]
    },
    {
      "domains": [
        "thalmaier.de"
      ],
      "pathPattern": "^/gelsend/suche\\.php$",
      "params": [
        "sean"
      ]
    }
  ],
  "detection": []
}
