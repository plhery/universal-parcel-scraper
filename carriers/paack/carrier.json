{
  "id": "paack",
  "displayName": "Paack",
  "aliases": [
    "Paack Logistics"
  ],
  "region": {
    "countries": [
      "ES",
      "PT",
      "FR",
      "IT",
      "GB"
    ]
  },
  "brand": {
    "color": "#5b2dee"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "paack",
    "requirements": [
      {
        "field": "postcode",
        "validator": "paackPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Delivery postcode",
        "type": "text",
        "placeholder": "75001",
        "help": "Paack shows most orders only with the delivery postcode. Without it, other sources are asked.",
        "pattern": "^(?=.{3,10}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ -][A-Za-z0-9]+)*$",
        "maxLength": 10,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "evri"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "weight",
    "eta",
    "pickup_point"
  ],
  "portal": {
    "url": "https://mydeliveries.paack.app/tracking?tracking_number={trackingNumber}",
    "searchUrl": "https://mydeliveries.paack.app/tracking",
    "helpUrl": "https://help.paack.app/es/support/home",
    "canaryUrl": "https://mydeliveries.paack.app/tracking",
    "shows": [
      "status",
      "history",
      "eta",
      "eta_window",
      "pickup_point",
      "pickup_code",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "eta_window",
      "pickup_point"
    ],
    "discarded": [
      "pickup_code",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "mydeliveries.paack.app"
      ],
      "params": [
        "tracking_number"
      ]
    },
    {
      "domains": [
        "paack.co"
      ],
      "pathPattern": "^/shipments/tracking(?:/|$)",
      "params": [
        "tracking_number"
      ]
    }
  ],
  "detection": [
    {
      "id": "paack-1",
      "pattern": "^PK\\d{18}$",
      "confidence": "high"
    },
    {
      "id": "paack-5340",
      "pattern": "^5340\\d{14}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "paack-shein",
      "pattern": "^[CE]2\\d(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{8}$",
      "confidence": "low"
    }
  ]
}
