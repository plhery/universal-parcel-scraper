{
  "id": "tforce-logistics",
  "displayName": "TForce Logistics",
  "aliases": [
    "TForce Final Mile",
    "TForce Final Mile Canada",
    "Dynamex",
    "Dynamex Canada",
    "Dynamex U.S.",
    "Hazen Final Mile"
  ],
  "region": {
    "countries": [
      "CA",
      "US"
    ]
  },
  "brand": {
    "color": "#054b8b"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "tforce-logistics",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://direct.tfesg.com/finalmiletrack/Track?trackingNumber={trackingNumber}&brand=0",
    "searchUrl": "https://www.tforcelogistics.com/",
    "helpUrl": "https://www.tforcelogistics.com/contact/",
    "canaryUrl": "https://www.tforcelogistics.com/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "parcel_count",
      "weight",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "origin",
      "destination",
      "parcel_count",
      "weight",
      "eta"
    ],
    "unavailable": [
      "proof_of_delivery",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "direct.tfesg.com"
      ],
      "pathPattern": "^/finalmiletrack/(?:Track|track/externalTracking\\.jsp)$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "tforce-logistics-1",
      "pattern": "^TF(?:\\d{12,13}|1\\d{17})$",
      "confidence": "high"
    }
  ]
}
