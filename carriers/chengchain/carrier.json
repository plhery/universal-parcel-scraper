{
  "id": "chengchain",
  "displayName": "Chengchuang Supply Chain",
  "aliases": [
    "ChengChain",
    "诚创供应链",
    "浙江诚创供应链有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#213780"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "chengchain",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_tracking_number"
  ],
  "portal": {
    "canaryUrl": "https://t.17track.net/",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_tracking_number",
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_tracking_number"
    ],
    "discarded": [
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "zjcc.rtb56.com"
      ],
      "pathPattern": "^/track_query\\.aspx$",
      "params": [
        "track_number"
      ]
    }
  ],
  "detection": []
}
