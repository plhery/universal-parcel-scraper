{
  "id": "ait-worldwide",
  "displayName": "AIT Worldwide Logistics",
  "aliases": [
    "AIT",
    "AIT Worldwide"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#0055a5"
  },
  "selectable": true,
  "timezone": "America/Chicago",
  "tracking": {
    "mode": "automatic",
    "adapter": "ait-worldwide",
    "steps": [
      "direct",
      "retry",
      "trawl"
    ],
    "recognition": {
      "rank": 625
    },
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "eta"
  ],
  "portal": {
    "url": "https://fastrak.aitworldwide.com/?trackingnumber={trackingNumber}",
    "searchUrl": "https://fastrak.aitworldwide.com/",
    "canaryUrl": "https://fastrak.aitworldwide.com/",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "provider_code",
      "eta",
      "eta_window",
      "delivered_at",
      "destination",
      "signatory",
      "event_details",
      "office_contact_details",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "progress_rail",
      "history",
      "provider_code",
      "eta",
      "eta_window"
    ],
    "discarded": [
      "delivered_at",
      "destination",
      "signatory",
      "event_details",
      "office_contact_details",
      "delivery_options"
    ],
    "unavailable": [
      "offset_timestamps",
      "location",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "fastrak.aitworldwide.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "trackingnumber"
      ]
    }
  ],
  "detection": []
}
