{
  "id": "flight-logistics",
  "displayName": "Flight Logistics",
  "aliases": [
    "Flight Logistics Group",
    "Flight Logistics Group Ltd"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#007ac3"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "flight-logistics",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.flightlg.com/myflight-shipment-tracking/?method=tracking&consign_note={trackingNumber}",
    "searchUrl": "https://www.flightlg.com/myflight-shipment-tracking/?method=tracking",
    "helpUrl": "https://www.flightlg.com/contact-us/",
    "canaryUrl": "https://www.flightlg.com/myflight-shipment-tracking/",
    "shows": [
      "status",
      "history",
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "coordinates",
      "delivery_tracking_number",
      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "coordinates"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.flightlg.com",
        "flightlg.com"
      ],
      "pathPattern": "^/myflight-shipment-tracking/?$",
      "params": [
        "consign_note"
      ]
    }
  ],
  "detection": []
}
