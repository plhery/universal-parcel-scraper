{
  "id": "azul-cargo",
  "displayName": "Azul Cargo Express",
  "aliases": [
    "Azul Cargo",
    "Azul Linhas Aéreas Cargo"
  ],
  "region": {
    "countries": [
      "BR"
    ]
  },
  "brand": {
    "color": "#011e40"
  },
  "selectable": true,
  "timezone": "America/Sao_Paulo",
  "tracking": {
    "mode": "automatic",
    "adapter": "azul-cargo",
    "steps": [
      "trawl"
    ],
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.azullogistica.com.br/Rastreio/Rastrear?awb={trackingNumber}",
    "searchUrl": "https://www.azullogistica.com.br/Rastreio",
    "helpUrl": "https://www.azullogistica.com.br/Institucional/Contato",
    "canaryUrl": "https://www.azullogistica.com.br/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "signatory",
      "weight",
      "service_name",
      "parcel_count",
      "origin",
      "destination",
      "progress_rail"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "signatory",
      "weight",
      "service_name"
    ],
    "discarded": [
      "parcel_count",
      "origin",
      "destination",
      "progress_rail"
    ],
    "unavailable": [
      "offset_timestamps",
      "recipient_name",
      "recipient_address",
      "sender_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.azullogistica.com.br",
        "azullogistica.com.br"
      ],
      "pathPattern": "^/+Rastreio/Rastrear$",
      "params": [
        "awb"
      ]
    },
    {
      "domains": [
        "www.azulcargoexpress.com.br",
        "azulcargoexpress.com.br",
        "www.azulcargo.com.br"
      ],
      "pathPattern": "^/+Rastreio\\.aspx$",
      "params": [
        "n"
      ]
    }
  ],
  "detection": []
}
