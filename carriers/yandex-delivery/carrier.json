{
  "id": "yandex-delivery",
  "displayName": "Yandex Delivery",
  "aliases": [
    "Яндекс Доставка",
    "Яндекс.Доставка",
    "ООО «Яндекс.Доставка»",
    "Boxberry",
    "Боксберри"
  ],
  "region": {
    "countries": [
      "RU"
    ]
  },
  "brand": {
    "color": "#fc4714"
  },
  "selectable": true,
  "timezone": "Europe/Moscow",
  "tracking": {
    "mode": "automatic",
    "adapter": "yandex-delivery",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://dostavka.yandex.ru/ndd/tracking/?order_tracking_id={trackingNumber}",
    "searchUrl": "https://dostavka.yandex.ru/ndd/tracking/",
    "helpUrl": "https://dostavka.yandex.ru/support/",
    "canaryUrl": "https://dostavka.yandex.ru/ndd/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "pickup_deadline",
      "event_details"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "pickup_deadline",
      "event_details"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "dostavka.yandex.ru"
      ],
      "pathPattern": "^/ndd/tracking/?$",
      "params": [
        "order_tracking_id"
      ]
    }
  ],
  "detection": []
}
