{
  "id": "rxo",
  "displayName": "RXO",
  "aliases": [
    "RXO Order Number and Retailer Number tracking",
    "RXO Inc.",
    "RXO Last Mile",
    "XPO Last Mile",
    "XPO Logistics Last Mile"
  ],
  "region": {
    "countries": [
      "US",
      "CA"
    ]
  },
  "brand": {
    "color": "#000000"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "rxo",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta_window",
    "sender_name"
  ],
  "portal": {
    "url": "https://track.rxo.com/?trackingnumber={trackingNumber}",
    "searchUrl": "https://track.rxo.com/",
    "helpUrl": "https://rxo.com/contact-us/",
    "canaryUrl": "https://rxo.com/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "eta_window",
      "progress_rail",
      "sender_name",
      "order_contents"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "eta_window",
      "sender_name",
      "failed_delivery_reason"
    ],
    "discarded": [
      "order_contents",
      "customer_reference",
      "coordinates",
      "origin"
    ],
    "unavailable": [
      "offset_timestamps",
      "weight",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "track.rxo.com",
        "track.xpo.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "trackingnumber"
      ]
    }
  ],
  "detection": []
}
