{
  "id": "szctc",
  "displayName": "CTC Supply Chain",
  "aliases": [
    "赤兔猫供应链",
    "深圳市赤兔猫供应链有限公司",
    "SZCTC"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#d32f2f"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "szctc",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number",
    "offset_timestamps"
  ],
  "portal": {
    "canaryUrl": "https://t.17track.net/",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_tracking_number",
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "offset_timestamps"
    ],
    "discarded": [
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "szctc.rtb56.com"
      ],
      "pathPattern": "^/track_query\\.aspx$",
      "params": [
        "nums",
        "track_number"
      ]
    }
  ],
  "detection": []
}
