{
  "id": "asendia",
  "displayName": "Asendia",
  "aliases": [
    "Asendia Management",
    "Asendia UK",
    "asendia.com",
    "Asendia USA",
    "Globegistics",
    "Globegistics Inc."
  ],
  "region": {
    "countries": [
      "FR",
      "CH",
      "GB",
      "DE",
      "US"
    ]
  },
  "brand": {
    "color": "#005d69"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "asendia",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Delivery postcode",
        "type": "text",
        "help": "Optional. Asendia's European tracker shows the scans only with the delivery postcode; without it, the current status.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "trawl"
    ],
    "recognition": {
      "rank": 675
    },
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "weight"
  ],
  "portal": {
    "url": "https://track.asendia.com/track/{trackingNumber}",
    "searchUrl": "https://track.asendia.com/track/",
    "canaryUrl": "https://a1.asendiausa.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "weight"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "weight"
    ],
    "discarded": [],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "track.asendia.com"
      ],
      "path": "^/track/([^/?#]+)/?$"
    },
    {
      "domains": [
        "a1.asendiausa.com",
        "a1.asendia.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "trackingnumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "asendia-1",
      "pattern": "^ASE[A-Z0-9]{8,37}$",
      "confidence": "high"
    },
    {
      "id": "asendia-2",
      "pattern": "^AS\\d{9}US$",
      "confidence": "high"
    },
    {
      "id": "asendia-3",
      "pattern": "^AHOY[A-Z0-9]{8}$",
      "confidence": "high"
    },
    {
      "id": "asendia-4",
      "pattern": "^ESUS\\d{9}$",
      "confidence": "low"
    }
  ]
}
