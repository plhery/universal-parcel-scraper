{
  "id": "bulgarian-posts",
  "displayName": "Bulgarian Posts",
  "aliases": [
    "Български пощи",
    "Bulgarian Post",
    "Bulgaria Post",
    "BG Post",
    "Balgarski Poshti"
  ],
  "region": {
    "countries": [
      "BG"
    ]
  },
  "brand": {
    "color": "#ffd100"
  },
  "selectable": true,
  "timezone": "Europe/Sofia",
  "tracking": {
    "mode": "automatic",
    "adapter": "bulgarian-posts",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 915
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at"
  ],
  "portal": {
    "url": "https://www.bgpost.bg/postal-services/track-package?itemid={trackingNumber}",
    "searchUrl": "https://www.bgpost.bg/postal-services/track-package",
    "canaryUrl": "https://www.bgpost.bg/postal-services/track-package",
    "shows": [
      "status",
      "history",
      "location",
      "postcodes",
      "event_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "event_details",
      "delivered_at"
    ],
    "discarded": [
      "postcodes"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "origin_country",
      "destination_country",
      "offset_timestamps",
      "recipient_name",
      "sender_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "bgpost.bg"
      ],
      "pathPattern": "^(?:/en)?/postal-services/track-package/?$",
      "params": [
        "itemid"
      ]
    },
    {
      "domains": [
        "bgpost.bg"
      ],
      "pathPattern": "^/IPSWebTracking/IPSWeb_item_events\\.asp$",
      "params": [
        "itemid"
      ]
    }
  ],
  "detection": [
    {
      "id": "bulgarian-posts-1",
      "pattern": "^PS[0-9A-Z]{11}$",
      "confidence": "high"
    },
    {
      "id": "bulgarian-posts-s10",
      "pattern": "^[A-Z]{2}\\d{9}BG$",
      "confidence": "low",
      "preferred": true,
      "checksum": "s10"
    }
  ]
}
