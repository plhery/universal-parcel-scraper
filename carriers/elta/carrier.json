{
  "id": "elta",
  "displayName": "ELTA Hellenic Post",
  "aliases": [
    "ELTA",
    "ΕΛΤΑ",
    "Hellenic Post",
    "Ελληνικά Ταχυδρομεία",
    "ELTA Courier",
    "ΕΛΤΑ Courier",
    "ISS Parcels",
    "IS&S Parcels"
  ],
  "region": {
    "countries": [
      "GR"
    ]
  },
  "brand": {
    "color": "#0063a9"
  },
  "selectable": true,
  "timezone": "Europe/Athens",
  "tracking": {
    "mode": "automatic",
    "adapter": "elta",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 150
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "pickup_point"
  ],
  "portal": {
    "url": "https://www.elta.gr/track?code={trackingNumber}",
    "searchUrl": "https://www.elta.gr/track",
    "canaryUrl": "https://www.elta.gr/track",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "pickup_point"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "elta.gr"
      ],
      "pathPattern": "^/(?:en/)?track/?$",
      "params": [
        "code"
      ]
    },
    {
      "domains": [
        "elta-courier.gr"
      ],
      "pathPattern": "^/search/?$",
      "params": [
        "br"
      ]
    },
    {
      "domains": [
        "elta.gr"
      ],
      "pathPattern": "^/(?:el-gr/(?:tabid/93|[^/]+\\.aspx)|en-us/personal/tracktrace\\.aspx)/?$",
      "params": [
        "qc"
      ]
    },
    {
      "domains": [
        "elta.gr"
      ],
      "path": "^/personal/tracktrace/tabid/[0-9]+/qc/([^/?#]+)(?:/|$)"
    }
  ],
  "detection": [
    {
      "id": "elta-s10",
      "pattern": "^[A-Z]{2}\\d{9}GR$",
      "confidence": "low",
      "preferred": true,
      "checksum": "s10"
    }
  ]
}
