{
  "id": "gebrueder-weiss",
  "displayName": "Gebrüder Weiss",
  "aliases": [
    "Gebrueder Weiss",
    "Gebruder Weiss",
    "GW"
  ],
  "region": {
    "countries": [
      "AT",
      "DE",
      "CH"
    ]
  },
  "brand": {
    "color": "#ff6600"
  },
  "selectable": true,
  "timezone": "Europe/Vienna",
  "tracking": {
    "mode": "automatic",
    "adapter": "gebrueder-weiss",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Sender or recipient postcode",
        "type": "text",
        "help": "Gebrüder Weiss shows a shipment only with its sender's or recipient's postcode. Without it, other sources are asked.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "weight",
    "service_name",
    "delivered_at"
  ],
  "portal": {
    "searchUrl": "https://my.gw-world.com/trackntrace/-/search/",
    "canaryUrl": "https://my.gw-world.com/trackntrace/-/search/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "weight",
      "service_name",
      "offset_timestamps",
      "postcodes",
      "addresses",
      "customer_reference",
      "progress_rail",
      "remarks",
      "internal_events",
      "proof_of_delivery",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta",
      "weight",
      "service_name",
      "offset_timestamps"
    ],
    "discarded": [
      "postcodes",
      "addresses",
      "customer_reference",
      "progress_rail",
      "remarks",
      "internal_events",
      "proof_of_delivery",
      "delivery_options"
    ],
    "unavailable": [
      "sender_name",
      "recipient_name",
      "pickup_point",
      "dimensions"
    ]
  },
  "links": [
    {
      "domains": [
        "my.gw-world.com"
      ],
      "path": "^/(?:[a-z]{2}(?:[-_][A-Za-z]{2})?/)?trackntrace/-/search/[^/]+/([^/?#]+)(?:/[^/?#]*)?/?$"
    }
  ],
  "detection": []
}
