{
  "id": "shree-maruti",
  "displayName": "Shree Maruti Courier",
  "aliases": [
    "Shree Maruti",
    "Shree Maruti Courier Services",
    "Shree Maruti Courier Services Private Limited",
    "Shree Maruti Courier Service",
    "Innofulfill",
    "Maruti Courier"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#2a3680"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "shree-maruti",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 822
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivered_at"
  ],
  "portal": {
    "url": "https://shreemaruti.com/track-shipment/?awb={trackingNumber}",
    "searchUrl": "https://shreemaruti.com/track-shipment/",
    "canaryUrl": "https://shreemaruti.com/track-shipment/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "postcodes",
      "delivered_at",
      "progress_rail",
      "customer_reference",
      "awb_date"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "offset_timestamps",
      "delivered_at",
      "failed_delivery_reason"
    ],
    "discarded": [
      "origin",
      "destination",
      "postcodes",
      "customer_reference",
      "awb_date",
      "progress_rail"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "shreemaruti.com"
      ],
      "pathPattern": "^/track-shipment/?$",
      "params": [
        "awb"
      ]
    },
    {
      "domains": [
        "shreemaruti.com",
        "clients.shreemaruti.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "d"
      ]
    },
    {
      "domains": [
        "tracking.shreemaruti.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "d",
        "shipmentNo"
      ]
    },
    {
      "domains": [
        "tracking.shreemaruti.com"
      ],
      "path": "^/(\\d{12,14})/?$"
    },
    {
      "domains": [
        "shreemaruti.com",
        "shreemaruticourier.com"
      ],
      "pathPattern": "^/track-your-shipment/?$",
      "params": [
        "tracking_id"
      ]
    }
  ],
  "detection": []
}
