{
  "id": "maltapost",
  "displayName": "MaltaPost",
  "aliases": [
    "Malta Post",
    "MaltaPost p.l.c."
  ],
  "region": {
    "countries": [
      "MT"
    ]
  },
  "brand": {
    "color": "#d43b2c"
  },
  "selectable": true,
  "timezone": "Europe/Malta",
  "tracking": {
    "mode": "automatic",
    "adapter": "maltapost",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 50
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "pickup_point"
  ],
  "portal": {
    "url": "https://www.maltapost.com/tracking#/tracking?barcode={trackingNumber}",
    "searchUrl": "https://www.maltapost.com/tracking",
    "canaryUrl": "https://www.maltapost.com/tracking",
    "shows": [
      "status",
      "history",
      "location",
      "event_details",
      "progress_rail",
      "tracking_alias",
      "payment_details",
      "recipient_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "event_details",
      "provider_code",
      "pickup_point"
    ],
    "discarded": [
      "progress_rail",
      "tracking_alias",
      "payment_details",
      "recipient_details"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "proof_of_delivery",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "maltapost.com"
      ],
      "pathPattern": "^/tracking/?$",
      "fragment": "^/tracking\\?(?:[^&]*&)*barcode=([^&]+)"
    }
  ],
  "detection": [
    {
      "id": "maltapost-s10",
      "pattern": "^[A-Z]{2}\\d{9}MT$",
      "confidence": "low",
      "preferred": true,
      "checksum": "s10"
    },
    {
      "id": "maltapost-sengi",
      "pattern": "^[A-Z]{5}\\d{9}MT$",
      "confidence": "low"
    }
  ]
}
