{
  "id": "japan-post",
  "displayName": "Japan Post",
  "aliases": [],
  "region": {
    "countries": [
      "JP"
    ]
  },
  "brand": {
    "color": "#cc0000"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "japan-post",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "delivered_at"
  ],
  "portal": {
    "url": "https://trackings.post.japanpost.jp/services/srv/search/direct?reqCodeNo1={trackingNumber}&locale=en",
    "canaryUrl": "https://trackings.post.japanpost.jp/services/srv/search",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "delivered_at"
    ],
    "discarded": [
      "event_details",
      "office_postcode",
      "office_contact_details",
      "service_name",
      "size_class",
      "delivery_office",
      "parcel_count"
    ],
    "unavailable": [
      "weight",
      "sender_name",
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": [
        "trackings.post.japanpost.jp"
      ],
      "params": [
        "reqCodeNo1",
        "requestNo1"
      ]
    }
  ],
  "detection": [
    {
      "id": "japan-post-1",
      "pattern": "^[A-Z]{2}\\d{9}JP$",
      "confidence": "high",
      "checksum": "s10"
    },
    {
      "id": "japan-post-domestic",
      "pattern": "^\\d{12}$",
      "confidence": "low",
      "checksum": "mod7"
    },
    {
      "id": "japan-post-registered",
      "pattern": "^\\d{11}$",
      "confidence": "low",
      "checksum": "mod7"
    }
  ]
}
