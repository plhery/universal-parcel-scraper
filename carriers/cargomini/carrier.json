{
  "id": "cargomini",
  "displayName": "CargoMini",
  "aliases": [
    "KargomKolay",
    "DRN Lojistik A.Ş.",
    "CargoMini Express"
  ],
  "region": {
    "countries": [
      "TR"
    ]
  },
  "brand": {
    "color": "#ff0026"
  },
  "selectable": true,
  "timezone": "Europe/Istanbul",
  "tracking": {
    "mode": "automatic",
    "adapter": "cargomini",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://tracking.cargomini.com/{trackingNumber}",
    "searchUrl": "https://tracking.cargomini.com/",
    "canaryUrl": "https://tracking.cargomini.com/",
    "shows": [
      "status",
      "history",
      "scan_times",
      "offset_timestamps",
      "delivery_partner",
      "delivery_tracking_number",
      "sender_name",
      "recipient_name",
      "postcodes",
      "destination",
      "order_reference",
      "weight",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "scan_times",
      "offset_timestamps",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "postcodes",
      "destination",
      "order_reference",
      "weight",
      "eta"
    ],
    "unavailable": [
      "location",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.cargomini.com"
      ],
      "path": "^/([A-Za-z0-9]+)/?$"
    }
  ],
  "detection": []
}
