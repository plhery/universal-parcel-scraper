{
  "id": "mte-xpress",
  "displayName": "MTE Xpress",
  "aliases": [
    "MTE Express Logistics"
  ],
  "region": {
    "countries": [
      "ZA"
    ]
  },
  "brand": {
    "color": "#2a3653"
  },
  "selectable": true,
  "timezone": "Africa/Johannesburg",
  "tracking": {
    "mode": "automatic",
    "adapter": "mte-xpress",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "service_name",
    "provider_code",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://portal.mtexpress.co.za/track?ref={trackingNumber}",
    "searchUrl": "https://portal.mtexpress.co.za/track",
    "helpUrl": "https://mtexpress.co.za/contacts",
    "canaryUrl": "https://portal.mtexpress.co.za/track",
    "shows": [
      "status",
      "history",
      "location",
      "service_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "service_name",
      "provider_code",
      "offset_timestamps"
    ],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "portal.mtexpress.co.za",
        "mtexpress.shiplogic.com"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "ref"
      ]
    }
  ],
  "detection": []
}
