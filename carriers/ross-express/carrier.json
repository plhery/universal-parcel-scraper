{
  "id": "ross-express",
  "displayName": "Ross Express",
  "aliases": [
    "Ross Express, LLC",
    "Ross Express LLC",
    "Ross Express, Inc."
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#bc010c"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "ross-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "weight"
  ],
  "portal": {
    "url": "https://tracking.carrierlogistics.com/scripts/rxic.pol/boldetail.htm?wbtn=PRO&wpro1={trackingNumber}",
    "searchUrl": "https://rossexpress.com/quick_trace.php",
    "helpUrl": "https://www.rossexpress.com/contact/",
    "canaryUrl": "https://www.rossexpress.com/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "delivered_at",
      "weight",
      "parcel_count",
      "customer_reference",
      "origin",
      "destination",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "weight"
    ],
    "discarded": [
      "delivered_at",
      "parcel_count",
      "customer_reference",
      "origin",
      "destination",
      "signatory"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.carrierlogistics.com"
      ],
      "pathPattern": "^/scripts/rxic\\.pol/boldetail\\.htm$",
      "params": [
        "wpro1"
      ]
    },
    {
      "domains": [
        "tracking.carrierlogistics.com"
      ],
      "pathPattern": "^/scripts/rxic\\.pol/facts\\.htm$",
      "params": [
        "pronum"
      ]
    }
  ],
  "detection": []
}
