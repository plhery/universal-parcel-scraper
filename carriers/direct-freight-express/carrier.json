{
  "id": "direct-freight-express",
  "displayName": "Direct Freight Express",
  "aliases": [
    "DFE",
    "Direct Freight",
    "Direct Freight Australia"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#1e4488"
  },
  "selectable": true,
  "timezone": "Australia/Sydney",
  "tracking": {
    "mode": "automatic",
    "adapter": "direct-freight-express",
    "steps": [
      "direct",
      "retry",
      "trawl"
    ],
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://www.directfreight.com.au/ConsignmentStatus.aspx?lookuptype=0&consignment_no={trackingNumber}",
    "searchUrl": "https://www.directfreight.com.au/",
    "canaryUrl": "https://www.directfreight.com.au/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "origin",
      "destination",
      "package_count",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "origin",
      "destination",
      "package_count",
      "proof_of_delivery"
    ],
    "unavailable": [
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.directfreight.com.au",
        "directfreight.com.au"
      ],
      "pathPattern": "^/[Cc]onsignment[Ss]tatus\\.aspx$",
      "params": [
        "consignment_no"
      ]
    }
  ],
  "detection": []
}
