{
  "id": "joom-logistics",
  "displayName": "Joom Logistics",
  "aliases": [
    "Joom Logistics Limited"
  ],
  "region": {
    "countries": [
      "HK",
      "CN"
    ]
  },
  "brand": {
    "color": "#2d2f43"
  },
  "selectable": true,
  "timezone": "Asia/Hong_Kong",
  "tracking": {
    "mode": "automatic",
    "adapter": "joom-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://joomlogistics.com/en/track?id={trackingNumber}",
    "searchUrl": "https://joomlogistics.com/en/track",
    "canaryUrl": "https://joomlogistics.com/en/track",
    "shows": [
      "history",
      "location",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "offset_timestamps",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "weight",
      "delivered_at",
      "service_name",
      "pickup_point",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "joomlogistics.com",
        "logistics.joom.com"
      ],
      "pathPattern": "^/[a-z]{2}/track/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
