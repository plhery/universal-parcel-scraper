{
  "id": "mark-express",
  "displayName": "Mark Express",
  "aliases": [
    "Mark Express Pvt. Ltd.",
    "Mark Express Private Limited",
    "markexpress",
    "Mark Express Courier and Cargo"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#2f2e65"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "mark-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "receiver_name"
  ],
  "portal": {
    "url": "https://crm.markerp.in/Frm_DocTrackWeb.aspx?docno={trackingNumber}",
    "searchUrl": "https://markexpress.co.in/",
    "helpUrl": "https://markexpress.co.in/contact-us",
    "canaryUrl": "https://markexpress.co.in/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "origin",
      "destination",
      "awb_date",
      "recipient_name",
      "scan_times",
      "signatory",
      "office_addresses",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "origin",
      "awb_date",
      "recipient_name",
      "scan_times"
    ],
    "discarded": [
      "destination",
      "signatory",
      "office_addresses",
      "office_contact_details"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "crm.markerp.in"
      ],
      "pathPattern": "^/Frm_DocTrackWeb\\.aspx$",
      "params": [
        "docno"
      ]
    }
  ],
  "detection": []
}
