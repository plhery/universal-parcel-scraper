{
  "id": "aaa-cooper",
  "displayName": "AAA Cooper",
  "aliases": [
    "AAA Cooper Transportation",
    "ACT",
    "Midwest Motor Express"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#113c77"
  },
  "selectable": true,
  "timezone": "America/Chicago",
  "tracking": {
    "mode": "automatic",
    "adapter": "aaa-cooper",
    "steps": [
      "direct",
      "retry",
      "captcha"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.aaacooper.com/workspace/action-trac?id={trackingNumber}&PG=ProNumber",
    "searchUrl": "https://www.aaacooper.com/",
    "canaryUrl": "https://www.aaacooper.com/",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_office",
      "delivered_at",
      "signatory",
      "parcel_count",
      "weight",
      "references",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "delivery_office",
      "delivered_at",
      "signatory",
      "parcel_count",
      "weight",
      "references",
      "payment_details"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.aaacooper.com",
        "aaacooper.com"
      ],
      "pathPattern": "^/workspace/action-trac/?$",
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "www.aaacooper.com",
        "aaacooper.com"
      ],
      "pathPattern": "^/(?:pwb/)?Transit/ProTrackResults\\.aspx$",
      "params": [
        "ProNum"
      ]
    }
  ],
  "detection": []
}
