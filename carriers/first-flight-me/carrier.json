{
  "id": "first-flight-me",
  "displayName": "First Flight (Middle East)",
  "aliases": [
    "First Flight Couriers (Middle East)",
    "First Flight Couriers (Middle East) L.L.C.",
    "First Flight Couriers ME",
    "First Flight ME"
  ],
  "region": {
    "countries": [
      "AE"
    ]
  },
  "brand": {
    "color": "#ee6818"
  },
  "selectable": true,
  "timezone": "Asia/Dubai",
  "tracking": {
    "mode": "automatic",
    "adapter": "first-flight-me",
    "steps": [
      "trawl"
    ],
    "browser": true,
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://firstflightme.com/tracking/awb/{trackingNumber}",
    "searchUrl": "https://firstflightme.com/",
    "canaryUrl": "https://firstflightme.com/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "customer_reference",
      "signatory",
      "weight"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "customer_reference",
      "signatory",
      "weight"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "firstflightme.com",
        "www.firstflightme.com"
      ],
      "path": "^/tracking/awb/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
