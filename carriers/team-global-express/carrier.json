{
  "id": "team-global-express",
  "displayName": "Team Global Express",
  "aliases": [
    "TGE",
    "MyTeamGE",
    "Toll Global Express",
    "Toll IPEC",
    "Toll Priority",
    "Toll New Zealand",
    "Toll NZ"
  ],
  "region": {
    "countries": [
      "AU",
      "NZ"
    ]
  },
  "brand": {
    "color": "#143200"
  },
  "selectable": true,
  "timezone": "Australia/Sydney",
  "tracking": {
    "mode": "automatic",
    "adapter": "team-global-express",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 932
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "location",
    "eta",
    "weight",
    "service_name",
    "destination_country",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://www.myteamge.com/?externalSearchQuery={trackingNumber}",
    "searchUrl": "https://www.myteamge.com/",
    "canaryUrl": "https://www.myteamge.com/",
    "shows": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "weight",
      "service_name",
      "parcel_count",
      "progress_rail",
      "sender_town",
      "destination",
      "destination_country",
      "customer_reference",
      "signatory",
      "canonical_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "weight",
      "service_name",
      "destination_country",
      "canonical_tracking_number"
    ],
    "discarded": [
      "parcel_count",
      "progress_rail",
      "sender_town",
      "destination",
      "customer_reference",
      "signatory"
    ],
    "unavailable": [
      "delivered_at",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "myteamge.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "externalSearchQuery"
      ]
    },
    {
      "domains": [
        "teamglobalexp.com"
      ],
      "pathPattern": "^/myparcel/?$",
      "params": [
        "shipmentID"
      ]
    },
    {
      "domains": [
        "fasttracker.teamglobalexp.co.nz"
      ],
      "pathPattern": "^/fast-tracker\\.aspx$",
      "params": [
        "ConsignmentNumber"
      ]
    }
  ],
  "detection": []
}
