{
  "id": "imile",
  "displayName": "iMile",
  "aliases": [
    "iMile Delivery",
    "iMile Express"
  ],
  "region": {
    "countries": [
      "AE",
      "SA",
      "AU",
      "BR",
      "MX",
      "CO",
      "IT",
      "CN"
    ]
  },
  "brand": {
    "color": "#0032a0"
  },
  "selectable": true,
  "timezone": "Asia/Dubai",
  "tracking": {
    "mode": "automatic",
    "adapter": "imile",
    "steps": [
      "direct",
      "retry",
      "cainiao"
