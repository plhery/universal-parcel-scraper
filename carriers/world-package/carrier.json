{
  "id": "world-package",
  "displayName": "World Package",
  "aliases": [
    "World Package Logistics",
    "World Package Logistics Limited"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#120748"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "world-package",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://wpl-uk.couriernavigator-secure.com/tracking?consign_note={trackingNumber}",
    "searchUrl": "https://wpl-uk.couriernavigator-secure.com/tracking.html",
    "helpUrl": "https://www.worldpackage.co.uk/contact/",
    "canaryUrl": "https://www.worldpackage.co.uk/",
    "shows": [
      "status",
      "history",
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "flight_schedule"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "flight_schedule"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "wpl-uk.couriernavigator-secure.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "consign_note"
      ]
    }
  ],
  "detection": []
}
