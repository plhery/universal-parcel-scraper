{
  "id": "shunjie",
  "displayName": "Passerby A Express",
  "aliases": [
    "顺捷美中速递",
    "顺捷速递"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#00B0E0"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "shunjie",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "offset_timestamps",
    "origin_country",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.passerbyaexpress.com/index.php?c=index&f=search&sn={trackingNumber}",
    "searchUrl": "https://www.passerbyaexpress.com/",
    "canaryUrl": "https://www.passerbyaexpress.com/",
    "shows": [
      "status",
      "history",
      "delivery_partner",
      "delivery_tracking_number",
      "driver_name",
      "driver_phone",
      "office_addresses"
    ],
    "scraped": [
      "status",
      "history",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "driver_name",
      "driver_phone",
      "office_addresses"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "passerbyaexpress.com",
        "www.passerbyaexpress.com"
      ],
      "pathPattern": "^/index\\.php$",
      "params": [
        "sn"
      ]
    }
  ],
  "detection": []
}
