{
  "id": "fastbox",
  "displayName": "Fastbox",
  "aliases": [
    "FASTBOX",
    "패스트박스"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#f47f39"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "fastbox",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "origin_country",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://fastbox.co.kr/DHUB/tracking.php?fb_invoice_no={trackingNumber}",
    "searchUrl": "https://fastbox.co.kr/en/",
    "canaryUrl": "https://fastbox.co.kr/en/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "origin_country",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "origin_country",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": [
      "eta",
      "weight",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "fastbox.co.kr",
        "www.fastbox.co.kr"
      ],
      "pathPattern": "^/DHUB/tracking\\.php$",
      "params": [
        "fb_invoice_no"
      ]
    }
  ],
  "detection": [
    {
      "id": "fastbox-1",
      "pattern": "^FB\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{10}$",
      "confidence": "high"
    }
  ]
}
