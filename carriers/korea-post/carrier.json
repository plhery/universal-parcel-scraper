{
  "id": "korea-post",
  "displayName": "Korea Post",
  "aliases": [],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#da291c"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "korea-post",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at"
  ],
  "portal": {
    "url": "https://trace.epost.go.kr/xtts/servlet/kpl.tts.common.svl.SttSVL?target_command=kpl.tts.tt.epost.cmd.RetrieveEmsTraceEngCmd&JspURI=%2Fxtts%2Ftt%2Fepost%2Fems%2FEmsSearchResultEng.jsp&POST_CODE={trackingNumber}",
    "canaryUrl": "https://trace.epost.go.kr/xtts/tt/epost/ems/ems_eng.jsp",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "service_name",
      "sender_name",
      "recipient_name",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "service_name",
      "sender_name",
      "recipient_name",
      "office_contact_details"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "trace.epost.go.kr"
      ],
      "params": [
        "POST_CODE"
      ]
    },
    {
      "domains": [
        "service.epost.go.kr"
      ],
      "params": [
        "sid1"
      ]
    }
  ],
  "detection": [
    {
      "id": "korea-post-1",
      "pattern": "^[A-Z]{2}\\d{9}KR$",
      "confidence": "high",
      "checksum": "s10"
    },
    {
      "id": "korea-post-2",
      "pattern": "^6\\d{12}$",
      "confidence": "low"
    },
    {
      "id": "korea-post-3",
      "pattern": "^[1-5]\\d{12}$",
      "confidence": "low"
    }
  ]
}
