{
  "id": "ecms-express",
  "displayName": "ECMS Express",
  "aliases": [
    "易客满",
    "易客满国际物流有限公司",
    "易客满国际快递",
    "ECMSGlobal",
    "ECMS Global",
    "ECMS"
  ],
  "region": {
    "countries": [
      "CN",
      "JP",
      "US",
      "SG",
      "TW",
      "NL",
      "KR"
    ]
  },
  "brand": {
    "color": "#12823d"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "ecms-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.ecmsglobal.com/en-us/tracking.html?orderNumber={trackingNumber}",
    "searchUrl": "https://www.ecmsglobal.com/en-us/tracking.html",
    "helpUrl": "https://www.ecmsglobal.com/en-us/contact-us.html",
    "canaryUrl": "https://www.ecmsglobal.com/en-us/tracking.html",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivery_partner",
      "destination_country",
      "delivery_tracking_number"
    ],
    "discarded": [
      "merchant_reference",
      "payment_links"
    ],
    "unavailable": [
      "eta",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "www.ecmsglobal.com",
        "ecmsglobal.com"
      ],
      "pathPattern": "^/(?:en-us|en-uk|zh-cn|ko-kr)/tracking\\.html$",
      "params": [
        "orderNumber"
      ]
    },
    {
      "domains": [
        "consignee.ecmsglobal.com"
      ],
      "pathPattern": "^/brige/showtracking/?$",
      "params": [
        "trackingno"
      ]
    },
    {
      "domains": [
        "www.ecmsglobal.com",
        "ecmsglobal.com"
      ],
      "pathPattern": "^/oms/showtracking/?$",
      "params": [
        "trackingno"
      ]
    },
    {
      "domains": [
        "www.ecmsglobal.com",
        "ecmsglobal.com"
      ],
      "pathPattern": "^/(?:cn|en)/showtracking\\.html$",
      "params": [
        "order_number"
      ]
    }
  ],
  "detection": [
    {
      "id": "ecms-express-1",
      "pattern": "^(?:EC|ES|AP|AX)(?:[A-Z]{3}\\d{11}|[A-Z]{4}\\d{10}|[A-Z]{5}\\d{9})$",
      "confidence": "high"
    }
  ]
}
