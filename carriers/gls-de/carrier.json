{
  "id": "gls-de",
  "displayName": "GLS Germany",
  "aliases": [
    "General Logistics Systems",
    "GLS Group"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#ffdd00"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "gls-de",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "label": "Delivery postcode",
        "type": "text",
        "help": "GLS requires the delivery postcode to show the detailed event history.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 940
    },
    "refresh": {
      "minMinutes": 60,
      "afterFailureMinutes": 240
    }
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "pickup_point",
    "weight",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "url": "https://gls-group.eu/EU/en/parcel-tracking?match={trackingNumber}",
    "searchUrl": "https://gls-group.eu/EU/en/parcel-tracking",
    "helpUrl": "https://www.gls-pakete.de/glossar-privat/kontaktmoeglichkeiten",
    "canaryUrl": "https://gls-group.eu/EU/en/parcel-tracking",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "pickup_point",
      "weight",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature",
      "customer_reference"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "pickup_point",
      "weight",
      "delivered_at",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature",
      "customer_reference"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "gls-group.eu",
        "gls-group.com"
      ],
      "pathPattern": "^/(?:DE|EU)/",
      "params": [
        "match",
        "parcelNumber",
        "matchParcelNumber"
      ]
    },
    {
      "domains": [
        "gls-group.eu",
        "gls-group.com"
      ],
      "pathPattern": "^/(?:GROUP|BE|BG|CZ|DK|FI|HR|HU|IE|LU|NL|RO|RS|SI|SK)/",
      "params": [
        "match",
        "parcelNumber",
        "matchParcelNumber"
      ],
      "detectFromNumber": true
    },
    {
      "domains": [
        "gls-pakete.de"
      ],
      "params": [
        "match",
        "trackingNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "gls-de-1",
      "pattern": "^(?:(?=[A-Z0-9]{8}$)(?=.*[A-Z])(?=.*\\d)[A-Z0-9]{8}|\\d{11})$",
      "confidence": "low"
    },
    {
      "id": "gls-de-2",
      "pattern": "^\\d{12}$",
      "confidence": "low",
      "checksum": "gls"
    },
    {
      "id": "gls-de-3",
      "pattern": "^[A-Z]{6}$",
      "confidence": "low"
    }
  ]
}
