{
  "id": "j-and-t-mx",
  "displayName": "J&T Express Mexico",
  "aliases": [
    "J&T Express México",
    "J&T Express (MX)",
    "JT Express Mexico"
  ],
  "region": {
    "countries": [
      "MX"
    ]
  },
  "brand": {
    "color": "#e60012"
  },
  "selectable": true,
  "timezone": "America/Mexico_City",
  "tracking": {
    "mode": "automatic",
    "adapter": "j-and-t-mx",
    "requirements": [
      {
        "field": "phoneDigits",
        "validator": "phoneLastFour",
        "optional": true,
        "showsMore": true,
        "label": "Last 4 digits of the phone number",
        "type": "text",
        "help": "J&T Express Mexico shows a parcel only with the last four digits of the recipient's or sender's phone. Without them, other sources are asked.",
        "pattern": "^[0-9]{4}$",
        "maxLength": 4,
        "inputMode": "numeric",
        "autoComplete": "off"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://www.jtexpress.mx/trajectoryQuery?waybillNo={trackingNumber}&flag=1",
    "searchUrl": "https://www.jtexpress.mx/trajectoryQuery",
    "canaryUrl": "https://www.jtexpress.mx/trajectoryQuery",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "event_details",
      "driver_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "origin",
      "destination",
      "event_details",
      "driver_name"
    ],
    "unavailable": [
      "eta",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "www.jtexpress.mx",
        "jtexpress.mx"
      ],
      "pathPattern": "^/trajectoryQuery/?$",
      "params": [
        "waybillNo"
      ]
    }
  ],
  "detection": [
    {
      "id": "j-and-t-mx-1",
      "pattern": "^JMX\\d{12}$",
      "confidence": "high"
    }
  ]
}
