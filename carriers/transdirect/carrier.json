{
  "id": "transdirect",
  "displayName": "Transdirect",
  "aliases": [],
  "region": {
    "countries": ["AU"]
  },
  "brand": {
    "color": "#73cf11"
  },
  "selectable": true,
  "timezone": "Australia/Brisbane",
  "tracking": {
    "mode": "automatic",
    "adapter": "transdirect",
    "steps": ["direct"]
  },
  "capabilities": ["history", "location", "provider_code", "offset_timestamps"],
