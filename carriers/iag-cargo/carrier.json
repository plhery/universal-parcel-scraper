    "canaryUrl": "https://ui.tracking.iagcargo.com/en",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "origin",
      "destination",
      "flight",
      "parcel_count",
      "weight",
      "future_milestones",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "provider_code",
      "flight",
      "future_milestones",
      "destination_country"
    ],
    "discarded": [
