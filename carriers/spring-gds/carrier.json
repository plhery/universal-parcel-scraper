{
  "id": "spring-gds",
  "displayName": "PostNL",
  "aliases": [
    "Spring GDS",
    "Mailing Technology"
  ],
  "region": {
    "countries": [
      "NL"
    ]
  },
  "brand": {
    "color": "#ef7d00"
  },
  "selectable": true,
  "timezone": "Europe/Amsterdam",
  "tracking": {
    "mode": "automatic",
    "adapter": "spring-gds",
    "steps": [
      "direct"
    ],
    "refresh": {
      "minMinutes": 30
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "url": "https://postnl.post/track?barcodes={trackingNumber}",
    "searchUrl": "https://postnl.post/track",
    "canaryUrl": "https://postnl.post/",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "provider_code",
      "destination_country"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "postnl.post"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "barcodes"
      ]
    },
    {
      "domains": [
        "mailingtechnology.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "tn"
      ]
    },
    {
      "domains": [
        "postnl.post"
      ],
      "path": "/details/([^/?#]+)"
    }
  ],
  "detection": [
    {
      "id": "spring-gds-1",
      "pattern": "^(?!(?:PZ|XR|XT|XU|XW|XY))[A-Z]{2}\\d{9}NL$",
      "confidence": "high",
      "checksum": "s10"
    },
    {
      "id": "spring-gds-2",
      "pattern": "^3S[A-Z]{4}(?:\\d{7}|\\d{9})$",
      "confidence": "high"
    },
    {
      "id": "spring-gds-3",
      "pattern": "^(?=.{13}$|.{15}$)3S[A-Z]{1,3}\\d+$",
      "confidence": "low"
    }
  ]
}
