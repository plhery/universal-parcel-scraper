{
  "id": "sailpost",
  "displayName": "Sailpost",
  "aliases": [
    "SAILPOST",
    "Sailpost SpA",
    "Citypost",
    "Citypost S.p.A."
  ],
  "region": {
    "countries": [
      "IT"
    ]
  },
  "brand": {
    "color": "#e5c043"
  },
  "selectable": true,
  "timezone": "Europe/Rome",
  "tracking": {
    "mode": "automatic",
    "adapter": "sailpost",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.sailpost.it/traccia-il-pacco/?codice={trackingNumber}",
    "searchUrl": "https://www.sailpost.it/traccia-il-pacco/",
    "canaryUrl": "https://www.sailpost.it/traccia-il-pacco/",
    "shows": [
      "status",
      "history",
      "location",
      "destination",
      "item_category",
      "contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "offset_timestamps"
    ],
    "discarded": [
      "destination",
      "item_category",
      "contact_details"
    ],
    "unavailable": [
      "eta",
      "weight",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "sailpost.it",
        "www.sailpost.it"
      ],
      "pathPattern": "^/traccia-il-pacco/?$",
      "params": [
        "codice"
      ]
    }
  ],
  "detection": []
}
