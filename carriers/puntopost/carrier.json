{
  "id": "puntopost",
  "displayName": "PuntoPost",
  "aliases": [
    "PuntoPost Technologies México",
    "PuntoPost Technologies México, S.A. de C.V."
  ],
  "region": {
    "countries": [
      "MX"
    ]
  },
  "brand": {
    "color": "#13a590"
  },
  "selectable": true,
  "timezone": "America/Mexico_City",
  "tracking": {
    "mode": "automatic",
    "adapter": "puntopost",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "delivered_at",
    "provider_code",
    "pickup_point",
    "sender_name",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://www.puntopost.mx/tracking-summary/#{trackingNumber}",
    "searchUrl": "https://www.puntopost.mx/tracking-summary/",
    "canaryUrl": "https://www.puntopost.mx/tracking-summary/",
    "shows": [
      "status",
      "history",
      "pickup_point",
      "opening_hours",
      "coordinates",
      "origin"
    ],
    "scraped": [
      "status",
      "history",
      "delivered_at",
      "provider_code",
      "offset_timestamps",
      "pickup_point",
      "sender_name",
      "canonical_tracking_number"
    ],
    "discarded": [
      "opening_hours",
      "coordinates"
    ],
    "unavailable": [
      "eta",
      "weight",
      "dimensions",
      "recipient_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.puntopost.mx",
        "puntopost.mx"
      ],
      "pathPattern": "^/tracking-summary/?$",
      "fragment": "^(MX[A-Za-z0-9]+)$"
    }
  ],
  "detection": []
}
