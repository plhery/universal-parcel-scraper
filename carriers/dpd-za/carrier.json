      "domains": [
        "dpd.com"
      ],
      "pathPattern": "^/za/en/receiving-parcels/track-my-parcel/tracking-details/?$",
      "query": "^([A-Za-z0-9]+)$"
    },
    {
      "domains": [
        "website.dpdl.co.za"
      ],
      "path": "^/parceltrack/([^/?#]+)/?$"
    },
    {
      "domains": [
        "dawnwing.co.za"
      ],
      "pathPattern": "^/business-tools/online-parcel-tracking/?$",
      "params": [
        "WaybillNo"
      ]
    }
  ],
  "detection": []
