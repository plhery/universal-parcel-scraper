      "history",
      "location",
      "progress_rail",
      "recipient_name",
      "delivered_at",
      "related_tracking_numbers",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "progress_rail",
      "recipient_name",
      "delivered_at",
      "related_tracking_numbers",
      "office_contact_details"
    ],
    "unavailable": [
