{
  "id": "m24-logistics",
  "displayName": "M24 Logistics",
  "aliases": [],
  "region": {
    "countries": [
      "ZA"
    ]
  },
  "brand": {
    "color": "#20b4e8"
  },
  "selectable": true,
  "timezone": "Africa/Johannesburg",
  "tracking": {
    "mode": "automatic",
    "adapter": "m24-logistics",
    "steps": [
      "direct",
      "action",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "signed_by",
    "service_name"
  ],
  "portal": {
    "url": "https://lms.m24logistics.com/track-my-order/{trackingNumber}",
    "searchUrl": "https://lms.m24logistics.com/track-order",
    "canaryUrl": "https://lms.m24logistics.com/track-order",
    "shows": [
      "status",
      "history",
      "progress_rail",
      "service_name",
      "delivery_partner",
      "eta",
      "signatory",
      "recipient_address",
      "order_reference",
      "invoice_reference"
    ],
    "scraped": [
      "status",
      "history",
      "service_name",
      "signatory"
    ],
    "discarded": [
      "progress_rail",
      "delivery_partner",
      "eta",
      "recipient_address",
      "order_reference",
      "invoice_reference"
    ],
    "unavailable": [
      "location",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "lms.m24logistics.com"
      ],
      "path": "^/track-my-order/+([^/?#]+)/?$"
    }
  ],
  "detection": []
}
