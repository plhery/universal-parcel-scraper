    "searchUrl": "https://www.coretrails.com/",
    "helpUrl": "https://www.coretrails.com/contact-us",
    "canaryUrl": "https://www.coretrails.com/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "recipient_address"
    ],
    "unavailable": [
      "offset_timestamps",
      "proof_of_delivery",
      "weight",
      "sender_name",
      "recipient_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.coretrails.com",
        "coretrails.com"
      ],
