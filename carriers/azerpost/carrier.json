{
  "id": "azerpost",
  "displayName": "Azerpost",
  "aliases": [
    "Azerpoçt",
    "Azərpoçt",
    "Азерпочта",
    "Azerbaijan Post"
  ],
  "region": {
    "countries": [
      "AZ"
    ]
  },
  "brand": {
    "color": "#034c7d"
  },
  "selectable": true,
  "timezone": "Asia/Baku",
  "tracking": {
    "mode": "automatic",
    "adapter": "azerpost",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "weight"
  ],
  "portal": {
    "url": "https://www.azerpost.az/az/xidmetler/gonderislerin-izlenmesi?package_id={trackingNumber}",
    "searchUrl": "https://www.azerpost.az/az/xidmetler/gonderislerin-izlenmesi",
    "helpUrl": "https://www.azerpost.az/az/tez-tez-verilen-suallar/umumi-br-suallar",
    "canaryUrl": "https://www.azerpost.az/az/xidmetler/gonderislerin-izlenmesi",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "weight",
      "item_category",
      "order_contents",
      "origin_country",
      "destination_country"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "weight",
      "destination_country"
    ],
    "discarded": [
      "item_category",
      "order_contents",
      "origin_country"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "service_name",
      "sender_name",
      "recipient_address",
      "proof_of_delivery",
      "delivered_at"
    ]
  },
  "links": [
    {
      "domains": [
        "azerpost.az",
        "www.azerpost.az"
      ],
      "pathPattern": "^/(?:az/xidmetler/gonderislerin-izlenmesi|en/services/tracking-of-shipments|ru/uslugi/otslezivanie-otpravlenii)/?$",
      "params": [
        "package_id"
      ]
    },
    {
      "domains": [
        "azerpost.az",
        "www.azerpost.az"
      ],
      "path": "^/(?:az|en)/tracking/([A-Za-z]{2}\\d{9}[A-Za-z]{2})/?$"
    }
  ],
  "detection": []
}
