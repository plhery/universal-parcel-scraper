{
  "id": "chinz-logistics",
  "displayName": "Chinz Logistics",
  "aliases": [
    "Chinz Logistics Limited",
    "Chinz Logistics Ltd",
    "Chinz",
    "Chinz56",
    "秦远国际物流",
    "秦远物流",
    "秦远集运",
    "秦远",
    "Chinz Industry Limited",
    "Parcelmate",
    "Parcelmate NZ"
  ],
  "region": {
    "countries": [
      "NZ",
      "CN",
      "AU"
    ]
  },
  "brand": {
    "color": "#c9122e"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "chinz-logistics",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://chinzlogistics.com/en/consult?keywords={trackingNumber}",
    "searchUrl": "https://chinzlogistics.com/en/consult",
    "helpUrl": "https://chinzlogistics.com/en/contact",
    "canaryUrl": "https://chinzlogistics.com/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivery_tracking_number",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "delivery_tracking_number",
      "origin",
      "destination"
    ],
    "unavailable": [
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "chinzlogistics.com"
      ],
      "pathPattern": "^/(?:en/)?consult/?$",
      "params": [
        "keywords"
      ]
    },
    {
      "domains": [
        "www.chinzlogistics.co.nz"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "keywords"
      ]
    },
    {
      "domains": [
        "www.parcelmate.co.nz"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "keywords"
      ]
    }
  ],
  "detection": []
}
