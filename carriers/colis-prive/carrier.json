{
  "id": "colis-prive",
  "displayName": "Colis Privé",
  "aliases": [
    "Colis Prive"
  ],
  "region": {
    "countries": [
      "FR",
      "BE",
      "LU"
    ]
  },
  "brand": {
    "color": "#aa78ff"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "colis-prive",
    "requirements": [
      {
        "field": "postcode",
        "whenTrackingNumber": "^[A-Z0-9]{12}$",
        "validator": "colisPrivePostcode",
        "label": "Delivery postcode",
        "type": "text",
        "placeholder": "75001",
        "help": "Colis Privé needs the recipient postcode with the 12-character number: 5 digits in France, 4 in Belgium, or L and 4 digits in Luxembourg.",
        "pattern": "^(?:(?:0[1-9]|[1-8][0-9]|9[0-578])[0-9]{3}|(?:(?:[Bb][Ee]?|[Ll][Uu]?)[ \\-]?)?[1-9][0-9]{3})$",
        "maxLength": 7,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 740
    },
    "localClocks": true,
    "dateOnlyScans": true
  },
  "capabilities": [
    "history",
    "eta"
  ],
  "portal": {
    "url": "https://colisprive.com/moncolis/pages/DetailColis.aspx?numColis={trackingNumber}&lang=fr",
    "searchUrl": "https://colisprive.com/moncolis/pages/DetailColis.aspx",
    "helpUrl": "https://colisprive.fr/aide/mon-colis-a-du-retard/",
    "canaryUrl": "https://colisprive.com/moncolis/pages/DetailColis.aspx",
    "shows": [
      "status",
      "history",
      "eta",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "eta"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "colisprive.com",
        "colisprive.fr"
      ],
      "params": [
        "numColis"
      ]
    }
  ],
  "detection": [
    {
      "id": "colis-prive-1",
      "pattern": "^(?!YW[A-Z]{3}\\d{12}$|YWE\\d{14}$|(?:GF|CI)[A-Z]{2}\\d{13}$|CNG\\d{14}$)[A-Z0-9]{12}(?:(?:0[1-9]|[1-8]\\d|9[0-5]|97|98)\\d{3}|[BL][1-9]\\d{3})$",
      "confidence": "low"
    },
    {
      "id": "colis-prive-2",
      "pattern": "^[A-Z0-9]{12}$",
      "confidence": "low"
    }
  ]
}
