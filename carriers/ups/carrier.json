{
  "id": "ups",
  "displayName": "UPS",
  "aliases": [
    "United Parcel Service"
  ],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#351c15"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "ups",
    "steps": [
      "direct",
      "trawl"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "delivered_at",
    "pickup_point",
    "provider_code",
    "service_name",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.ups.com/track?tracknum={trackingNumber}",
    "searchUrl": "https://www.ups.com/track",
    "canaryUrl": "https://www.ups.com/assets/resources/webcontent/en_US/terms_service.pdf",
    "shows": [
      "status",
      "history",
      "eta",
      "location",
      "pickup_point",
      "service_name",
      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "location",
      "delivered_at",
      "pickup_point",
      "provider_code",
      "service_name",
      "delivery_partner"
    ],
    "discarded": [
      "signatory",
      "recipient_address",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "ups.com"
      ],
      "params": [
        "tracknum",
        "trackNums"
      ]
    }
  ],
  "detection": [
    {
      "id": "ups-1",
      "pattern": "^1Z[A-Z0-9]{16}$",
      "confidence": "high",
      "checksum": "ups"
    },
    {
      "id": "ups-3",
      "pattern": "^1Z[A-Z0-9]{16}$",
      "confidence": "low"
    },
    {
      "id": "ups-2",
      "pattern": "^[HJKV]\\d{10}$",
      "confidence": "low"
    }
  ]
}
