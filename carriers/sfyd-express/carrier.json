{
  "id": "sfyd-express",
  "displayName": "SFYD Express",
  "aliases": [
    "云速递",
    "云速递国际物流"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#f47920"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "sfyd-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivery_tracking_number",
    "destination_country"
  ],
  "portal": {
    "url": "https://sfydexpress.com/tracking.html?c={trackingNumber}",
    "searchUrl": "https://sfydexpress.com/tracking.html",
    "canaryUrl": "https://sfydexpress.com/tracking.html",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_tracking_number",
      "customer_reference",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country",
      "delivery_tracking_number"
    ],
    "discarded": [
      "customer_reference",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "sfydexpress.com",
        "www.sfydexpress.com"
      ],
      "pathPattern": "^/tracking\\.html$",
      "params": [
        "c"
      ]
    }
  ],
  "detection": []
}
