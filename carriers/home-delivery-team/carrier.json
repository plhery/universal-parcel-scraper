{
  "id": "home-delivery-team",
  "displayName": "Home Delivery Team",
  "aliases": [
    "HDT",
    "HDT Home Delivery Team",
    "GE Logisztika Kft."
  ],
  "region": {
    "countries": [
      "HU"
    ]
  },
  "brand": {
    "color": "#dd137b"
  },
  "selectable": true,
  "timezone": "Europe/Budapest",
  "tracking": {
    "mode": "automatic",
    "adapter": "home-delivery-team",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://homedt.hu/nyomonkovetes?track_number={trackingNumber}",
    "searchUrl": "https://homedt.hu/nyomonkovetes",
    "helpUrl": "https://homedt.hu/kapcsolat",
    "canaryUrl": "https://homedt.hu/nyomonkovetes",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "homedt.hu",
        "www.homedt.hu"
      ],
      "pathPattern": "^/(?:nyomonkovetes|track)/?$",
      "params": [
        "track_number"
      ]
    }
  ],
  "detection": []
}
