{
  "id": "parcel-one",
  "displayName": "PARCEL.ONE",
  "aliases": [
    "PARCEL.ONE GmbH"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#344b6a"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "parcel-one",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://parcel.one/tracking?trackno={trackingNumber}",
    "searchUrl": "https://parcel.one/en/tracking/",
    "canaryUrl": "https://parcel.one/en/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail",
      "delivery_partner",
      "delivery_tracking_number",
      "postcodes",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "progress_rail",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "postcodes",
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "weight",
      "sender_name",
      "service_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "parcel.one"
      ],
      "pathPattern": "^/(?:[a-z]{2}/)?tracking/?$",
      "params": [
        "trackno"
      ]
    }
  ],
  "detection": []
}
