{
  "id": "sf-express",
  "displayName": "SF Express",
  "aliases": [],
  "region": {
    "countries": [
      "CN",
      "HK"
    ]
  },
  "brand": {
    "color": "#dc1e32"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "sf-express",
    "steps": [
      "trawl"
    ],
    "browser": true
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://htm.sf-express.com/tw/en/dynamic_function/waybill/#search/bill-number/{trackingNumber}",
    "searchUrl": "https://htm.sf-express.com/tw/en/dynamic_function/waybill/",
    "helpUrl": "https://www.sf-international.com/cn/en/about/contact",
    "canaryUrl": "https://htm.sf-express.com/tw/en/dynamic_function/waybill/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code"
    ],
    "discarded": [
      "proof_links",
      "contact_details",
      "facility_identifiers",
      "weight",
      "unverified_estimates"
    ],
    "unavailable": [
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "sf-express.com"
      ],
      "path": "^/.+/waybill-detail/([^/?#]+)/?$"
    },
    {
      "domains": [
        "htm.sf-express.com"
      ],
      "pathPattern": "^/tw/en/dynamic_function/waybill/$",
      "fragment": "^search/bill-number/(SF\\d{13}|\\d{12})$"
    },
    {
      "domains": [
        "sf-international.com"
      ],
      "pathPattern": "^/(?:[a-z]{2}/[a-z]{2}/)?support/querySupport/waybill(?:/mobile/result)?/?$",
      "params": [
        "No"
      ],
      "ownNumbersOnly": true
    }
  ],
  "detection": [
    {
      "id": "sf-express-3",
      "pattern": "^\\d{12}$",
      "confidence": "low",
      "checksum": "sf-express",
      "preferred": true
    },
    {
      "id": "sf-express-1",
      "pattern": "^\\d{12}$",
      "confidence": "low"
    },
    {
      "id": "sf-express-2",
      "pattern": "^SF\\d{13}$",
      "confidence": "high",
      "checksum": "sf-express"
    },
    {
      "id": "sf-express-4",
      "pattern": "^SF\\d{13}$",
      "confidence": "low"
    }
  ]
}
