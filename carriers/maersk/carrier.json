    "searchUrl": "https://www.maersk.com/tracking/",
    "helpUrl": "https://www.maersk.com/contact",
    "canaryUrl": "https://www.maersk.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "vehicle",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta"
    ],
    "discarded": [
      "origin",
      "destination",
      "vehicle"
    ],
    "unavailable": [
      "sender_name",
      "recipient_name",
      "proof_of_delivery",
      "weight"
    ]
