    "shows": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "order_reference",
      "seller_configuration"
    ],
    "unavailable": [
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": [
        "shipmentv2.xpressbees.com"
      ],
      "path": "^/orders/tracking/(\\d{12,16})(?:/|$)"
    },
    {
      "domains": [
        "xpressbees.com"
      ],
      "params": [
        "trackid"
      ]
    }
  ],
  "detection": [
    {
      "id": "xpressbees-awb",
      "pattern": "^[19]\\d{13}$",
      "confidence": "low"
    }
  ]
}
