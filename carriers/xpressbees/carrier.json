{
  "id": "xpressbees",
  "displayName": "Xpressbees",
  "aliases": [
    "Xpress Bees",
    "XpressBees"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#f58220"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "xpressbees",
