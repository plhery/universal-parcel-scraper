{
  "id": "spx-ph",
  "displayName": "SPX Express Philippines",
  "aliases": [
    "Shopee Express Philippines",
    "Shopee Xpress Philippines",
    "SPX Philippines"
  ],
  "region": {
    "countries": [
      "PH"
    ]
  },
  "brand": {
    "color": "#ee4d2d"
  },
  "selectable": true,
  "timezone": "Asia/Manila",
  "tracking": {
    "mode": "automatic",
    "adapter": "spx-ph",
    "steps": [
      "direct",
      "legacy"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at"
  ],
  "portal": {
    "url": "https://spx.ph/track?{trackingNumber}",
    "searchUrl": "https://spx.ph/track",
    "canaryUrl": "https://spx.ph/en",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "recipient_details",
      "contact_details",
      "seller_location",
      "future_milestones"
    ],
    "unavailable": [
      "eta",
      "pickup_point"
    ]
  },
  "links": [
    {
      "domains": ["spx.ph"],
      "pathPattern": "^/track/?$",
      "query": "^((?:SPX|SPE)?PH\\d{10,16}[A-Z]?)$"
    },
    {
      "domains": [
        "spx.ph",
        "shopeexpress.ph"
      ],
      "params": [
        "spx_tn",
        "sls_tracking_number"
      ]
    },
    {
      "domains": [
        "spx.ph",
        "shopeexpress.ph"
      ],
      "path": "^/detail/((?:SPX|SPE)?PH\\d{10,16}[A-Z]?)(?:/|$)"
    },
    {
      "domains": [
        "spx.ph",
        "shopeexpress.ph"
      ],
      "fragment": "^/detail/((?:SPX|SPE)?PH\\d{10,16}[A-Z]?)(?:$|[?&])"
    }
  ],
  "detection": [
    {
      "id": "spx-ph-prefixed",
      "pattern": "^SPXPH\\d{10,16}[A-Z]?$",
      "confidence": "high"
    },
    {
      "id": "spx-ph-shopee-express",
      "pattern": "^SPEPH\\d{11}[0-9A-Z]$",
      "confidence": "high"
    },
    {
      "id": "spx-ph-domestic",
      "pattern": "^PH\\d{12,14}[A-Z]?$",
      "confidence": "low"
    }
  ]
}
