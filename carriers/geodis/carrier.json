{
  "id": "geodis",
  "displayName": "GEODIS",
  "aliases": [
    "France Express"
  ],
  "region": {
    "countries": [
      "FR"
    ]
  },
  "brand": {
    "color": "#3100e6"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "geodis",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "sender_name",
    "service_name",
    "weight"
  ],
  "portal": {
    "url": "https://espace-client.geodis.com/services/destinataires/#/fr/suivi/{trackingNumber}",
    "searchUrl": "https://espace-client.geodis.com/services/destinataires/",
    "canaryUrl": "https://espace-client.geodis.com/services/destinataires/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "sender_name",
      "service_name",
      "weight",
      "parcel_count",
      "recipient_name",
      "recipient_address",
      "delivery_instructions",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "sender_name",
      "service_name",
      "weight"
    ],
    "discarded": [
      "parcel_count",
      "recipient_name",
      "recipient_address",
      "delivery_instructions",
      "proof_of_delivery"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "espace-client.geodis.com",
        "geodis.com"
      ],
      "params": [
        "noSuivi",
        "trackingNumber"
      ]
    },
    {
      "domains": [
        "espace-client.geodis.com",
        "espace-client.france-express.com"
      ],
      "fragment": "^/[a-z]{2}/suivi/([^/?#]+)"
    }
  ],
  "detection": [
    {
      "id": "geodis-1",
      "pattern": "^1G[A-Z0-9]{10}$",
      "confidence": "high"
    }
  ]
}
