{
  "id": "dx",
  "displayName": "DX",
  "aliases": [
    "DX Delivery",
    "DX Freight",
    "DX Express",
    "DX Secure"
  ],
  "region": {
    "countries": [
      "GB",
      "IE"
    ]
  },
  "brand": {
    "color": "#1c9ad7"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "dx",
    "requirements": [
      {
        "field": "postcode",
        "whenTrackingNumber": "^(?:[A-Z]\\d{7}|\\d{8})$",
        "validator": "internationalPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Delivery postcode",
        "type": "text",
        "placeholder": "SW1A 1AA",
        "help": "DX Freight shows a consignment only with its delivery postcode. Without it, other sources are asked.",
        "pattern": "^(?=.{3,8}$)(?=.*[0-9])[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$",
        "maxLength": 8,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "weight",
    "service_name"
  ],
  "portal": {
    "url": "https://my.dxdelivery.com/query?tracking_number={trackingNumber}",
    "searchUrl": "https://www.dxlogistics.com/track",
    "canaryUrl": "https://www.dxlogistics.com/track",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "service_name",
      "parcel_count",
      "customer_reference",
      "departure_date",
      "signatory",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "service_name"
    ],
    "discarded": [
      "parcel_count",
      "customer_reference",
      "departure_date",
      "signatory",
      "delivery_options"
    ],
    "unavailable": [
      "provider_code",
      "delivered_at",
      "offset_timestamps",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "my.dxdelivery.com"
      ],
      "pathPattern": "^/query/?$",
      "params": [
        "tracking_number"
      ]
    }
  ],
  "detection": [
    {
      "id": "dx-1",
      "pattern": "^[CLW]\\d{7}$",
      "confidence": "low"
    }
  ]
}
