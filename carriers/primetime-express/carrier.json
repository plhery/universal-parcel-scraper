{
  "id": "primetime-express",
  "displayName": "Primetime Express",
  "aliases": [
    "Prime Time Express",
    "PTE Logistics"
  ],
  "region": {
    "countries": [
      "ZA"
    ]
  },
  "brand": {
    "color": "#00567a"
  },
  "selectable": true,
  "timezone": "Africa/Johannesburg",
  "tracking": {
    "mode": "automatic",
    "adapter": "primetime-express",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://primetimeexpress.pperfect.com/?w={trackingNumber}",
    "searchUrl": "https://primetimeexpress.pperfect.com/",
    "helpUrl": "https://ptexpress.co.za/contact/",
    "canaryUrl": "https://primetimeexpress.pperfect.com/",
    "shows": [
      "status",
      "history",
      "location",
      "progress_rail",
      "recipient_name",
      "customer_reference",
      "service_name",
      "parcel_count",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "progress_rail",
      "recipient_name",
      "customer_reference",
      "service_name",
      "parcel_count",
      "proof_of_delivery"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "primetimeexpress.pperfect.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "w"
      ]
    }
  ],
  "detection": []
}
