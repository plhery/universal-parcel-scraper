{
  "id": "overseas-express",
  "displayName": "Overseas Express",
  "aliases": [
    "Overseas",
    "OEX",
    "Overseas Express d.o.o."
  ],
  "region": {
    "countries": [
      "HR"
    ]
  },
  "brand": {
    "color": "#f58220"
  },
  "selectable": true,
  "timezone": "Europe/Zagreb",
  "tracking": {
    "mode": "automatic",
    "adapter": "overseas-express",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "searchUrl": "https://www.overseas.hr/hr",
    "helpUrl": "https://www.overseas.hr/hr/overseas-express/kontakt",
    "canaryUrl": "https://www.overseas.hr/hr",
    "shows": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "pickup_point",
      "parcel_count",
      "service_name",
      "coordinates"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "offset_timestamps",
      "delivered_at"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "recipient_address",
      "pickup_point",
      "parcel_count",
      "service_name",
      "coordinates"
    ],
    "unavailable": [
      "eta",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "inet.overseas.hr"
      ],
      "pathPattern": "^/auth/?$",
      "params": [
        "trackingid"
      ]
    },
    {
      "domains": [
        "is.overseas.hr"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "trackingid"
      ]
    },
    {
      "domains": [
        "is.overseas.hr"
      ],
      "path": "^/track-and-trace/([^/?#]+)/?$"
    },
    {
      "domains": [
        "overseas.hr"
      ],
      "path": "^/Tracking/Package/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
