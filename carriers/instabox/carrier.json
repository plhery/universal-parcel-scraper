{
  "id": "instabox",
  "displayName": "Instabox",
  "aliases": [
    "Instabox Sweden AB",
    "Instabox Norway AS",
    "Porterbuddy"
  ],
  "region": {
    "countries": [
      "SE",
      "NO",
      "DK"
    ]
  },
  "brand": {
    "color": "#ff3e3e"
  },
  "selectable": true,
  "timezone": "Europe/Stockholm",
  "tracking": {
    "mode": "automatic",
    "adapter": "instabox",
    "steps": [
      "direct",
      "retry"
    ],
    "requirements": [
      {
        "field": "trackingUrl",
        "validator": "instaboxCapabilityUrl",
        "optional": true,
        "label": "Instabox notification URL",
        "type": "url",
        "placeholder": "https://track.instabox.com/\u2026",
        "help": "The complete notification link opens your parcel history. Without it, other sources are asked."
      }
    ]
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "searchUrl": "https://track.instabox.com/en",
    "canaryUrl": "https://track.instabox.com/",
    "shows": [
      "status",
      "history",
      "location",
      "recipient_contact",
      "recipient_details",
      "parcel_dimensions"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "recipient_contact",
      "recipient_details",
      "parcel_dimensions"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "track.instabox.com"
      ],
      "pathPattern": "^/[a-z]{2}(?:-[A-Z]{2})?/[A-Za-z0-9]{4,40}(?:/locker-to-locker-recipient)?/?$",
      "path": "^/[a-z]{2}(?:-[A-Z]{2})?/([A-Za-z0-9]{4,40})(?:/locker-to-locker-recipient)?/?$",
      "keepsCapabilityUrl": true
    }
  ],
  "detection": []
}
