{
  "id": "freightways-global",
  "displayName": "Freightways Global",
  "aliases": [
    "First Global",
    "First Global Logistics",
    "First Global Mail",
    "FG Mail Connect",
    "fgmailconnect",
    "FG International"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#20a9e1"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "freightways-global",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "canonical_tracking_number",
    "service_name",
    "weight_kg",
    "destination_country"
  ],
  "portal": {
    "url": "https://track.fgmailconnect.co.nz/?id={trackingNumber}",
    "searchUrl": "https://track.fgmailconnect.co.nz/",
    "canaryUrl": "https://freightwaysglobal.co.nz/",
    "shows": [
      "status",
      "history",
      "canonical_tracking_number",
      "service_name",
      "weight_kg",
      "destination_country"
    ],
    "scraped": [
      "status",
      "history",
      "canonical_tracking_number",
      "service_name",
      "weight_kg",
      "destination_country"
    ],
    "discarded": [
      "account_reference",
      "parcel_barcodes",
      "partner_links",
      "cubic_volume"
    ],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "track.fgmailconnect.co.nz"
      ],
      "pathPattern": "^/?$",
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "track.fgmailconnect.co.nz"
      ],
      "path": "^/(?:\\d{6,7}-)?((?=[A-Z]*\\d)[A-Z0-9]{8,30})/?$"
    }
  ],
  "detection": []
}
