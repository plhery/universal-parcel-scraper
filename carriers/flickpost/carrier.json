{
  "id": "flickpost",
  "displayName": "Flickpost",
  "aliases": [
    "Cargo Miles Sdn Bhd"
  ],
  "region": {
    "countries": [
      "MY"
    ]
  },
  "brand": {
    "color": "#19c2e8"
  },
  "selectable": true,
  "timezone": "Asia/Kuala_Lumpur",
  "tracking": {
    "mode": "automatic",
    "adapter": "flickpost",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "weight",
    "service_name"
  ],
  "portal": {
    "url": "https://flickpost.com/tracking/?trackingNumber={trackingNumber}",
    "searchUrl": "https://flickpost.com/tracking/",
    "canaryUrl": "https://flickpost.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "weight",
      "service_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "weight",
      "service_name"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "provider_code",
      "destination_country",
      "sender_name",
      "receiver_name",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "flickpost.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": []
}
