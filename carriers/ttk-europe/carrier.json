{
  "id": "ttk-europe",
  "displayName": "TTK Europe",
  "aliases": [
    "Ttkeurope",
    "TTK EUROPE Ltd",
    "TTK EU",
    "天天欧洲物流",
    "天天欧洲"
  ],
  "region": {
    "countries": [
      "GB",
      "CN"
    ]
  },
  "brand": {
    "color": "#dd1831"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "ttk-europe",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://ttkeu.com/tracking/tracking-detail/?id={trackingNumber}",
    "searchUrl": "https://ttkeu.com/tracking/",
    "helpUrl": "https://ttkeu.com/contact/",
    "canaryUrl": "https://ttkeu.com/",
    "shows": [
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number",
      "staff_details"
    ],
    "scraped": [
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "staff_details"
    ],
    "unavailable": [
      "status",
      "eta",
      "weight",
      "service_name",
      "offset_timestamps",
      "delivered_at",
      "proof_of_delivery",
      "signatory",
      "recipient_name",
      "recipient_address",
      "destination_country"
    ]
  },
  "links": [
    {
      "domains": [
        "ttkeu.com",
        "www.ttkeu.com"
      ],
      "pathPattern": "^/tracking/tracking-detail/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
