{
  "id": "kqtwl",
  "displayName": "Kaiqitong Logistics",
  "aliases": [
    "凯骐通物流",
    "深圳市凯骐通物流有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#ff613e"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "kqtwl",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://wx.lqfast.com/Pub/UnitListDetail?companyid=99HDajcB62Q8ilC47SAc0Q%3D%3D&unit={trackingNumber}",
    "searchUrl": "https://wx.lqfast.com/Pub/UnitCheck?CompanyId=99HDajcB62Q8ilC47SAc0Q%3D%3D",
    "canaryUrl": "https://wx.lqfast.com/wx/waybillquery/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "order_contents",
      "parcel_count",
      "office_contact_details",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "origin",
      "destination",
      "order_contents",
      "parcel_count",
      "office_contact_details",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "wx.lqfast.com"
      ],
      "pathPattern": "^/Pub/UnitListDetail$",
      "query": "^(?=(?:.*&)?companyid=99HDajcB62Q8ilC47SAc0Q==(?:&|$))(?:.*&)?unit=([^&]+)(?=&|$)"
    },
    {
      "domains": [
        "wx.lqfast.com"
      ],
      "pathPattern": "^/wx/waybillquery/?$",
      "fragment": "^/(?:waybillquery/orderDetail)?\\?(?=(?:.*&)?companyid=99HDajcB62Q8ilC47SAc0Q==(?:&|$))(?:.*&)?(?:unit|seek)=([^&]+)(?=&|$)"
    }
  ],
  "detection": []
}
