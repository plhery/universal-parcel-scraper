{
  "id": "an-post",
  "displayName": "An Post",
  "aliases": [],
  "region": {
    "countries": [
      "IE"
    ]
  },
  "brand": {
    "color": "#00a76a"
  },
  "selectable": true,
  "timezone": "Europe/Dublin",
  "tracking": {
    "mode": "automatic",
    "adapter": "an-post",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "pickup_point"
  ],
  "portal": {
    "url": "https://www.anpost.com/Post-Parcels/Track/History?item={trackingNumber}",
    "canaryUrl": "https://www.anpost.com/Post-Parcels/Track/Search",
    "shows": [
      "status",
      "history",
      "location",
      "pickup_point",
      "customer_reference",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "pickup_point",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "signatory",
      "customer_reference",
      "event_details",
      "origin_country",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "anpost.com"
      ],
      "pathPattern": "^/Post-Parcels/Track/History/?$",
      "params": [
        "item",
        "barcode"
      ]
    }
  ],
  "detection": [
    {
      "id": "an-post-1",
      "pattern": "^[A-Z]{2}\\d{9}IE$",
      "confidence": "high",
      "checksum": "s10"
    }
  ]
}
