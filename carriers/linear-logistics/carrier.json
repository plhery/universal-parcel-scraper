{
  "id": "linear-logistics",
  "displayName": "Linear Logistics",
  "aliases": [
    "Linear Logistics Ltd",
    "Parcelink Logistics"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#003d6a"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "linear-logistics",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://linearlogistics.co.uk/tracking?q={trackingNumber}",
    "searchUrl": "https://linearlogistics.co.uk/tracking",
    "canaryUrl": "https://linearlogistics.co.uk/",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_partner",
      "recipient_name",
      "eta",
      "eta_window"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "eta_window"
    ],
    "discarded": [
      "recipient_name",
      "delivery_partner"
    ],
    "unavailable": [
      "offset_timestamps",
      "weight",
      "service_name",
      "sender_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "linearlogistics.co.uk",
        "www.linearlogistics.co.uk"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "q"
      ]
    },
    {
      "domains": [
        "tracking.linearlogistics.co.uk"
      ],
      "pathPattern": "^/?$",
      "params": [
        "q"
      ]
    }
  ],
  "detection": []
}
