{
  "id": "qt-express",
  "displayName": "QT Express",
  "aliases": [
    "QT Logistics",
    "QT Logistics Group",
    "QT Logistics Group Kft."
  ],
  "region": {
    "countries": [
      "HU"
    ]
  },
  "brand": {
    "color": "#ee7e22"
  },
  "selectable": true,
  "timezone": "Europe/Budapest",
  "tracking": {
    "mode": "automatic",
    "adapter": "qt-express",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://tracking.qtlogistics.eu/hu/{trackingNumber}",
    "searchUrl": "https://tracking.qtlogistics.eu/hu",
    "helpUrl": "https://qtlogistics.eu/contact/",
    "canaryUrl": "https://tracking.qtlogistics.eu/hu",
    "shows": [
      "status",
      "history",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "delivery_options"
    ],
    "unavailable": [
      "eta",
      "location"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.qtlogistics.eu"
      ],
      "pathPattern": "^/(?:hu|en)/[^/]+/?$",
      "path": "^/(?:hu|en)/([^/]+)/?$"
    }
  ],
  "detection": []
}
