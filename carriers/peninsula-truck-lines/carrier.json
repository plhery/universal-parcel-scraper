{
  "id": "peninsula-truck-lines",
  "displayName": "Peninsula Truck Lines",
  "aliases": [
    "Peninsula Truck Lines, Inc.",
    "Peninsula Truck Lines Inc",
    "Peninsula Truck"
  ],
  "region": {
    "countries": [
      "US",
      "CA"
    ]
  },
  "brand": {
    "color": "#025831"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "peninsula-truck-lines",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.peninsulatruck.com/track/?pro_number={trackingNumber}",
    "searchUrl": "https://www.peninsulatruck.com/track/",
    "canaryUrl": "https://www.peninsulatruck.com/track/",
    "shows": [
      "status",
      "history",
      "location",
      "customer_reference",
      "origin",
      "destination",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "customer_reference",
      "origin",
      "destination",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "provider_code",
      "sender_name",
      "recipient_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.peninsulatruck.com",
        "peninsulatruck.com"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "pro_number"
      ]
    }
  ],
  "detection": []
}
