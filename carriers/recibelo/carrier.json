{
  "id": "recibelo",
  "displayName": "Recíbelo",
  "aliases": [
    "Recibelo"
  ],
  "region": {
    "countries": [
      "CL"
    ]
  },
  "brand": {
    "color": "#e6166a"
  },
  "selectable": true,
  "timezone": "America/Santiago",
  "tracking": {
    "mode": "automatic",
    "adapter": "recibelo",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://www.recibelo.cl/seguimiento/?codigo={trackingNumber}",
    "searchUrl": "https://www.recibelo.cl/seguimiento/",
    "helpUrl": "https://www.recibelo.cl/contacto/",
    "canaryUrl": "https://www.recibelo.cl/seguimiento/",
    "shows": [
      "status",
      "history",
      "scan_times",
      "recipient_name"
    ],
    "scraped": [
      "status",
      "history",
      "scan_times"
    ],
    "discarded": [
      "recipient_name"
    ],
    "unavailable": [
      "location",
      "eta",
      "offset_timestamps",
      "weight",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "recibelo.cl"
      ],
      "pathPattern": "^/seguimiento/?$",
      "params": [
        "codigo"
      ]
    },
    {
      "domains": [
        "recibelo.cl"
      ],
      "path": "^/seguimiento/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
