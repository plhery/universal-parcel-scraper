{
  "id": "fliway",
  "displayName": "Fliway",
  "aliases": [
    "Fliway Group",
    "Fliway Holdings"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#002b5c"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "fliway",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "eta",
    "eta_window"
  ],
  "portal": {
    "url": "https://www.fliway.com/transport/tracking/jobstatus?connote_or_ticket={trackingNumber}",
    "searchUrl": "https://www.fliway.com/",
    "helpUrl": "https://www.fliway.com/services/contact-support",
    "canaryUrl": "https://www.fliway.com/",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "depot_code",
      "delivered_at",
      "parcel_count",
      "proof_of_delivery",
      "signatory",
      "signature"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "eta",
      "eta_window"
    ],
    "discarded": [
      "parcel_count",
      "proof_of_delivery",
      "signatory",
      "signature"
    ],
    "unavailable": [
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "www.fliway.com",
        "fliway.com"
      ],
      "pathPattern": "^/transport/tracking/jobstatus/?$",
      "params": [
        "connote_or_ticket"
      ]
    },
    {
      "domains": [
        "online.fliway.com"
      ],
      "path": "^/Public/Track/([^/?#]+)/?$"
    },
    {
      "domains": [
        "online.fliway.com"
      ],
      "pathPattern": "^/Public/(?:Track|TrackItem)/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
