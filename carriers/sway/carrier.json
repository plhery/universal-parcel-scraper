{
  "id": "sway",
  "displayName": "Sway",
  "aliases": [
    "Returnmates",
    "Sway (Returnmates)",
    "ShipSway",
    "Sway Delivery"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#635ff5"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "sway",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://track.shipsway.com/{trackingNumber}",
    "searchUrl": "https://track.shipsway.com/",
    "canaryUrl": "https://www.shipsway.com/",
    "shows": [
      "status",
      "history",
      "provider_code",
      "delivered_at",
      "offset_timestamps",
      "sender_name",
      "recipient_address",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "sender_name",
      "recipient_address",
      "proof_of_delivery"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "track.shipsway.com"
      ],
      "path": "^/([A-Za-z0-9][A-Za-z0-9-]{5,39})/?$"
    }
  ],
  "detection": []
}
