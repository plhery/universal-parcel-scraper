{
  "id": "dpd-at",
  "displayName": "DPD Austria",
  "aliases": [
    "DPD Österreich",
    "DPD AT"
  ],
  "region": {
    "countries": [
      "AT"
    ]
  },
  "brand": {
    "color": "#dc0032"
  },
  "selectable": true,
  "timezone": "Europe/Vienna",
  "tracking": {
    "mode": "automatic",
