{
  "id": "jgex",
  "displayName": "JGEX",
  "aliases": [
    "锦鸽",
    "锦鸽国际物流",
    "上海锦鸽国际货运代理有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#00a0e9"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "jgex",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "service_name",
    "destination_country"
  ],
  "portal": {
    "canaryUrl": "https://t.17track.net/",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "destination_country",
      "parcel_count",
      "weight",
      "customer_reference",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "signatory",
      "signature",
      "proof_of_delivery",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name",
      "destination_country"
    ],
    "discarded": [
      "parcel_count",
      "weight",
      "customer_reference",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "signatory",
      "signature",
      "proof_of_delivery",
      "payment_details"
    ],
    "unavailable": [
      "eta",
      "delivered_at",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.jgex.net",
        "jgex.net"
      ],
      "pathPattern": "^/(?:en/)?trackIndex\\.htm$",
      "params": [
        "documentCode"
      ]
    }
  ],
  "detection": []
}
