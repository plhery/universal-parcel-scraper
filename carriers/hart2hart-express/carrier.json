{
  "id": "hart2hart-express",
  "displayName": "Hart2Hart Express",
  "aliases": [
    "Hart 2 Hart Express",
    "Hart 2 Hart",
    "Hart2Hart",
    "Hart 2 Hart Express Limited"
  ],
  "region": {
    "countries": [
      "GB",
      "MT"
    ]
  },
  "brand": {
    "color": "#ed1c24"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "hart2hart-express",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://harttohart.couriernavigator-secure.com/tracking?consign_note={trackingNumber}",
    "searchUrl": "https://harttohart.couriernavigator-secure.com/tracking",
    "helpUrl": "https://hart2hartexpress.co.uk/contact.php",
    "canaryUrl": "https://hart2hartexpress.co.uk/",
    "shows": [
      "status",
      "history",
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "coordinates",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "coordinates"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "harttohart.couriernavigator-secure.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "consign_note"
      ]
    }
  ],
  "detection": []
}
