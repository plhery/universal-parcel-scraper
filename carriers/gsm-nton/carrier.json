{
  "id": "gsm-nton",
  "displayName": "GSM NtoN",
  "aliases": [
    "GSMNtoN",
    "Global Shipping Master",
    "글로벌쉬핑마스터앤투앤"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#354C5E"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "gsm-nton",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "searchUrl": "https://www.gsmnton.com/",
    "canaryUrl": "https://www.gsmnton.com/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "delivery_partner",
      "delivery_tracking_number",
      "sender_name",
      "recipient_name",
      "weight",
      "pieces",
      "flight",
      "order_reference",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "origin",
      "sender_name",
      "recipient_name",
      "weight",
      "pieces",
      "flight",
      "order_reference",
      "remarks"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "expressweb.co.kr",
        "www.expressweb.co.kr"
      ],
      "pathPattern": "^/member/loginTracing\\.do$",
      "query": "^(?=(?:.*&)?fwdCode=gexp(?:&|$))(?:.*&)?HBLNO=([^&]+)(?=&|$)"
    }
  ],
  "detection": []
}
