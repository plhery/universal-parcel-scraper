{
  "id": "posta-moldovei",
  "displayName": "Poșta Moldovei",
  "aliases": [
    "Posta Moldovei",
    "Moldova Post",
    "Post of Moldova",
    "Moldavia Post"
  ],
  "region": {
    "countries": [
      "MD"
    ]
  },
  "brand": {
    "color": "#005baa"
  },
  "selectable": true,
  "timezone": "Europe/Chisinau",
  "tracking": {
    "mode": "automatic",
    "adapter": "posta-moldovei",
    "steps": [
      "trawl"
    ],
    "browser": true,
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://posta.md/en/track-trace/mailing/{trackingNumber}",
    "searchUrl": "https://posta.md/ro/track-trace",
    "helpUrl": "https://posta.md/ro/complaint-petition",
    "canaryUrl": "https://posta.md/ro/track-trace",
    "shows": [
      "status",
      "history",
      "location",
      "weight",
      "sender_name",
      "recipient_name"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "weight",
      "sender_name",
      "recipient_name"
    ],
    "unavailable": [
      "eta",
      "service_name",
      "offset_timestamps",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "posta.md"
      ],
      "path": "^/(?:ro|en|ru)/track-trace/mailing/([^/?#]+)/?$"
    },
    {
      "domains": [
        "posta.md"
      ],
      "pathPattern": "^/(?:ro|en|ru)/tracking/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": [
    {
      "id": "posta-moldovei-1",
      "pattern": "^D[A-Z]\\d{10}(?:AR|AS|CC|RC|RR)$",
      "confidence": "high"
    }
  ]
}
