{
  "id": "blitznow",
  "displayName": "Blitz",
  "aliases": [
    "GrowSimplee",
    "BigShort Tails Private Limited"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#231f20"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "blitznow",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "eta",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://track.blitznow.in/{trackingNumber}",
    "searchUrl": "https://track.blitznow.in/",
    "canaryUrl": "https://track.blitznow.in/",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "eta",
      "delivered_at",
      "offset_timestamps",
      "sender_name",
      "recipient_contact"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "progress_rail",
      "sender_name",
      "recipient_contact"
    ],
    "unavailable": [
      "location",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "track.blitznow.in"
      ],
      "path": "^/track/([A-Za-z0-9-]+)/?$"
    },
    {
      "domains": [
        "track.blitznow.in"
      ],
      "path": "^/((?=[A-Za-z]*\\d)[A-Za-z0-9]{6,40})/?$"
    }
  ],
  "detection": []
}
