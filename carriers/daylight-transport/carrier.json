      "contact_details",
      "postcodes",
      "customer_reference",
      "order_contents",
      "parcel_count",
      "weight",
      "service_name",
      "delivery_instructions",
      "additional_services",
      "next_office"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "eta_window"
    ],
    "discarded": [
      "sender_name",
      "sender_address",
      "recipient_name",
      "recipient_address",
      "contact_details",
      "postcodes",
      "customer_reference",
      "order_contents",
      "parcel_count",
