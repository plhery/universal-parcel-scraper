{
  "id": "paket-cl",
  "displayName": "Paket",
  "aliases": [
    "Paket SpA",
    "Paket Chile",
    "Paket Envios",
    "Paketex"
  ],
  "region": {
    "countries": [
      "CL"
    ]
  },
  "brand": {
    "color": "#614de2"
  },
  "selectable": true,
  "timezone": "America/Santiago",
  "tracking": {
    "mode": "automatic",
    "adapter": "paket-cl",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://track.paket.cl/?id={trackingNumber}",
    "searchUrl": "https://track.paket.cl/",
    "canaryUrl": "https://track.paket.cl/",
    "shows": [
      "status",
      "history",
      "progress_rail",
      "parcel_count",
      "sender_name",
      "destination",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "delivery_instructions",
      "delivery_photo",
      "coordinates"
    ],
    "scraped": [
      "status",
      "history",
      "progress_rail",
      "provider_code"
    ],
    "discarded": [
      "parcel_count",
      "sender_name",
      "destination",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "delivery_instructions",
      "delivery_photo",
      "coordinates"
    ],
    "unavailable": [
      "location",
      "eta",
      "offset_timestamps",
      "weight",
      "service_name",
      "delivered_at",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "track.paket.cl"
      ],
      "pathPattern": "^/?$",
      "query": "(?:^|&)id=(?:[^&]*\\.)?(\\d{4,12})(?=&|$)"
    }
  ],
  "detection": []
}
