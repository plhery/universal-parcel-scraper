{
  "id": "xpress-courier-link",
  "displayName": "ECL Express Courier Link",
  "aliases": [
    "Express Courier Link",
    "Xpress Courier Link"
  ],
  "region": {
    "countries": [
      "PK"
    ]
  },
  "brand": {
    "color": "#e30212"
  },
  "selectable": true,
  "timezone": "Asia/Karachi",
  "tracking": {
    "mode": "automatic",
    "adapter": "xpress-courier-link",
    "steps": [
      "direct",
      "retry",
      "domestic"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country"
  ],
  "portal": {
    "url": "https://xpresscourierlink.com/tracking/?txtstatus=International&search={trackingNumber}",
    "searchUrl": "https://xpresscourierlink.com/tracking/",
    "helpUrl": "https://xpresscourierlink.com/contact-us/",
    "canaryUrl": "https://xpresscourierlink.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "origin",
      "destination_country",
      "booking_date",
      "sender_name",
      "recipient_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "destination_country"
    ],
    "discarded": [
      "origin",
      "booking_date",
      "sender_name",
      "recipient_name"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "recipient_address",
      "delivery_partner",
      "proof_of_delivery",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "xpresscourierlink.com",
        "www.xpresscourierlink.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "search"
      ]
    }
  ],
  "detection": []
}
