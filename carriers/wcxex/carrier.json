{
  "id": "wcxex",
  "displayName": "WCXEX",
  "aliases": [
    "伟成国际",
    "Weicheng International",
    "浙江伟成国际货运代理有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#e60012"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "wcxex",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number",
    "offset_timestamps"
  ],
  "portal": {
    "canaryUrl": "https://t.17track.net/",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_tracking_number",
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number",
      "offset_timestamps"
    ],
    "discarded": [
      "customer_reference",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ]
  },
  "links": [
    {
      "domains": [
        "www.wcxex.com"
      ],
      "pathPattern": "^/track\\.html$",
      "params": [
        "c"
      ]
    },
    {
      "domains": [
        "wc.kjeclub.com"
      ],
      "pathPattern": "^/track_query\\.aspx$",
      "params": [
        "track_number"
      ]
    }
  ],
  "detection": []
}
