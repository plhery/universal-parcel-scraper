{
  "id": "topdelivery",
  "displayName": "TopDelivery",
  "aliases": [
    "Top Delivery",
    "ТопДеливери",
    "ТопДоставка",
    "Internet Logistika",
    "ООО «Интернет Логистика»"
  ],
  "region": {
    "countries": [
      "RU"
    ]
  },
  "brand": {
    "color": "#feaa00"
  },
  "selectable": true,
  "timezone": "Europe/Moscow",
  "tracking": {
    "mode": "automatic",
    "adapter": "topdelivery",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://www.topdelivery.ru/tracking/?order={trackingNumber}",
    "searchUrl": "https://www.topdelivery.ru/tracking/",
    "canaryUrl": "https://www.topdelivery.ru/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "www.topdelivery.ru",
        "topdelivery.ru"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "order"
      ]
    }
  ],
  "detection": []
}
