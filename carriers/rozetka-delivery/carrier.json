    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "pickup_point",
      "provider_code",
      "progress_rail",
      "planned_route"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "pickup_point",
      "provider_code"
    ],
    "discarded": [
      "progress_rail",
      "planned_route"
    ],
    "unavailable": [
      "weight",
      "dimensions",
      "sender_name",
      "recipient_name",
      "service_name",
