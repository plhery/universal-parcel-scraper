{
  "id": "forward-air",
  "displayName": "Forward Air",
  "aliases": [
    "Forward",
    "Forward Air Corporation",
    "Forward Expedited LTL"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#c8102e"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "forward-air",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 755
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "location",
    "eta",
    "delivered_at",
    "weight"
  ],
  "portal": {
    "url": "https://www.forwardair.com/tracking?numbers={trackingNumber}",
    "searchUrl": "https://www.forwardair.com/tracking",
    "canaryUrl": "https://www.forwardair.com/tracking",
    "shows": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "eta_window",
      "delivered_at",
      "weight",
      "parcel_count",
      "signatory",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "location",
      "eta",
      "eta_window",
      "delivered_at",
      "weight"
    ],
    "discarded": [
      "parcel_count",
      "signatory",
      "origin",
      "destination"
    ],
    "unavailable": [
      "offset_timestamps",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.forwardair.com",
        "forwardair.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "numbers"
      ]
    }
  ],
  "detection": []
}
