{
  "id": "australia-post",
  "displayName": "Australia Post",
  "aliases": [
    "StarTrack",
    "Star Track Express"
  ],
  "region": {
    "countries": [
      "AU"
    ]
  },
  "brand": {
    "color": "#dc1928"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "australia-post",
    "steps": [
      "direct",
      "trawl"
    ],
    "recognition": {
      "rank": 500
    },
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "pickup_point",
    "service_name"
  ],
  "portal": {
    "url": "https://auspost.com.au/mypost/track/details/{trackingNumber}",
    "searchUrl": "https://auspost.com.au/mypost/track/details/",
    "canaryUrl": "https://auspost.com.au/mypost/track/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "service_name",
      "destination_country",
      "pickup_point",
      "recipient_name",
      "address",
      "delivery_proof"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "pickup_point",
      "destination_country",
      "service_name"
    ],
    "discarded": [
      "recipient_name",
      "address",
      "delivery_proof"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "auspost.com.au"
      ],
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "auspost.com.au"
      ],
      "path": "^/mypost/track/details/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "australia-post-article",
      "pattern": "^(?!MA\\d{19}$|JJD\\d{18}$)(?:\\d{2})?[A-Z0-9]{3}\\d{9}000\\d{6}$",
      "confidence": "high"
    },
    {
      "id": "australia-post-consignment",
      "pattern": "^\\d{2}(?!\\d{3})[A-Z0-9]{3}\\d{7}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "australia-post-consignment-10",
      "pattern": "^(?![A-Z]{2}\\d)(?!\\d{3})[A-Z0-9]{3}\\d{7}$",
      "confidence": "low"
    },
    {
      "id": "australia-post-startrack",
      "pattern": "^(?=[A-Z0-9]{0,2}[A-Z])[A-Z0-9]{3}Z\\d{8}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "australia-post-prepaid",
      "pattern": "^0[0-3]\\d{20}$",
      "confidence": "low",
      "checksum": "gs1"
    },
    {
      "id": "australia-post-r",
      "pattern": "^R\\d{24}$",
      "confidence": "low"
    },
    {
      "id": "australia-post-s10-tracked",
      "pattern": "^[CEL][A-Z]\\d{9}AU$",
      "confidence": "high",
      "checksum": "s10"
    },
    {
      "id": "australia-post-s10",
      "pattern": "^[A-Z]{2}\\d{9}AU$",
      "confidence": "low",
      "preferred": true,
      "checksum": "s10"
    }
  ]
}
