{
  "id": "dnipro-llc",
  "displayName": "Dnipro LLC",
  "aliases": [
    "DNIPRO LLC",
    "DniproLLC",
    "Днипро ЛЛС",
    "Дніпро ЛЛС"
  ],
  "region": {
    "countries": [
      "US",
      "UA"
    ]
  },
  "brand": {
    "color": "#1c7bd3"
  },
  "selectable": true,
  "timezone": "America/New_York",
  "tracking": {
    "mode": "automatic",
    "adapter": "dnipro-llc",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://dniprollc.com/en/packages-tracking/?tracking={trackingNumber}",
    "searchUrl": "https://dniprollc.com/en/packages-tracking/",
    "helpUrl": "https://dniprollc.com/en/contacts/",
    "canaryUrl": "https://dniprollc.com/en/packages-tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "origin",
      "destination",
      "postcodes",
      "recipient_name",
      "container_number",
      "vessel"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "provider_code"
    ],
    "discarded": [
      "origin",
      "destination",
      "postcodes",
      "recipient_name",
      "container_number",
      "vessel"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "weight",
      "sender_name",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "dniprollc.com",
        "www.dniprollc.com"
      ],
      "pathPattern": "^/(?:en/)?packages-tracking/?$",
      "params": [
        "tracking"
      ]
    }
  ],
  "detection": []
}
