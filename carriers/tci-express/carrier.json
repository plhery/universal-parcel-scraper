{
  "id": "tci-express",
  "displayName": "TCI Express",
  "aliases": [
    "TCIEXPRESS",
    "TCI Express Limited",
    "Transport Corporation of India Express",
    "TCI",
    "TCI XPS"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#0d5fa6"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "tci-express",
    "steps": [
      "direct",
      "retry",
      "trawl"
    ],
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "weight"
  ],
  "portal": {
    "url": "https://www.tciexpress.in/track-your-shipment?trackshipment={trackingNumber}&dwb=dwb",
    "searchUrl": "https://www.tciexpress.in/trackingdocket.aspx",
    "canaryUrl": "https://www.tciexpress.in/trackingdocket.aspx",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "parcel_count",
      "postcodes",
      "destination",
      "contact_details",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "weight"
    ],
    "discarded": [
      "parcel_count",
      "postcodes",
      "destination",
      "contact_details",
      "proof_of_delivery"
    ],
    "unavailable": [
      "service_name",
      "delivered_at",
      "offset_timestamps",
      "sender_name",
      "recipient_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.tciexpress.in",
        "tciexpress.in"
      ],
      "pathPattern": "^/trackingdocket\\.aspx$",
      "params": [
        "trackshipment"
      ]
    },
    {
      "domains": [
        "www.tciexpress.in",
        "tciexpress.in"
      ],
      "pathPattern": "^/track-your-shipment/?$",
      "params": [
        "trackshipment"
      ]
    }
  ],
  "detection": []
}
