{
  "id": "dpd-pt",
  "displayName": "DPD Portugal",
  "aliases": [
    "Chronopost Portugal",
    "DPD PT"
  ],
  "region": {
    "countries": [
      "PT"
    ]
  },
  "brand": {
    "color": "#dc0032"
  },
  "selectable": true,
  "timezone": "Europe/Lisbon",
  "tracking": {
    "mode": "automatic",
    "adapter": "dpd-pt",
    "steps": [
      "direct",
      "retry",
      "trawl"
    ],
    "recognition": {
      "rank": 815
    },
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "eta_window",
    "pickup_point"
  ],
  "portal": {
    "url": "https://tracking.dpd.pt/pt?reference={trackingNumber}",
    "searchUrl": "https://tracking.dpd.pt/pt",
    "canaryUrl": "https://tracking.dpd.pt/pt",
    "shows": [
      "status",
      "history",
      "provider_code",
      "progress_rail",
      "coordinates",
      "eta_window",
      "pickup_point",
      "depot_code",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "eta_window",
      "pickup_point"
    ],
    "discarded": [
      "progress_rail",
      "coordinates",
      "depot_code",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "location",
      "offset_timestamps",
      "eta",
      "weight",
      "service_name",
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.dpd.pt",
        "dpd.pt"
      ],
      "pathPattern": "^/(?:track-and-trace|en/getting-parcel/track-trace)/?$",
      "params": [
        "reference"
      ]
    },
    {
      "domains": [
        "dpdgroup.com",
        "dpd.com"
      ],
      "pathPattern": "^/pt(?:/|$)",
      "params": [
        "parcelNumber",
        "parcelnumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "dpd-pt-1",
      "pattern": "^09(?:5[5-9]|[67]\\d|8[0-8])\\d{10}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "dpd-pt-2",
      "pattern": "^09(?:5[5-9]|[67]\\d|8[0-8])\\d{10}[0-9A-Z]$",
      "confidence": "low",
      "checksum": "dpd",
      "preferred": true
    },
    {
      "id": "dpd-pt-3",
      "pattern": "^\\d{14}$",
      "confidence": "low"
    },
    {
      "id": "dpd-pt-4",
      "pattern": "^\\d{14}[0-9A-Z]$",
      "confidence": "low",
      "checksum": "dpd"
    }
  ]
}
