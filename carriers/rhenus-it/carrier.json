{
  "id": "rhenus-it",
  "displayName": "Rhenus Italia",
  "aliases": [
    "Rhenus Italy",
    "Rhenus Logistics S.p.A."
  ],
  "region": {
    "countries": [
      "IT"
    ]
  },
  "brand": {
    "color": "#00499a"
  },
  "selectable": true,
  "timezone": "Europe/Rome",
  "tracking": {
    "mode": "automatic",
    "adapter": "rhenus-it",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://tracking.rhenusitalia.it/rhenus/tracking.jsf?s={trackingNumber}",
    "searchUrl": "https://tracking.rhenusitalia.it/rhenus/track.jsf",
    "helpUrl": "https://tracking.rhenusitalia.it/rhenus/faq.jsf",
    "canaryUrl": "https://www.rhenus.group/it/it/",
    "shows": [
      "status",
      "history",
      "customer_reference",
      "sender_name",
      "recipient_address",
      "remarks",
      "eta_window"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [
      "customer_reference",
      "sender_name",
      "recipient_address",
      "remarks",
      "eta_window"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "tracking.rhenusitalia.it"
      ],
      "pathPattern": "^/rhenus/tracking\\.jsf$",
      "params": [
        "s"
      ]
    }
  ],
  "detection": []
}
