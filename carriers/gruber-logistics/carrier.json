{
  "id": "gruber-logistics",
  "displayName": "GRUBER Logistics",
  "aliases": [
    "GRUBER Logistics S.p.A."
  ],
  "region": {
    "countries": [
      "IT",
      "DE",
      "AT"
    ]
  },
  "brand": {
    "color": "#d92c27"
  },
  "selectable": true,
  "timezone": "Europe/Rome",
  "tracking": {
    "mode": "automatic",
    "adapter": "gruber-logistics",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "offset_timestamps",
    "location"
  ],
  "portal": {
    "url": "https://glapptracking.gruber-logistics.com/?trackingId={trackingNumber}",
    "searchUrl": "https://glapptracking.gruber-logistics.com/search-tracking-number",
    "helpUrl": "https://www.gruber-logistics.com/contatti/",
    "canaryUrl": "https://glapptracking.gruber-logistics.com/search-tracking-number",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "eta",
      "origin",
      "destination",
      "order_reference",
      "customer_reference",
      "references",
      "weight",
      "volume",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "progress_rail",
      "eta",
      "origin",
      "destination",
      "order_reference",
      "customer_reference",
      "references",
      "weight",
      "volume",
      "parcel_count"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "glapptracking.gruber-logistics.com"
      ],
      "pathPattern": "^/?$",
      "params": [
        "trackingId"
      ]
    }
  ],
  "detection": []
}
