{
  "id": "barq",
  "displayName": "BARQ",
  "aliases": [
    "BARQ Fleet",
    "Barq Logistics",
    "برق"
  ],
  "region": {
    "countries": [
      "SA"
    ]
  },
  "brand": {
    "color": "#ffdf01"
  },
  "selectable": true,
  "timezone": "Asia/Riyadh",
  "tracking": {
    "mode": "automatic",
    "adapter": "barq",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://web.barqfleet.com/en/tracking-details?trackingId={trackingNumber}",
    "searchUrl": "https://web.barqfleet.com/en/tracking",
    "helpUrl": "https://barqapp-help.freshdesk.com/en/support/home",
    "canaryUrl": "https://web.barqfleet.com/en/tracking",
    "shows": [
      "status",
      "history",
      "scan_times",
      "merchant",
      "coordinates"
    ],
    "scraped": [
      "status",
      "history",
      "scan_times",
      "provider_code"
    ],
    "discarded": [
      "merchant",
      "coordinates"
    ],
    "unavailable": [
      "eta",
      "location",
      "weight",
      "recipient_name"
    ]
  },
  "links": [
    {
      "domains": [
        "web.barqfleet.com"
      ],
      "pathPattern": "^/(?:en|ar)/tracking-details/?$",
      "params": [
        "trackingId"
      ]
    }
  ],
  "detection": []
}
