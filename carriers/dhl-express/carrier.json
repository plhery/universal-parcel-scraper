{
  "id": "dhl-express",
  "displayName": "DHL Express",
  "aliases": [
    "DHL Express Worldwide",
    "MyDHL+"
  ],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#ffcc00"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "dhl-express",
    "steps": [
      "direct",
      "api",
      "trawl"
    ],
    "recognition": {
      "rank": 990
    },
    "browserRecognition": {
      "rank": 750
    },
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://mydhl.express.dhl/gb/en/tracking.html#/results?id={trackingNumber}",
    "searchUrl": "https://www.dhl.com/gb-en/home/tracking.html",
    "canaryUrl": "https://mydhl.express.dhl/gb/en/tracking.html",
    "shows": [
      "status",
      "history",
      "location",
      "signature"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "signature"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "mydhl.express.dhl"
      ],
      "fragment": "^/results\\?id=(\\d{10})(?:&|$)"
    },
    {
      "domains": [
        "logistics.dhl"
      ],
      "pathPattern": "/tracking-express\\.html$",
      "params": [
        "tracking-id"
      ],
      "ownNumbersOnly": true
    },
    {
      "domains": [
        "dhlexpress.pl"
      ]
    }
  ],
  "detection": [
    {
      "id": "dhl-express-waybill",
      "pattern": "^\\d{10}$",
      "confidence": "low",
      "checksum": "dhl-express",
      "preferred": true
    },
    {
      "id": "dhl-express-piece",
      "pattern": "^JD01\\d{16}$",
      "confidence": "high"
    },
    {
      "id": "dhl-express-piece-label",
      "pattern": "^JJD0146\\d{14}$",
      "confidence": "high"
    },
    {
      "id": "dhl-express-piece-label-after",
      "pattern": "^JD0146\\d{14}J$",
      "confidence": "high"
    }
  ]
}
