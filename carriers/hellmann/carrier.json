{
  "id": "hellmann",
  "displayName": "Hellmann Worldwide Logistics",
  "aliases": [
    "Hellmann"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#004c99"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "hellmann",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [],
  "portal": {
    "url": "https://public.tracking.hellmann.net/search/{trackingNumber}",
    "searchUrl": "https://www.hellmann.com/en/track-trace",
    "canaryUrl": "https://www.hellmann.com/en/track-trace",
    "shows": [
      "Current road package status",
      "Last-change clock"
    ],
    "scraped": [
      "Current road package status",
      "Last-change clock"
    ],
    "discarded": [
      "Shipment references and cargo details"
    ],
    "unavailable": [
      "Dated scan history"
    ]
  },
  "links": [
    {
      "domains": [
        "public.tracking.hellmann.net"
      ],
      "path": "^/search/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
