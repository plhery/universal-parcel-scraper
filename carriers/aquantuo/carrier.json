{
  "id": "aquantuo",
  "displayName": "Aquantuo",
  "aliases": [
    "aquantuo.com"
  ],
  "region": {
    "countries": [
      "GH",
      "NG",
      "KE",
      "RW",
      "TZ",
      "UG",
      "ZM",
      "US",
      "GB",
      "CN"
    ]
  },
  "brand": {
