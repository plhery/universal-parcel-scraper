    "canaryUrl": "https://aquantuo.com/track-order",
    "shows": [
      "status",
      "history",
      "eta",
      "event_message"
    ],
    "scraped": [
      "status",
      "history",
      "eta"
    ],
    "discarded": [
      "event_message"
    ],
    "unavailable": [
      "offset_timestamps",
      "location",
      "weight",
      "recipient_name",
      "destination_country"
    ]
  },
  "links": [
    {
      "domains": [
        "aquantuo.com",
        "www.aquantuo.com"
      ],
      "pathPattern": "^/track-order/?$",
      "params": [
        "package_id"
      ]
