{
  "id": "ecoscooting",
  "displayName": "Ecoscooting",
  "aliases": [],
  "region": {
    "countries": [
      "ES",
      "PT"
    ]
  },
  "brand": {
    "color": "#3fa7ff"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "ecoscooting",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 655,
      "pattern": "^(?:(?:0[1-9]|[1-4]\\d|5[0-2])\\d{3}0000\\d{9}|[CE]2\\d(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{8})$"
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "pickup_point",
    "weight",
    "delivered_at"
  ],
  "portal": {
    "url": "https://ecoscooting.com/tracking/{trackingNumber}",
    "searchUrl": "https://ecoscooting.com/",
    "helpUrl": "https://www.ecoscooting.com/atencionCliente",
    "canaryUrl": "https://ecoscooting.com/tracking/1",
    "shows": [
      "status",
      "history",
      "pickup_point",
      "weight",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "pickup_point",
      "weight",
      "delivered_at"
    ],
    "discarded": [
      "postcodes",
      "coordinates",
      "order_references",
      "routing_features",
      "pickup_code"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "ecoscooting.com"
      ],
      "path": "^/tracking/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "ecoscooting-postcode-label",
      "pattern": "^(?!3232|44)(?:0[1-9]|[1-4]\\d|5[0-2])\\d{3}0000\\d{9}$",
      "confidence": "high"
    },
    {
      "id": "ecoscooting-postcode",
      "pattern": "^(?:0[1-9]|[1-4]\\d|5[0-2])\\d{3}0000\\d{9}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "ecoscooting-1",
      "pattern": "^\\d{18}$",
      "confidence": "low"
    },
    {
      "id": "ecoscooting-2",
      "pattern": "^CN(?:ESP|PRT)\\d{20}$",
      "confidence": "high"
    },
    {
      "id": "ecoscooting-without-cn",
      "pattern": "^(?:ESP\\d{5}1234\\d{11}|PRT\\d{7}1234\\d{9})$",
      "confidence": "high"
    },
    {
      "id": "ecoscooting-shein-package",
      "pattern": "^[CE]2\\d(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{8}$",
      "confidence": "low"
    }
  ]
}
