{
  "id": "walker-logistics",
  "displayName": "Walker Logistics",
  "aliases": [
    "Walker Courier"
  ],
  "region": {
    "countries": [
      "NZ"
    ]
  },
  "brand": {
    "color": "#3e4095"
  },
  "selectable": true,
  "timezone": "Pacific/Auckland",
  "tracking": {
    "mode": "automatic",
    "adapter": "walker-logistics",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://walkerlogistics.tempo.delivery/tracker/#/{trackingNumber}",
    "searchUrl": "https://walkerlogistics.tempo.delivery/tracker/",
    "canaryUrl": "https://walkerlogistics.tempo.delivery/tracker/",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "walkerlogistics.tempo.delivery"
      ],
      "pathPattern": "^/tracker/?$",
      "fragment": "^/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
