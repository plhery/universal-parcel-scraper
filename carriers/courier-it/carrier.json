{
  "id": "courier-it",
  "displayName": "Courier IT",
  "aliases": [
    "CourierIT",
    "Courier IT SA"
  ],
  "region": {
    "countries": [
      "ZA"
    ]
  },
  "brand": {
    "color": "#eb2227"
  },
  "selectable": true,
  "timezone": "Africa/Johannesburg",
  "tracking": {
    "mode": "automatic",
    "adapter": "courier-it",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://intellitrack.courierit.co.za/?SearchString={trackingNumber}",
    "searchUrl": "https://intellitrack.courierit.co.za/",
    "helpUrl": "https://www.courierit.co.za/contact-us/",
    "canaryUrl": "https://intellitrack.courierit.co.za/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "sender_name",
      "signatory"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times"
    ],
    "discarded": [
      "sender_name",
      "signatory"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "intellitrack.courierit.co.za"
      ],
      "pathPattern": "^/?$",
      "params": [
        "SearchString"
      ]
    },
    {
      "domains": [
        "courierit.co.za",
        "www.courierit.co.za"
      ],
      "pathPattern": "^/Trackit/Trackit\\.aspx$",
      "params": [
        "WaybillNumber"
      ]
    }
  ],
  "detection": []
}
