{
  "id": "wedo",
  "displayName": "One by Allegro CZ",
  "aliases": [
    "WeDo (InTime)",
    "WeDo",
    "WE|DO",
    "WE DO",
    "WE|DO CZ",
    "WE|DO CZ s.r.o.",
    "IN TIME spedice",
    "Uloženka",
    "Ulozenka",
    "One Kurýr",
    "One Box CZ"
  ],
  "region": {
    "countries": [
      "CZ"
    ]
  },
  "brand": {
    "color": "#006d57"
  },
  "selectable": true,
  "timezone": "Europe/Prague",
  "tracking": {
    "mode": "automatic",
    "adapter": "wedo",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "delivered_at"
  ],
  "portal": {
    "url": "https://onedelivery.cz/sledovani-zasilky?numer={trackingNumber}",
    "searchUrl": "https://onedelivery.cz/sledovani-zasilky",
    "canaryUrl": "https://onedelivery.cz/",
    "shows": [
      "status",
      "history",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "detail_messages"
    ],
    "unavailable": [
      "eta",
      "location",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "onedelivery.cz",
        "www.onedelivery.cz"
      ],
      "pathPattern": "^/(?:sledovani-zasilky/?)?$",
      "params": [
        "numer"
      ]
    },
    {
      "domains": [
        "trace.wedo.cz",
        "trace.intime.cz"
      ],
      "pathPattern": "^/index\\.php$",
      "params": [
        "orderNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "wedo-1",
      "pattern": "^(?!7[DX]\\d)\\d(?:[A-Z][0-9A-Z]|\\d[A-Z])\\d{8}$",
      "confidence": "high"
    }
  ]
}
