{
  "id": "domex-do",
  "displayName": "Domex Expreso",
  "aliases": [
    "Domex República Dominicana"
  ],
  "region": {
    "countries": [
      "DO"
    ]
  },
  "brand": {
    "color": "#fdda1c"
  },
  "selectable": true,
  "timezone": "America/Santo_Domingo",
  "tracking": {
    "mode": "automatic",
    "adapter": "domex-do",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://domex.do/rastreo?guia={trackingNumber}",
    "searchUrl": "https://domex.do/rastreo",
    "helpUrl": "https://domex.do/ayuda",
    "canaryUrl": "https://domex.do/rastreo",
    "shows": [
      "status",
      "history",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [],
    "unavailable": [
      "offset_timestamps",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "domex.do"
      ],
      "pathPattern": "^/rastreo/?$",
      "params": [
        "guia"
      ]
    },
    {
      "domains": [
        "domex-online.iplus.com.do"
      ],
      "pathPattern": "^/lg-es/ut/Estatus\\.aspx$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
