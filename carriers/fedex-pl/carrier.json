{
  "id": "fedex-pl",
  "displayName": "FedEx Poland",
  "aliases": [
    "FedEx Polska",
    "Opek"
  ],
  "region": {
    "countries": [
      "PL"
    ]
  },
  "brand": {
    "color": "#4d148c"
  },
  "selectable": true,
  "timezone": "Europe/Warsaw",
  "tracking": {
    "mode": "automatic",
    "adapter": "fedex-pl",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 882
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "delivered_at",
    "weight",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://fds2tracking.emea.fedex.com/#/preview?packages={trackingNumber}&trackingKey={trackingNumber}",
    "searchUrl": "https://fds2tracking.emea.fedex.com/",
    "helpUrl": "https://www.fedex.com/customer-support/pl-pl",
    "canaryUrl": "https://fds2tracking.emea.fedex.com/",
    "shows": [
      "status",
      "history",
      "location",
      "eta_window",
      "delivered_at",
      "weight",
      "parcel_count",
      "origin",
      "destination",
      "departure_date",
      "return_number",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "eta_window",
      "delivered_at",
      "weight",
      "offset_timestamps"
    ],
    "discarded": [
      "parcel_count",
      "origin",
      "destination",
      "departure_date",
      "return_number",
      "proof_of_delivery"
    ],
    "unavailable": [
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "delivery_partner",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "fds2tracking.emea.fedex.com"
      ],
      "pathPattern": "^/$",
      "fragment": "^/preview\\?(?:[^#]*&)?trackingKey=(\\d{13})(?:&|$)"
    },
    {
      "domains": [
        "fedex.com"
      ],
      "pathPattern": "^/(?:pl-pl|en-pl)/online/domestic-tracking\\.html$",
      "fragment": "^/preview\\?(?:[^#]*&)?trackingKey=(\\d{13})(?:&|$)"
    },
    {
      "domains": [
        "fedex.com"
      ],
      "pathPattern": "^/(?:(?:apps/)?fedextrack|wtrk/track)(?:/|$)",
      "query": "(?:^|&)(?:trknbr|tracknumbers)=(\\d{13})(?=[&,|]|$)"
    },
    {
      "domains": [
        "poland.fedex.com"
      ],
      "pathPattern": "^/domestic-shipping/pub/tracktrace\\.do$",
      "params": [
        "packageId"
      ]
    }
  ],
  "detection": [
    {
      "id": "fedex-pl-1",
      "pattern": "^6\\d{12}$",
      "confidence": "low",
      "checksum": "gs1"
    }
  ]
}
