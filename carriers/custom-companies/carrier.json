{
  "id": "custom-companies",
  "displayName": "The Custom Companies",
  "aliases": [
    "Custom Companies",
    "The Custom Companies, Inc."
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#ffca43"
  },
  "selectable": true,
  "timezone": "America/Chicago",
  "tracking": {
    "mode": "automatic",
    "adapter": "custom-companies",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://api.customco.com/scripts/cgiip.exe/boldetail.htm?wbtn=PRO&wpro1={trackingNumber}&seskey=&nav=top&language=",
    "searchUrl": "https://www.customco.com/",
    "helpUrl": "https://www.customco.com/contact/",
    "canaryUrl": "https://www.customco.com/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "signatory",
      "customer_reference",
      "origin",
      "destination",
      "parcel_count",
      "weight",
      "service_name",
      "dimensions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "signatory",
      "customer_reference",
      "origin",
      "destination",
      "parcel_count",
      "weight",
      "service_name",
      "dimensions"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "api.customco.com"
      ],
      "pathPattern": "^/shipmenttrace\\.htm$",
      "params": [
        "referencenumber"
      ]
    },
    {
      "domains": [
        "api.customco.com"
      ],
      "pathPattern": "^/scripts/cgiip\\.exe/boldetail\\.htm$",
      "params": [
        "wpro1"
      ]
    }
  ],
  "detection": []
}
