{
  "id": "night-star-express",
  "displayName": "Night Star Express",
  "aliases": [
    "Night Star Express GmbH Logistik",
    "NSE"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#004170"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "night-star-express",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "offset_timestamps",
    "service_name"
  ],
  "portal": {
    "url": "https://customer.night-star-express.de/tracking/{trackingNumber}",
    "searchUrl": "https://customer.night-star-express.de/",
    "helpUrl": "https://www.night-star-express.de/de/kontakt.html",
    "canaryUrl": "https://customer.night-star-express.de/",
    "shows": [
      "status",
      "history",
      "service_name",
      "origin",
      "recipient_address",
      "weight",
      "dimensions",
      "signatory",
      "proof_of_delivery",
      "postcodes"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivered_at",
      "offset_timestamps",
      "service_name"
    ],
    "discarded": [
      "origin",
      "recipient_address",
      "weight",
      "dimensions",
      "signatory",
      "proof_of_delivery",
      "postcodes"
    ],
    "unavailable": [
      "eta",
      "location"
    ]
  },
  "links": [
    {
      "domains": [
        "customer.night-star-express.de"
      ],
      "path": "^/tracking/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
