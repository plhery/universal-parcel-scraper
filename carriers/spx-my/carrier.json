{
  "id": "spx-my",
  "displayName": "SPX Express Malaysia",
  "aliases": [
    "Shopee Express Malaysia",
    "Shopee Xpress Malaysia",
    "SPX Malaysia",
    "SPX Express (MY)"
  ],
  "region": {
    "countries": [
      "MY"
    ]
  },
  "brand": {
    "color": "#ee4d2d"
  },
  "selectable": true,
  "timezone": "Asia/Kuala_Lumpur",
  "tracking": {
    "mode": "automatic",
    "adapter": "spx-my",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://spx.com.my/track?{trackingNumber}",
    "searchUrl": "https://spx.com.my/track",
    "canaryUrl": "https://spx.com.my/track",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "progress_rail",
      "seller_location",
      "office_addresses"
    ],
    "unavailable": [
      "eta",
      "weight",
      "pickup_point",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "spx.com.my"
      ],
      "pathPattern": "^/(?:m/)?track/?$",
      "query": "^(SPXMY\\d{11}[0-9A-Z]|MY\\d{12}[0-9A-Z])$"
    },
    {
      "domains": [
        "spx.com.my"
      ],
      "path": "^/detail/(SPXMY\\d{11}[0-9A-Z]|MY\\d{12}[0-9A-Z])/?$"
    },
    {
      "domains": [
        "spx.com.my"
      ],
      "pathPattern": "^/en/tracking/?$",
      "params": [
        "tracking_no"
      ]
    }
  ],
  "detection": [
    {
      "id": "spx-my-1",
      "pattern": "^SPXMY\\d{11}[0-9A-Z]$",
      "confidence": "high"
    },
    {
      "id": "spx-my-2",
      "pattern": "^MY\\d{12}[0-9A-Z]$",
      "confidence": "low"
    }
  ]
}
