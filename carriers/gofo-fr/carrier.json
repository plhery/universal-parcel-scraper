{
  "id": "gofo-fr",
  "displayName": "GOFO France",
  "aliases": [
    "GOFO FR",
    "CIRRO Parcel France"
  ],
  "region": {
    "countries": [
      "FR"
    ]
  },
  "brand": {
    "color": "#fc4c02"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "gofo-fr",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 470
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "service_name",
    "eta"
  ],
  "portal": {
    "url": "https://www.gofo.com/fr/tracking-results/?id={trackingNumber}",
    "searchUrl": "https://www.gofo.com/fr/tracking-results/",
    "helpUrl": "https://www.gofo.com/fr/contact-us/",
    "canaryUrl": "https://www.gofo.com/fr/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "delivery_photo",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "service_name",
      "eta"
    ],
    "discarded": [
      "delivery_detail",
      "proof_images",
      "personal_references",
      "recipient_verification",
      "unlabelled_weight",
      "notices"
    ],
    "unavailable": [
      "delivery_photo"
    ]
  },
  "links": [
    {
      "domains": [
        "gofo.com"
      ],
      "pathPattern": "^/fr(?:/|$)",
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "gofoexpress.fr"
      ],
      "params": [
        "id"
      ]
    }
  ],
  "detection": [
    {
      "id": "gofo-fr-1",
      "pattern": "^GFFR\\d{14}$",
      "confidence": "high",
      "checksum": "gofo-europe"
    },
    {
      "id": "gofo-fr-unchecked",
      "pattern": "^(?:(?:GF|CI)FR\\d{13}|CIFR\\d{14})$",
      "confidence": "high"
    },
    {
      "id": "gofo-fr-2",
      "pattern": "^PK\\d{20}$",
      "confidence": "low"
    }
  ]
}
