{
  "id": "rohlig-suus",
  "displayName": "Rohlig SUUS Logistics",
  "aliases": [
    "Rohlig SUUS",
    "SUUS",
    "Rohlig Suus Logistics S.A."
  ],
  "region": {
    "countries": [
      "PL"
    ]
  },
  "brand": {
    "color": "#003f8a"
  },
  "selectable": true,
  "timezone": "Europe/Warsaw",
  "tracking": {
    "mode": "automatic",
    "adapter": "rohlig-suus",
    "steps": [
      "trawl"
    ],
    "browser": true,
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta",
    "destination_country"
  ],
  "portal": {
    "url": "https://portal.suus.com/order-details/{trackingNumber}",
    "searchUrl": "https://portal.suus.com/visibility",
    "helpUrl": "https://suus.com/pl/kontakt",
    "canaryUrl": "https://portal.suus.com/visibility",
    "shows": [
      "status",
      "progress_rail",
      "history",
      "location",
      "eta",
      "departure_date",
      "origin",
      "destination",
      "destination_country",
      "recipient_name",
      "weight",
      "volume",
      "parcel_count",
      "customer_reference",
      "service_name",
      "delivery_options"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "destination_country"
    ],
    "discarded": [
      "progress_rail",
      "departure_date",
      "origin",
      "destination",
      "recipient_name",
      "weight",
      "volume",
      "parcel_count",
      "customer_reference",
      "service_name",
      "delivery_options"
    ],
    "unavailable": [
      "offset_timestamps",
      "delivered_at",
      "sender_name",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "portal.suus.com"
      ],
      "path": "^/order-details/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
