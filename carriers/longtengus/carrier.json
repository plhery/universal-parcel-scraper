{
  "id": "longtengus",
  "displayName": "Longteng",
  "aliases": [
    "龙腾转运",
    "龙腾",
    "Longteng Zhuanyun"
  ],
  "region": {
    "countries": [
      "US",
      "CN"
    ]
  },
  "brand": {
    "color": "#151e49"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "longtengus",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.longtengus.com/TrackingInfo?TrackginNO={trackingNumber}",
    "searchUrl": "https://www.longtengus.com/",
    "canaryUrl": "https://www.longtengus.com/",
    "shows": [
      "status",
      "history",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "location",
      "destination_country",
      "recipient_name",
      "proof_of_delivery",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "longtengus.com"
      ],
      "pathPattern": "^/TrackingInfo/?$",
      "params": [
        "TrackginNO"
      ]
    }
  ],
  "detection": []
}
