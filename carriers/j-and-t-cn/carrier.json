{
  "id": "j-and-t-cn",
  "displayName": "J&T Express China",
  "aliases": [
    "极兔速递",
    "极兔速运",
    "极兔快递",
    "J&T 极兔速递"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#e62019"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "j-and-t-cn",
    "requirements": [
      {
        "field": "phoneDigits",
        "validator": "phoneLastFour",
        "optional": true,
        "showsMore": true,
        "label": "Last 4 digits of the phone number",
        "type": "text",
        "help": "J&T Express China shows a parcel only with the last four digits of the recipient's or sender's phone. Without them, other sources are asked.",
        "pattern": "^[0-9]{4}$",
        "maxLength": 4,
        "inputMode": "numeric",
        "autoComplete": "off"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "delivered_at",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://www.jtexpress.com.cn/service.html?indexIpt={trackingNumber}",
    "searchUrl": "https://www.jtexpress.com.cn/",
    "helpUrl": "https://www.jtexpress.com.cn/aboutUs.html?type=LX",
    "canaryUrl": "https://www.jtexpress.com.cn/",
    "shows": [
      "status",
      "history",
      "origin",
      "destination",
      "event_details",
      "driver_name",
      "contact_details",
      "proof_of_delivery",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "origin",
      "destination",
      "event_details",
      "driver_name",
      "contact_details",
      "proof_of_delivery",
      "remarks"
    ],
    "unavailable": [
      "eta",
      "weight"
    ]
  },
  "links": [
    {
      "domains": [
        "www.jtexpress.com.cn",
        "jtexpress.com.cn"
      ],
      "pathPattern": "^/service\\.html$",
      "params": [
        "indexIpt"
      ]
    }
  ],
  "detection": [
    {
      "id": "j-and-t-cn-1",
      "pattern": "^JT\\d{13}$",
      "confidence": "low"
    }
  ]
}
