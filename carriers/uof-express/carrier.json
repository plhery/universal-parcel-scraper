{
  "id": "uof-express",
  "displayName": "UOF International",
  "aliases": [
    "UOF EXPRESS",
    "骏佳国际",
    "Shanghai Junjia International Logistics",
    "上海骏佳翊供应链管理有限公司",
    "上海骏佳国际物流有限公司",
    "上海駿佳国際物流"
  ],
  "region": {
    "countries": [
      "CN",
      "JP"
    ]
  },
  "brand": {
    "color": "#e66814"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "uof-express",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination"
  ],
  "portal": {
    "url": "https://www.uofexp.com/search_order.aspx?trackNumber={trackingNumber}",
    "searchUrl": "https://www.uofexp.com/search_order.aspx",
    "canaryUrl": "https://www.uofexp.com/",
    "shows": [
      "status",
      "history",
      "location",
      "destination",
      "canonical_tracking_number",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination"
    ],
    "discarded": [
      "canonical_tracking_number",
      "parcel_count"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.uofexp.com",
        "uofexp.com"
      ],
      "pathPattern": "^/search_order\\.aspx$",
      "params": [
        "trackNumber"
      ]
    }
  ],
  "detection": []
}
