{
  "id": "runforint",
  "displayName": "Runforint Logistics",
  "aliases": [
    "Runforint",
    "RFL",
    "润峯物流",
    "润峯",
    "江苏润峯国际物流有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#c51e32"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "runforint",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.runforint.com/index.php?m=home&c=Lists&a=index&tid=137&key={trackingNumber}",
    "searchUrl": "https://www.runforint.com/index.php?m=home&c=Lists&a=index&tid=137",
    "helpUrl": "https://www.runforint.com/index.php?m=home&c=Lists&a=index&tid=107",
    "canaryUrl": "https://www.runforint.com/",
    "shows": [
      "status",
      "history",
      "location",
      "destination_country",
      "sender_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country"
    ],
    "discarded": [
      "sender_name"
    ],
    "unavailable": [
      "eta",
      "weight",
      "offset_timestamps",
      "delivery_tracking_number"
    ]
  },
  "links": [
    {
      "domains": [
        "www.runforint.com"
      ],
      "pathPattern": "^/index\\.php$",
      "query": "^(?=(?:.*&)?tid=137(?:&|$))(?:.*&)?key=([^&]+)(?=&|$)"
    }
  ],
  "detection": []
}
