{
  "id": "nova-poshta",
  "displayName": "Nova Poshta (Ukraine)",
  "aliases": [
    "Nova Poshta",
    "Nova Post Ukraine",
    "Нова Пошта"
  ],
  "region": {
    "countries": [
      "UA"
    ]
  },
  "brand": {
    "color": "#e30613"
  },
  "selectable": true,
  "timezone": "Europe/Kyiv",
  "tracking": {
    "mode": "automatic",
    "adapter": "nova-poshta",
    "steps": [
      "direct",
      "summary"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "weight",
    "dimensions",
    "pickup_point",
    "delivered_at",
    "provider_code",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://novaposhta.ua/en/tracking/{trackingNumber}",
    "searchUrl": "https://novaposhta.ua/en/tracking/",
    "canaryUrl": "https://novaposhta.ua/en/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "dimensions",
      "pickup_point",
      "destination_country",
      "delivery_partner",
      "delivery_partner_reference"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "weight",
      "dimensions",
      "pickup_point",
      "destination_country",
      "delivery_partner",
      "delivery_partner_reference"
    ],
    "discarded": [
      "recipient_details",
      "sender_details",
      "addresses",
      "payment_details",
      "origin_country",
      "order_references"
    ],
    "unavailable": [
      "sender_name"
    ]
  },
  "links": [
    {
      "domains": [
        "novaposhta.ua"
      ],
      "path": "^/(?:en/)?tracking/(\\d{14})(?:/|$)"
    }
  ],
  "detection": [
    {
      "id": "nova-poshta-domestic",
      "pattern": "^(?:(?:20[4678]|590|595)\\d{11}|(?:21|51)\\d{12})$",
      "confidence": "low"
    }
  ]
}
