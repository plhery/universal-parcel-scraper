{
  "id": "airwings-india",
  "displayName": "Airwings India",
  "aliases": [
    "Airwings Courier Express India",
    "Airwings Courier Express (India) Pvt. Ltd.",
    "Airwings Logistics",
    "Airwings Logistics Pvt. Ltd.",
    "Airwings Logistics Private Limited"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#007cf0"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "airwings-india",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://airwingsindia.com/tracking.html?awbno={trackingNumber}",
    "searchUrl": "https://airwingsindia.com/tracking.html",
    "helpUrl": "https://airwingsindia.com/contact.html",
    "canaryUrl": "https://airwingsindia.com/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "sender_name",
      "recipient_name",
      "customer_reference",
      "awb_date",
      "eta",
      "delivered_at",
      "signatory",
      "proof_of_delivery",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "origin",
      "sender_name",
      "recipient_name",
      "customer_reference",
      "awb_date",
      "eta",
      "delivered_at",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "airwingsindia.com",
        "www.airwingsindia.com"
      ],
      "pathPattern": "^/tracking\\.html$",
      "params": [
        "awbno"
      ]
    }
  ],
  "detection": []
}
