{
  "id": "xingyunyi",
  "displayName": "XingYunYi",
  "aliases": [
    "XYY",
    "XYY / XingYunYi",
    "XingYunYi Logistics",
    "XYY Logistics",
    "行运易",
    "行运易物流",
    "广州行运易国际供应链有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#3b9dff"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "xingyunyi",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.xingyunyi.com/tracking?nums={trackingNumber}",
    "searchUrl": "https://www.xingyunyi.com/tracking",
    "helpUrl": "https://www.xingyunyi.com/contactus",
    "canaryUrl": "https://www.xingyunyi.com/",
    "shows": [
      "status",
      "history",
      "location",
      "origin_country",
      "destination_country",
      "delivery_tracking_number",
      "transit_time"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "origin_country",
      "transit_time"
    ],
    "unavailable": [
      "eta",
      "weight",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "pickup_point",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.xingyunyi.com",
        "xingyunyi.com",
        "www.xingyunyi.cn",
        "xingyunyi.cn"
      ],
      "pathPattern": "^/(?:cn/)?tracking/?$",
      "params": [
        "nums"
      ]
    }
  ],
  "detection": []
}
