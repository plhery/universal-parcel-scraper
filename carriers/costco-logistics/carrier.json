{
  "id": "costco-logistics",
  "displayName": "Costco Logistics",
  "aliases": [
    "Costco Wholesale Logistics",
    "Innovel Solutions",
    "Innovel"
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#b8182b"
  },
  "selectable": true,
  "timezone": "America/Chicago",
  "tracking": {
