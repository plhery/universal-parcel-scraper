    "canaryUrl": "https://logistics.costco.com/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history"
    ],
    "discarded": [
      "recipient_details",
      "event_locations",
      "scheduling_fields"
    ],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "logistics.costco.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": [
    {
      "id": "costco-logistics-1",
      "pattern": "^1I20\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{9}$",
      "confidence": "high"
    }
  ]
