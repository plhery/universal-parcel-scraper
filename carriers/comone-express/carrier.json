{
  "id": "comone-express",
  "displayName": "ComOne Express",
  "aliases": [
    "Com1 Express",
    "Com1 Logistics",
    "ComOne Int'l Logistics",
    "ComOne International Logistics",
    "商壹国际",
    "商壹国际物流",
    "商壹国际物流有限公司"
  ],
  "region": {
    "countries": [
      "CN",
      "MY",
      "SG"
    ]
  },
  "brand": {
    "color": "#29166f"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "comone-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.com1logistics.com/tracking.html?trackNo={trackingNumber}",
    "searchUrl": "https://www.com1logistics.com/tracking.html",
    "canaryUrl": "https://www.com1logistics.com/",
    "shows": [
      "status",
      "history",
      "location",
      "scan_times",
      "progress_rail"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "scan_times",
      "progress_rail",
      "provider_code",
      "destination_country",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "order_reference",
      "weight",
      "remarks",
      "driver_name",
      "proof_of_delivery",
      "signature"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "www.com1logistics.com",
        "com1logistics.com"
      ],
      "pathPattern": "^/tracking\\.html$",
      "params": [
        "trackNo"
      ]
    }
  ],
  "detection": []
}
