{
  "id": "qatar-post",
  "displayName": "Qatar Post",
  "aliases": [
    "Q-Post",
    "Qatar Postal Services Company",
    "بريد قطر"
  ],
  "region": {
    "countries": [
      "QA"
    ]
  },
  "brand": {
    "color": "#002e6d"
  },
  "selectable": true,
  "timezone": "Asia/Qatar",
  "tracking": {
    "mode": "automatic",
    "adapter": "qatar-post",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.qatarpost.qa/TrackAndTrace?trackingNumber={trackingNumber}",
    "searchUrl": "https://www.qatarpost.qa/TrackAndTrace",
    "canaryUrl": "https://www.qatarpost.qa/TrackAndTrace",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "phone_numbers",
      "postcodes",
      "proof_of_delivery",
      "payment_details"
    ],
    "unavailable": [
      "eta",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.qatarpost.qa",
        "qatarpost.qa"
      ],
      "pathPattern": "^/TrackAndTrace/?$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": []
}
