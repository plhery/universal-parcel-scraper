{
  "id": "vitran-express",
  "displayName": "Vitran Express",
  "aliases": [
    "Vitran"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#004bac"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "vitran-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "location",
    "eta",
    "weight",
    "destination_country"
  ],
  "portal": {
    "url": "https://www.vitran.com/quicktrack.aspx?p={trackingNumber}",
    "searchUrl": "https://www.vitran.com/quicktrack.aspx",
    "canaryUrl": "https://www.vitran.com/quicktrack.aspx",
    "shows": [
      "status",
      "origin",
      "destination",
      "parcel_count",
      "weight",
      "departure_date",
      "eta",
      "delivered_at"
    ],
    "scraped": [
      "status",
      "origin",
      "destination",
      "weight",
      "departure_date",
      "eta",
      "delivered_at"
    ],
    "discarded": [
      "parcel_count"
    ],
    "unavailable": [
      "history",
      "scan_times",
      "offset_timestamps",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "www.vitran.com",
        "vitran.com"
      ],
      "pathPattern": "^/quicktrack\\.aspx$",
      "params": [
        "p"
      ]
    }
  ],
  "detection": []
}
