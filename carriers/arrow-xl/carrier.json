{
  "id": "arrow-xl",
  "displayName": "ArrowXL",
  "aliases": [
    "Arrow XL",
    "AskAxl",
    "ArrowXL by JP Home"
  ],
  "region": {
    "countries": [
      "GB"
    ]
  },
  "brand": {
    "color": "#57328a"
  },
  "selectable": true,
  "timezone": "Europe/London",
  "tracking": {
    "mode": "automatic",
    "adapter": "arrow-xl",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Delivery postcode",
        "type": "text",
        "placeholder": "SW1A 1AA",
        "help": "ArrowXL shows a delivery only with its delivery postcode. Without it, other sources are asked.",
        "pattern": "^(?:[Gg][Ii][Rr]|[A-PR-UWYZa-pr-uwyz](?:[0-9][0-9A-HJKPSTUWa-hjkpstuw]?|[A-HK-Ya-hk-y][0-9][0-9ABEHMNPRVWXYabehmnprvwxy]?)) ?[0-9][ABD-HJLNP-UW-Zabd-hjlnp-uw-z]{2}$",
        "maxLength": 8,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "searchUrl": "https://askaxl.co.uk/tracking",
    "canaryUrl": "https://askaxl.co.uk/tracking",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "eta_window",
      "progress_rail",
      "driver_name",
      "coordinates"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "eta_window",
      "progress_rail",
      "driver_name",
      "coordinates"
    ],
    "unavailable": [
      "weight",
      "delivered_at",
      "offset_timestamps",
      "service_name",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "askaxl.co.uk"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "upi"
      ]
    },
    {
      "domains": [
        "arrowxl.co.uk"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "upi"
      ]
    },
    {
      "domains": [
        "askaxl.co.uk"
      ],
      "path": "^/trk/([^/?#]+)/[^/?#]+/?$"
    }
  ],
  "detection": []
}
