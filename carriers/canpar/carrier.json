{
  "id": "canpar",
  "displayName": "Canpar",
  "aliases": [],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#003b70"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "canpar",
    "requirements": [
      {
        "field": "postcode",
        "whenTrackingNumber": "^[CDKLSUXZ][0-9]{8,20}$",
        "validator": "internationalPostcode",
        "optional": true,
        "label": "Destination postal code",
        "type": "text",
        "placeholder": "A1A 1A1",
        "help": "Optional. Canpar finds some shorter barcodes only with their destination postal code.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 780
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "service_name"
  ],
  "portal": {
    "url": "https://www.canpar.com/en/tracking/track.htm?barcode={trackingNumber}",
    "searchUrl": "https://www.canpar.com/en/tracking/track.htm",
    "canaryUrl": "https://www.canpar.com/en/tracking/track.htm",
    "shows": [
      "status",
      "history",
      "location",
      "estimated_delivery",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "estimated_delivery",
      "service_name"
    ],
    "discarded": [
      "proof_of_delivery",
      "recipient",
      "addresses",
      "comments",
      "contacts",
      "references"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "canpar.com"
      ],
      "params": [
        "barcode",
        "reference"
      ]
    }
  ],
  "detection": [
    {
      "id": "canpar-1",
      "pattern": "^[CDKLSUXZ]\\d{21}$",
      "confidence": "high"
    }
  ]
}
