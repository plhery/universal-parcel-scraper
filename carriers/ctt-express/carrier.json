      "estimated_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "estimated_delivery",
      "weight",
      "delivery_partner"
    ],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "shipping-tracking.production.cloud2.cttexpress.com"
      ],
      "params": [
        "sc"
      ]
    }
  ],
  "detection": [
    {
      "id": "ctt-express-3",
      "pattern": "^00001000\\d{14}$",
