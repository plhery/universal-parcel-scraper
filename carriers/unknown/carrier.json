{
  "id": "unknown",
  "displayName": "Unknown carrier",
  "displayNames": {
    "en": "Unknown carrier",
    "de": "Paketdienst unbekannt",
    "fr": "Transporteur inconnu",
    "it": "Corriere sconosciuto",
    "es": "Transportista desconocido",
    "pt": "Transportadora desconhecida",
    "pl": "Nieznany przewoźnik"
  },
  "aliases": [],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#8e8e93"
  },
  "selectable": false,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "universal",
    "steps": []
  },
  "capabilities": [],
  "portal": {
    "url": "https://t.17track.net/en#nums={trackingNumber}",
    "searchUrl": "https://t.17track.net/en",
    "siteName": "17TRACK",
    "canaryUrl": "https://parcelsapp.com/en",
    "shows": [],
    "scraped": [],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "17track.net"
      ],
      "params": [
        "nums"
      ],
      "fragment": "(?:^|&)nums=([^&]+)",
      "detectFromNumber": true
    },
    {
      "domains": [
        "parcelsapp.com"
      ],
      "path": "^/(?:[a-z]{2}/)?tracking/([^/?#]+)",
      "detectFromNumber": true
    },
    {
      "domains": [
        "dpdgroup.com",
        "dpd.com"
      ],
      "params": [
        "parcelNumber",
        "parcelnumber"
      ],
      "detectFromNumber": true
    },
    {
      "domains": [
        "delivery-status.com",
        "prtl.parcellab.com"
      ],
      "params": [
        "trackingNo",
        "tno"
      ],
      "detectFromNumber": true
    },
    {
      "domains": [
        "narvar.com"
      ],
      "params": [
        "tracking_numbers"
      ],
      "pathPattern": "/tracking(?:/|$)",
      "detectFromNumber": true
    },
    {
      "domains": [
        "aftership.com"
      ],
      "params": [
        "tracking-numbers",
        "t"
      ],
      "path": "^/(?:track/)?(?:[A-Za-z0-9-]+/)?([A-Za-z0-9]*[0-9][A-Za-z0-9]*)/?$",
      "detectFromNumber": true
    },
    {
      "domains": [
        "sendcloud.sc"
      ],
      "params": [
        "code"
      ],
      "pathPattern": "^/forward/?$",
      "detectFromNumber": true
    },
    {
      "domains": [
        "shipping-portal.com"
      ],
      "params": [
        "tracking_number"
      ],
      "pathPattern": "^/tracking/?$",
      "detectFromNumber": true
    }
  ],
  "detection": []
}
