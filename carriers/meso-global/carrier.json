{
  "id": "meso-global",
  "displayName": "Meso-global",
  "aliases": [
    "Meso Global",
    "中际跨境",
    "深圳市中际跨境供应链有限公司"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#3b73e3"
  },
  "selectable": true,
  "timezone": "Asia/Shanghai",
  "tracking": {
    "mode": "automatic",
    "adapter": "meso-global",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "service_name",
    "destination_country",
    "canonical_tracking_number",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "canaryUrl": "https://t.17track.net/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "service_name",
      "destination_country",
      "canonical_tracking_number",
      "delivery_partner",
      "delivery_tracking_number",
      "parcel_count",
      "weight",
      "customer_reference",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "signatory",
      "signature",
      "proof_of_delivery",
      "payment_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "service_name",
      "destination_country",
      "canonical_tracking_number",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "parcel_count",
      "weight",
      "customer_reference",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "postcodes",
      "signatory",
      "signature",
      "proof_of_delivery",
      "payment_details"
    ],
    "unavailable": [
      "eta",
      "delivered_at",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "mesoglobal.cc"
      ],
      "pathPattern": "^/(?:en/)?trackIndex\\.htm$",
      "params": [
        "documentCode"
      ]
    }
  ],
  "detection": []
}
