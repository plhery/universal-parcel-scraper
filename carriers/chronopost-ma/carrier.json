{
  "id": "chronopost-ma",
  "displayName": "Chronopost Maroc",
  "aliases": [
    "Chronopost Morocco",
    "Chronopost International Maroc"
  ],
  "region": {
    "countries": [
      "MA"
    ]
  },
  "brand": {
    "color": "#0099e0"
  },
  "selectable": true,
  "timezone": "Africa/Casablanca",
  "tracking": {
    "mode": "automatic",
    "adapter": "chronopost-ma",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://chronopost.ma/suivez-votre-envoi?SendingNumber={trackingNumber}",
    "searchUrl": "https://chronopost.ma/suivez-votre-envoi",
    "helpUrl": "https://chronopost.ma/service-clients",
    "canaryUrl": "https://chronopost.ma/suivez-votre-envoi",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "canonical_tracking_number",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "origin",
      "destination",
      "canonical_tracking_number",
      "parcel_count"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "sender_name",
      "recipient_name",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "chronopost.ma",
        "www.chronopost.ma"
      ],
      "pathPattern": "^/suivez-votre-envoi/?$",
      "params": [
        "SendingNumber"
      ]
    }
  ],
  "detection": []
}
