{
  "id": "edi-express",
  "displayName": "EDI Express",
  "aliases": [
    "EDI Express Inc",
    "EDI Express Inc.",
    "EDI Express, Inc."
  ],
  "region": {
    "countries": [
      "US"
    ]
  },
  "brand": {
    "color": "#bf1e2d"
  },
  "selectable": true,
  "timezone": "America/Los_Angeles",
  "tracking": {
    "mode": "automatic",
    "adapter": "edi-express",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true,
    "dateOnlyScans": true
  },
  "capabilities": [
    "eta",
    "weight",
    "destination_country",
    "receiver_address"
  ],
  "portal": {
    "url": "https://my.ediexpressinc.com/prodetail.asp?proNum={trackingNumber}",
    "searchUrl": "https://my.ediexpressinc.com/pro_pu_trace.asp",
    "helpUrl": "https://www.ediexpressinc.com/contact-us",
    "canaryUrl": "https://my.ediexpressinc.com/pro_pu_trace.asp",
    "shows": [
      "status",
      "departure_date",
      "eta",
      "delivered_at",
      "weight",
      "parcel_count",
      "order_contents",
      "payment_details",
      "customer_reference",
      "origin",
      "destination",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "departure_date",
      "eta",
      "weight",
      "destination",
      "recipient_address"
    ],
    "discarded": [
      "delivered_at",
      "parcel_count",
      "order_contents",
      "payment_details",
      "customer_reference",
      "origin"
    ],
    "unavailable": [
      "history",
      "location",
      "offset_timestamps",
      "sender_name",
      "recipient_name",
      "proof_of_delivery",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "ediexpressinc.com"
      ],
      "pathPattern": "^/prodetail\\.asp$",
      "params": [
        "proNum"
      ]
    }
  ],
  "detection": []
}
