      "weight",
      "remarks",
      "failed_delivery_reason",
      "office_contact_details",
      "coordinates",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "delivered_at",
      "service_name"
    ],
    "discarded": [
      "progress_rail",
      "origin",
      "destination",
      "recipient_name",
