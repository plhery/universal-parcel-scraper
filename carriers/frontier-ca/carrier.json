{
  "id": "frontier-ca",
  "displayName": "Frontier Courier",
  "aliases": [
    "Frontier",
    "Frontier Supply Chain Solutions",
    "Frontier SCS",
    "Frontier Same Day",
    "Frontier Saskatchewan",
    "FrontShip"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#e56119"
  },
  "selectable": true,
  "timezone": "America/Winnipeg",
  "tracking": {
    "mode": "automatic",
    "adapter": "frontier-ca",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://tracking.carrierlogistics.com/scripts/fscf.pol/boldetail.htm?wbtn=PRO&wpro1={trackingNumber}",
    "searchUrl": "https://tracking.carrierlogistics.com/scripts/fscf.pol/facts.htm",
    "canaryUrl": "https://www.frontiercourier.com/",
    "shows": [
      "status",
      "history",
      "provider_code"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code"
    ],
    "discarded": [
      "recipient",
      "contact",
      "address",
      "references",
      "proof"
    ],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "tracking.carrierlogistics.com"
      ],
      "pathPattern": "^/scripts/fscf\\.pol/boldetail\\.htm$",
      "params": [
        "wpro1"
      ]
    },
    {
      "domains": [
        "tracking.carrierlogistics.com"
      ],
      "pathPattern": "^/scripts/fscf\\.pol/facts\\.htm$",
      "params": [
        "pronum"
      ]
    }
  ],
  "detection": []
}
