{
  "id": "peddler",
  "displayName": "Peddler",
  "aliases": [
    "Peddler Express",
    "Peddler B.V."
  ],
  "region": {
    "countries": [
      "NL"
    ]
  },
  "brand": {
    "color": "#34205A"
  },
  "selectable": true,
  "timezone": "Europe/Amsterdam",
  "tracking": {
    "mode": "automatic",
    "adapter": "peddler",
    "steps": [
      "trawl"
    ],
    "browser": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "delivered_at",
    "eta",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://track.pdlr.nl/trackntrace/{trackingNumber}",
    "searchUrl": "https://track.pdlr.nl/",
    "canaryUrl": "https://track.pdlr.nl/",
    "shows": [
      "status",
      "history",
      "eta",
      "eta_window",
      "offset_timestamps",
      "delivered_at",
      "recipient_address",
      "driver_name",
      "remarks"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "offset_timestamps",
      "delivered_at",
      "remarks"
    ],
    "discarded": [
      "eta_window",
      "recipient_address",
      "driver_name"
    ],
    "unavailable": [
      "location",
      "weight",
      "sender_name",
      "recipient_name",
      "signatory",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "track.pdlr.nl"
      ],
      "path": "^/trackntrace/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "peddler-1",
      "pattern": "^P\\d{18}$",
      "confidence": "high"
    },
    {
      "id": "peddler-2",
      "pattern": "^NLEXP\\d{10}INTPED$",
      "confidence": "high"
    }
  ]
}
