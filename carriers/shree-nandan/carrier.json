{
  "id": "shree-nandan",
  "displayName": "Shree Nandan Courier",
  "aliases": [
    "Shree Nandan Courier Limited",
    "Nandan Courier",
    "Connecting Nandan"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#ed008c"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "shree-nandan",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "service_name",
    "receiver_name",
    "receiver_address"
  ],
  "portal": {
    "url": "https://connectingnandan.com/web-tracking/{trackingNumber}",
    "searchUrl": "https://www.shreenandancourier.com/",
    "helpUrl": "https://www.shreenandancourier.com/contact-us",
    "canaryUrl": "https://www.shreenandancourier.com/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "service_name",
      "recipient_name",
      "delivery_date",
      "proof_of_delivery",
      "office_contact_details"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "destination",
      "service_name",
      "recipient_name",
      "delivery_date"
    ],
    "discarded": [
      "origin",
      "proof_of_delivery",
      "office_contact_details"
    ],
    "unavailable": [
      "eta",
      "weight",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "shreenandancourier.com"
      ],
      "pathPattern": "^/trackinginfo\\.aspx$",
      "params": [
        "cn"
      ]
    },
    {
      "domains": [
        "connectingnandan.com"
      ],
      "path": "^/web-tracking/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
