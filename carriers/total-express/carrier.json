{
  "id": "total-express",
  "displayName": "Total Express",
  "aliases": [
    "Total Express Tex Courier",
    "TEX Courier",
    "Total Express Brasil"
  ],
  "region": {
    "countries": [
      "BR"
    ]
  },
  "brand": {
    "color": "#e11e25"
  },
  "selectable": true,
  "timezone": "America/Sao_Paulo",
  "tracking": {
    "mode": "automatic",
    "adapter": "total-express",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 975
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "provider_code",
    "eta",
    "sender_name",
    "pickup_point",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://totalconecta.totalexpress.com.br/rastreamento?codigo={trackingNumber}",
    "searchUrl": "https://totalconecta.totalexpress.com.br/rastreamento",
    "canaryUrl": "https://totalconecta.totalexpress.com.br/rastreamento",
    "shows": [
      "status",
      "history",
      "progress_rail",
      "eta",
      "sender_name",
      "order_reference",
      "invoice_reference",
      "pickup_point",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "eta",
      "sender_name",
      "pickup_point",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "progress_rail",
      "order_reference",
      "invoice_reference"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name",
      "offset_timestamps",
      "recipient_name",
      "recipient_address",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "totalconecta.totalexpress.com.br"
      ],
      "path": "^/rastreamento/rastreamento/encomendas/([^/?#]+)/?$"
    },
    {
      "domains": [
        "totalconecta.totalexpress.com.br"
      ],
      "pathPattern": "^/rastreamento/?$",
      "params": [
        "codigo"
      ],
      "ownNumbersOnly": true
    }
  ],
  "detection": [
    {
      "id": "total-express-awb",
      "pattern": "^(?:TX[A-Z]{2}|AMZB)\\d{9}TX$",
      "confidence": "high"
    },
    {
      "id": "total-express-client",
      "pattern": "^[A-Z]{4}\\d{9}TX$",
      "confidence": "low"
    }
  ]
}
