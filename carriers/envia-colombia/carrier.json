{
  "id": "envia-colombia",
  "displayName": "Envía",
  "aliases": [
    "Envía Colvanes",
    "Colvanes",
    "Envia Colombia"
  ],
  "region": {
    "countries": [
      "CO"
    ]
  },
  "brand": {
    "color": "#ba0020"
  },
  "selectable": true,
  "timezone": "America/Bogota",
  "tracking": {
    "mode": "automatic",
    "adapter": "envia-colombia",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 912
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at",
    "eta",
    "service_name",
    "offset_timestamps"
  ],
  "portal": {
    "url": "https://envia.co/rastreo/?guia={trackingNumber}",
    "searchUrl": "https://envia.co/rastreo/",
    "canaryUrl": "https://envia.co/rastreo/",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination",
      "eta",
      "service_name",
      "delivered_at",
      "progress_rail",
      "contact_details",
      "payment_details",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "eta",
      "service_name",
      "offset_timestamps"
    ],
    "discarded": [
      "origin",
      "destination",
      "progress_rail",
      "contact_details",
      "payment_details",
      "proof_of_delivery"
    ],
    "unavailable": [
      "weight",
      "dimensions",
      "pickup_point",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "envia.co"
      ],
      "pathPattern": "^/(?:rastreo|tracking)/?$",
      "params": [
        "guia"
      ]
    },
    {
      "domains": [
        "portal.envia.co"
      ],
      "pathPattern": "^/OnLineRastreo(/Rastreo/Rastreo|/Consulta/Index)?/?$",
      "params": [
        "Guia"
      ]
    },
    {
      "domains": [
        "enviacolvanes.com.co"
      ],
      "pathPattern": "^/Contenido\\.aspx$",
      "params": [
        "rastreo"
      ]
    }
  ],
  "detection": []
}
