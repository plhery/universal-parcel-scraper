      "delivery_partner"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "event_details",
      "signature",
      "recipient_address",
      "eta_window",
      "coordinates"
    ],
    "unavailable": [
      "location",
      "weight",
      "service_name"
    ]
