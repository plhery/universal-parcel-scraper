{
  "id": "intime-hr",
  "displayName": "In Time Croatia",
  "aliases": [
    "IN TIME d.o.o.",
    "Intime Express"
  ],
  "region": {
    "countries": [
      "HR"
    ]
  },
  "brand": {
    "color": "#00999b"
  },
  "selectable": true,
  "timezone": "Europe/Zagreb",
  "tracking": {
    "mode": "automatic",
    "adapter": "intime-hr",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.in-time.hr/pracenje?id={trackingNumber}",
    "searchUrl": "https://www.in-time.hr/pracenje",
    "helpUrl": "https://www.in-time.hr/podrska",
    "canaryUrl": "https://www.in-time.hr/pracenje",
    "shows": [
      "status",
      "history",
      "location",
      "origin",
      "destination"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "destination_country"
    ],
    "discarded": [
      "origin",
      "destination"
    ],
    "unavailable": [
      "offset_timestamps",
      "eta",
      "signatory"
    ]
  },
  "links": [
    {
      "domains": [
        "in-time.hr",
        "www.in-time.hr"
      ],
      "pathPattern": "^/pracenje/?$",
      "params": [
        "id"
      ]
    }
  ],
  "detection": []
}
