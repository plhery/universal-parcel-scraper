{
  "id": "phantom-couriers",
  "displayName": "Phantom Couriers",
  "aliases": [
    "Phantom Courier",
    "Phantom Couriers Ltd."
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#ff5c00"
  },
  "selectable": true,
  "timezone": "America/Vancouver",
  "tracking": {
    "mode": "automatic",
    "adapter": "phantom-couriers",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "url": "https://portal.courie.ai/phantom/trackshipment?trackingNumber={trackingNumber}",
    "searchUrl": "https://portal.courie.ai/phantom/trackshipment",
    "helpUrl": "https://phantomcouriers.com/contact/",
    "siteName": "Courie",
    "canaryUrl": "https://portal.courie.ai/phantom/trackshipment",
    "shows": [
      "status",
      "delivered_at",
      "eta",
      "driver",
      "map",
      "addresses",
      "signatory",
      "proof_of_delivery"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "eta",
      "driver",
      "map",
      "addresses",
      "signatory",
      "proof_of_delivery"
    ],
    "unavailable": [
      "scan_history",
      "weight",
      "service_name"
    ]
  },
  "links": [
    {
      "domains": [
        "portal.courie.ai"
      ],
      "pathPattern": "^/phantom/trackshipment/?$",
      "params": [
        "trackingNumber"
      ]
    }
  ],
  "detection": []
}
