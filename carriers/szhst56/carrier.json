      "history",
      "location"
    ],
    "discarded": [
      "destination",
      "parcel_count",
      "recipient_name"
    ],
    "unavailable": [
      "weight",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "www.szhst56.com",
        "szhst56.com"
      ],
      "pathPattern": "^/tracking\\.php$",
      "query": "^(?:.*&)?s=([A-Za-z0-9]{5,30})(?=&|$)"
    }
  ],
  "detection": []
