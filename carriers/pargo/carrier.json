    "helpUrl": "https://pargo.co.za/faq/"
  },
  "links": [
    {
      "domains": [
        "track.pargo.co.za"
      ],
      "pathPattern": "^/?$",
      "params": [
        "code"
      ]
    },
    {
      "domains": [
        "pargo.co.za"
      ],
      "pathPattern": "^/track-trace/?$",
      "params": [
        "code",
        "track-trace"
      ]
    },
    {
      "domains": [
        "pargo.co.za"
      ],
      "pathPattern": "^/scripts/track_and_trace\\.php$",
      "params": [
        "trackingCode"
      ]
    },
    {
      "domains": [
        "api.pargo.co.za"
      ],
      "pathPattern": "^/track-trace\\.php$",
      "params": [
        "waybill"
      ]
    }
  ],
  "detection": [
    {
      "id": "pargo-1",
