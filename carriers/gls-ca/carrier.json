{
  "id": "gls-ca",
  "displayName": "GLS Canada",
  "aliases": [
    "Dicom",
    "Dicom Transportation Group"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#ffdd00"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "gls-ca",
    "steps": [
      "direct"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://gls-group.com/CA/en/send-and-receive/track-a-shipment/?match={trackingNumber}",
    "searchUrl": "https://gls-group.com/CA/en/send-and-receive/track-a-shipment/",
    "canaryUrl": "https://gls-group.com/CA/en/send-and-receive/track-a-shipment/",
    "shows": [
      "status",
      "history",
      "location",
      "service_name",
      "weight_kg"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "service_name"
    ],
    "discarded": [
      "weight_kg"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "gls-group.com",
        "gls-group.eu"
      ],
      "pathPattern": "^/CA/",
      "params": [
        "match"
      ]
    }
  ],
  "detection": []
}
