{
  "id": "mondial-relay",
  "displayName": "Mondial Relay",
  "aliases": [],
  "region": {
    "countries": [
      "FR",
      "BE",
      "ES",
      "LU",
      "PT"
    ]
  },
  "brand": {
    "color": "#ef3026"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "mondial-relay",
    "requirements": [
      {
        "field": "postcode",
        "whenTrackingNumber": "^[0-9]{8}$",
        "validator": "internationalPostcode",
        "label": "Delivery postcode",
        "type": "text",
        "help": "8-digit Mondial Relay shipment numbers require the recipient postcode; longer numbers and label barcodes do not.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "app",
      "trawl"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://www.mondialrelay.fr/suivi-de-colis/?numeroExpedition={trackingNumber}",
    "canaryUrl": "https://www.mondialrelay.fr/suivi-de-colis/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "pickup_point",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "pickup_point",
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "mondialrelay.fr"
      ],
      "params": [
        "shipment",
        "numeroExpedition",
        "numero",
        "trackingNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "mondial-relay-1",
      "pattern": "^[0-9]{26}$",
      "confidence": "high",
      "checksum": "mondial-relay"
    },
    {
      "id": "mondial-relay-2",
      "pattern": "^(?:\\d{8}|\\d{10}|\\d{12})$",
      "confidence": "low"
    }
  ]
}
