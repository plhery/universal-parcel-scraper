{
  "id": "postmedia-parcel-services",
  "displayName": "Postmedia Parcel Services",
  "aliases": [
    "BNI",
    "BNICA",
    "Brunswick News",
    "Brunswick News Inc.",
    "Bonshaw Logistics"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#ffd100"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "postmedia-parcel-services",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "label": "Delivery postal code",
        "type": "text",
        "help": "Postmedia Parcel Services shows a parcel only with the recipient's postal code.",
        "pattern": "^[A-Za-z][0-9][A-Za-z] ?[0-9][A-Za-z][0-9]$",
        "maxLength": 7,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "delivered_at",
    "eta"
  ],
  "portal": {
    "searchUrl": "https://postmediaparcelservices.com/",
    "canaryUrl": "https://postmediaparcelservices.com/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "order_date",
      "pickup_point"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "delivered_at",
      "offset_timestamps"
    ],
    "discarded": [
      "order_date",
      "pickup_point"
    ],
    "unavailable": [
      "provider_code",
      "weight",
      "service_name",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "signatory",
      "proof_of_delivery",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "postmediaparcelservices.com",
        "www.postmediaparcelservices.com"
      ],
      "pathPattern": "^/(?:fr/?)?(?:track-your-shipment/?)?$",
      "params": [
        "bniTrackingID"
      ]
    }
  ],
  "detection": []
}
