{
  "id": "cargox",
  "displayName": "Cargo X",
  "aliases": [
    "CargoX",
    "CargoX Kargo Taşımacılık A.Ş."
  ],
  "region": {
    "countries": [
      "TR"
    ]
  },
  "brand": {
    "color": "#fbe900"
  },
  "selectable": true,
  "timezone": "Europe/Istanbul",
  "tracking": {
    "mode": "automatic",
    "adapter": "cargox",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://t.cargox.com.tr/getlink.php?barcode={trackingNumber}",
    "searchUrl": "https://www.cargox.com.tr/",
    "canaryUrl": "https://www.cargox.com.tr/",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivered_at"
    ],
    "discarded": [
      "parcel_count"
    ],
    "unavailable": [
      "offset_timestamps",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "t.cargox.com.tr"
      ],
      "pathPattern": "^/getlink\\.php$",
      "params": [
        "barcode"
      ]
    }
  ],
  "detection": []
}
