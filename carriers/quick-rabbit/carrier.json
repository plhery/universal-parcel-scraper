{
  "id": "quick-rabbit",
  "displayName": "Quick Rabbit",
  "aliases": [
    "Quick Rabbit Logistic"
  ],
  "region": {
    "countries": [
      "ES"
    ]
  },
  "brand": {
    "color": "#f6851f"
  },
  "selectable": true,
  "timezone": "Europe/Madrid",
  "tracking": {
    "mode": "automatic",
    "adapter": "quick-rabbit",
    "steps": [
      "direct",
      "retry"
    ],
    "recognition": {
      "rank": 68
    }
  },
  "capabilities": [
    "history",
    "offset_timestamps",
    "delivered_at",
    "provider_code",
    "canonical_tracking_number"
  ],
  "portal": {
    "url": "https://web.quickrabbit.es/es/tracking?ref={trackingNumber}",
    "searchUrl": "https://web.quickrabbit.es/es/tracking",
    "canaryUrl": "https://web.quickrabbit.es/es/tracking",
    "shows": [
      "status",
      "history",
      "offset_timestamps",
      "eta",
      "destination",
      "customer_reference",
      "location"
    ],
    "scraped": [
      "status",
      "history",
      "offset_timestamps",
      "provider_code"
    ],
    "discarded": [
      "eta",
      "destination",
      "customer_reference",
      "location"
    ],
    "unavailable": [
      "weight",
      "service_name",
      "signature",
      "proof_of_delivery",
      "delivery_partner"
    ]
  },
  "links": [
    {
      "domains": [
        "web.quickrabbit.es",
        "quickrabbit.es"
      ],
      "pathPattern": "^/(?:[a-z]{2}/)?tracking/?$",
      "params": [
        "ref"
      ]
    }
  ],
  "detection": [
    {
      "id": "quick-rabbit-1",
      "pattern": "^PKG\\d{3}20\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{9}$",
      "confidence": "high"
    },
    {
      "id": "quick-rabbit-2",
      "pattern": "^PKG\\d{5}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])ES\\d{13}[A-Z]$",
      "confidence": "low"
    },
    {
      "id": "quick-rabbit-3",
      "pattern": "^WT\\d{16}$",
      "confidence": "low"
    }
  ]
}
