{
  "id": "cargus",
  "displayName": "Cargus",
  "aliases": [
    "Urgent Cargus",
    "Cargus International",
    "Cargus SRL"
  ],
  "region": {
    "countries": [
      "RO"
    ]
  },
  "brand": {
    "color": "#f68121"
  },
  "selectable": true,
  "timezone": "Europe/Bucharest",
  "tracking": {
    "mode": "automatic",
    "adapter": "cargus",
    "steps": [
      "direct"
    ],
    "localClocks": true,
    "recognition": {
      "rank": 270,
      "servedCountriesOnly": true
    }
  },
  "capabilities": [
    "history",
    "location"
  ],
  "portal": {
    "url": "https://www.cargus.ro/personal/urmareste-coletul/?tracking_number={trackingNumber}",
    "searchUrl": "https://www.cargus.ro/personal/urmareste-coletul/",
    "canaryUrl": "https://www.cargus.ro/personal/urmareste-coletul/",
    "shows": [
      "status",
      "history",
      "location",
      "signatory",
      "delivery_pin",
      "customer_reference",
      "parcel_count"
    ],
    "scraped": [
      "status",
      "history",
      "location"
    ],
    "discarded": [
      "signatory",
      "delivery_pin",
      "customer_reference",
      "parcel_count"
    ],
    "unavailable": [
      "eta",
      "provider_code",
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "cargus.ro"
      ],
      "pathPattern": "^/(?:personal/urmareste-coletul|en/personal/track-your-parcel)/?$",
      "params": [
        "tracking_number"
      ]
    },
    {
      "domains": [
        "cargus.ro"
      ],
      "pathPattern": "^/tracking-romanian/?$",
      "params": [
        "t"
      ]
    }
  ],
  "detection": [
    {
      "id": "cargus-1",
      "pattern": "^1\\d{9}$",
      "confidence": "low"
    },
    {
      "id": "cargus-2",
      "pattern": "^8[56]\\d{7}$",
      "confidence": "low"
    }
  ]
}
