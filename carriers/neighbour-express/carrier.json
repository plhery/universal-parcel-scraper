{
  "id": "neighbour-express",
  "displayName": "Neighbour Express",
  "aliases": [
    "NeighbourExpress"
  ],
  "region": {
    "countries": [
      "CA"
    ]
  },
  "brand": {
    "color": "#254b8d"
  },
  "selectable": true,
  "timezone": "America/Toronto",
  "tracking": {
    "mode": "automatic",
    "adapter": "neighbour-express",
    "steps": [
      "trawl"
    ],
    "browser": true
  },
  "capabilities": [
    "history"
  ],
  "portal": {
    "url": "https://neighbourexpress.com/track?no={trackingNumber}",
    "searchUrl": "https://neighbourexpress.com/track",
    "canaryUrl": "https://neighbourexpress.com/track",
    "shows": [
      "Return tracking reference",
      "Shipment milestones",
      "Scan clocks and offsets"
    ],
    "scraped": [
      "Return tracking reference",
      "Shipment milestones",
      "Scan clocks and offsets"
    ],
    "discarded": [
      "Recipient details",
      "Free-form notes",
      "Verification state"
    ],
    "unavailable": [
      "Expected delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "neighbourexpress.com",
        "neighbourexpress.ca"
      ],
      "pathPattern": "^/track/?$",
      "params": [
        "trackingNumber",
        "no"
      ]
    }
  ],
  "detection": []
}
