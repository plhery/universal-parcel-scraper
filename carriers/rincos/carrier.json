{
  "id": "rincos",
  "displayName": "Rincos",
  "aliases": [
    "RINCOS",
    "RINCOS Co., Ltd.",
    "린코스",
    "주식회사 린코스"
  ],
  "region": {
    "countries": [
      "KR"
    ]
  },
  "brand": {
    "color": "#f37022"
  },
  "selectable": true,
  "timezone": "Asia/Seoul",
  "tracking": {
    "mode": "automatic",
    "adapter": "rincos",
    "steps": [
      "direct",
      "retry"
    ],
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "destination_country",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.rincos.asia/out/TraceInfo_kr.do?SCGBN=20&P_VAL={trackingNumber}",
    "searchUrl": "https://www.rincos.co.kr/tracking/tracking?lang=en",
    "canaryUrl": "https://www.rincos.co.kr/",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number",
      "destination_country",
      "sender_name",
      "receiver_name"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivery_partner",
      "delivery_tracking_number",
      "destination_country"
    ],
    "discarded": [
      "sender_name",
      "receiver_name"
    ],
    "unavailable": [
      "eta",
      "weight",
      "service_name",
      "provider_code"
    ]
  },
  "links": [
    {
      "domains": [
        "www.rincos.asia",
        "rincos.asia"
      ],
      "pathPattern": "^/out/TraceInfo_(?:kr|en|jp|cn)\\.do$",
      "params": [
        "P_VAL"
      ]
    }
  ],
  "detection": []
}
