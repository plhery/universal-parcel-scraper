{
  "id": "xindus",
  "displayName": "Xindus",
  "aliases": [
    "Xindus Trade Networks"
  ],
  "region": {
    "countries": [
      "IN"
    ]
  },
  "brand": {
    "color": "#1262af"
  },
  "selectable": true,
  "timezone": "Asia/Kolkata",
  "tracking": {
    "mode": "automatic",
    "adapter": "xindus",
    "steps": [
      "direct",
      "retry"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "offset_timestamps",
    "delivered_at",
    "delivery_partner",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.xindus.net/tracking?awb={trackingNumber}",
    "searchUrl": "https://www.xindus.net/tracking",
    "canaryUrl": "https://www.xindus.net/tracking",
    "shows": [
      "status",
      "history",
      "eta",
      "origin",
      "destination",
      "parcel_count",
      "progress_rail",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "delivery_partner",
      "delivery_tracking_number"
    ],
    "discarded": [
      "eta",
      "origin",
      "destination",
      "parcel_count",
      "progress_rail"
    ],
    "unavailable": [
      "sender_name",
      "recipient_name",
      "recipient_address",
      "weight",
      "proof_of_delivery"
    ]
  },
  "links": [
    {
      "domains": [
        "xindus.net",
        "www.xindus.net"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "awb"
      ]
    }
  ],
  "detection": []
}
