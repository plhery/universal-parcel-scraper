{
  "id": "dsv",
  "displayName": "DSV",
  "aliases": [
    "DB Schenker",
    "Schenker",
    "DSV Road",
    "DSV Schenker",
    "DB Schenker Logistics"
  ],
  "region": {
    "countries": [
      "DK",
      "DE",
      "SE",
      "PL"
    ]
  },
  "brand": {
    "color": "#002664"
  },
  "selectable": true,
  "timezone": "Europe/Copenhagen",
  "tracking": {
    "mode": "automatic",
    "adapter": "dsv",
    "steps": [
      "direct",
      "retry",
      "schenker"
    ],
    "recognition": {
      "rank": 436
    },
    "localClocks": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "eta"
  ],
  "portal": {
    "url": "https://mydsv.com/track-shipment?query={trackingNumber}",
    "searchUrl": "https://mydsv.com/track-shipment",
    "canaryUrl": "https://mydsv.com/track-shipment",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "progress_rail",
      "service_name",
      "sender_town",
      "recipient_address",
      "postcodes"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "provider_code"
    ],
    "discarded": [
      "progress_rail",
      "service_name",
      "sender_town",
      "recipient_address",
      "postcodes"
    ],
    "unavailable": [
      "offset_timestamps"
    ]
  },
  "links": [
    {
      "domains": [
        "mydsv.com"
      ],
      "pathPattern": "^/(?:new/tracking/)?track-shipment/?$",
      "params": [
        "query"
      ]
    },
    {
      "domains": [
        "www.dsv.com",
        "mydsv.dsv.com"
      ],
      "pathPattern": "^/(?:mydsv|app)/tracking-public/?$",
      "params": [
        "refNumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "dsv-stt",
      "pattern": "^(?:AL|AT|BA|BE|BG|CH|CY|CZ|DE|DK|EE|ES|FI|FR|GB|GR|HR|HU|IE|IS|IT|LI|LT|LU|LV|MD|ME|MK|MT|NL|NO|PL|PT|RO|RS|SE|SI|SK|TR|UA)[A-Z]{3}\\d{9}$",
      "confidence": "low"
    }
  ]
}
