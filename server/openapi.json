{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Parcel Scraper",
    "version": "0.8.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/carriers": {
      "get": {
        "operationId": "carriers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/detect": {
      "post": {
        "operationId": "detect",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 16384
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/recognize": {
      "post": {
        "operationId": "recognize",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recognition"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          },
          "502": {
            "description": "No enabled source answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string"
                  },
                  "budgetMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120000
                  }
                },
                "required": [
                  "number"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/track": {
      "post": {
        "operationId": "track",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No enabled source knows the parcel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before repeating the request. After a failed lookup: until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          },
          "502": {
            "description": "No enabled source answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParcelInput"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ParcelInput": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "minLength": 4,
            "maxLength": 80
          },
          "carrier": {
            "type": "string"
          },
          "postcode": {
            "type": [
              "string",
              "null"
            ]
          },
          "trackingUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "countryHint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Country code or English name used only to retry an empty universal lookup."
          }
        },
        "required": [
          "number"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "Detection": {
        "type": "object",
        "required": [
          "trackingNumber",
          "carrier",
          "confidence",
          "candidates",
          "source"
        ],
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "low",
              "none"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "number",
              "link",
              "text",
              "none"
            ]
          },
          "trackingUrl": {
            "type": "string"
          }
        }
      },
      "Recognition": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unanswered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "choices",
          "asked",
          "unanswered"
        ],
        "additionalProperties": false
      },
      "TrackingResponse": {
        "type": "object",
        "required": [
          "carrier",
          "source",
          "result",
          "attempts"
        ],
        "properties": {
          "carrier": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/CarrierResult"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "handoff": {
            "type": "object"
          }
        }
      },
      "CarrierResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "current_stage": {
            "type": "string"
          },
          "current_stage_source": {
            "type": "string"
          },
          "last_status_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_update": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_delivery": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "stage_source",
                "instant"
              ],
              "properties": {
                "time": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "stage_source": {
                  "type": "string"
                },
                "instant": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "Attempt": {
        "type": "object",
        "required": [
          "source",
          "kind",
          "durationMs"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ok",
              "not_found",
              "indeterminate",
              "challenge",
              "rate_limited",
              "maintenance",
              "schema",
              "input_required",
              "invalid_input",
              "transport",
              "budget"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "FailureHint": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "not_found",
              "indeterminate",
              "challenge",
              "rate_limited",
              "maintenance",
              "schema",
              "input_required",
              "invalid_input",
              "transport",
              "budget"
            ],
            "description": "What failed; `invalid_input` and `not_found` are answers, not outages."
          },
          "retryAfterMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Milliseconds to wait before repeating the request; what `Retry-After` says in seconds."
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "The input a carrier still needs."
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "hint": {
            "$ref": "#/components/schemas/FailureHint"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
