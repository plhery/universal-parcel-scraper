{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Parcel Scraper",
    "version": "0.1080.1"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/carriers": {
      "get": {
        "operationId": "carriers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/detect": {
      "post": {
        "operationId": "detect",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 16384
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/recognize": {
      "post": {
        "operationId": "recognize",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recognition"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          },
          "502": {
            "description": "No enabled source answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string"
                  },
                  "budgetMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120000
                  }
                },
                "required": [
                  "number"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/track": {
      "post": {
        "operationId": "track",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, or an input a source requires, named in field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Every source that could take the number says it does not know the parcel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          },
          "405": {
            "description": "The route accepts POST only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or concurrency reached, or the upstream is rate limiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before repeating the request. After a failed lookup: until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          },
          "502": {
            "description": "No enabled source answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the server asks the upstream again, or longer when the upstream asked for more"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParcelInput"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Bearer token required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before another request can succeed"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ParcelInput": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "minLength": 4,
            "maxLength": 80
          },
          "carrier": {
            "type": "string"
          },
          "postcode": {
            "type": [
              "string",
              "null"
            ]
          },
          "postcodeCountry": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\s*[A-Za-z]{2}\\s*$",
            "description": "The postcode's country as an ISO 3166-1 alpha-2 code, for a postcode from outside the carrier's home country. Without one, the postcode is read as the carrier's home country's."
          },
          "trackingUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "phoneDigits": {
            "type": [
              "string",
              "null"
            ],
            "description": "The last digits of the recipient's or sender's phone, for a carrier whose catalog entry has a phoneDigits input. Only that carrier's own lookup reads them; carriers that do not ask for them ignore them."
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 35,
            "description": "The reader's language as a BCP 47 tag, such as fr or de-CH. Carriers whose tracker words its scans in it answer in it; the others ignore it."
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "countryHint": {
            "type": [
              "string",
              "null"
            ],
            "deprecated": true,
            "description": "Accepted for compatibility; it no longer affects a lookup."
          }
        },
        "required": [
          "number"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "Detection": {
        "type": "object",
        "required": [
          "trackingNumber",
          "carrier",
          "confidence",
          "candidates",
          "source"
        ],
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "low",
              "none"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "number",
              "link",
              "text",
              "none"
            ]
          },
          "trackingUrl": {
            "type": "string"
          }
        }
      },
      "Recognition": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unanswered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "choices",
          "asked",
          "unanswered"
        ],
        "additionalProperties": false
      },
      "TrackingResponse": {
        "type": "object",
        "required": [
          "carrier",
          "source",
          "result",
          "attempts"
        ],
        "properties": {
          "carrier": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/CarrierResult"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "direct": {
            "$ref": "#/components/schemas/CarrierResult",
            "description": "The carrier's own partial answer as it came, when a provider's fuller history became `result`."
          },
          "handoff": {
            "type": "object"
          }
        }
      },
      "CarrierResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "current_stage": {
            "type": "string"
          },
          "current_stage_source": {
            "type": "string"
          },
          "service_name": {
            "type": "string",
            "description": "The carrier's own name for the shipping service the parcel travels under, when its page shows one."
          },
          "import_charges": {
            "type": "object",
            "description": "The duties, taxes and fees the carrier lists for importing the parcel, in the currency's major unit.",
            "required": [
              "currency"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "description": "ISO 4217 code of the amounts."
              },
              "customs": {
                "type": "number",
                "description": "Customs duty and import VAT together, which the carrier collects for the customs authority."
              },
              "carrier_fee": {
                "type": "number",
                "description": "The carrier's own fee for clearing the parcel, as charged on delivery."
              },
              "carrier_fee_online": {
                "type": "number",
                "description": "That fee when the charges are paid online before delivery, while the carrier still takes payment online."
              },
              "paid": {
                "type": "boolean",
                "description": "Whether the charges are paid, when the carrier says."
              },
              "status_code": {
                "type": "string",
                "description": "The carrier's own code for where the payment stands."
              }
            }
          },
          "last_status_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_code": {
            "type": "string"
          },
          "last_update": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_delivery": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_delivery_withdrawn": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "The carrier states that its earlier delivery estimate no longer holds and gives none in its place."
          },
          "summary_only": {
            "type": "boolean",
            "description": "A current status without a scan history."
          },
          "history_truncated": {
            "type": "boolean",
            "description": "Only part of a longer scan history, such as its newest scans."
          },
          "written_ahead": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The clocks of rows the carrier holds back as written ahead of them, which a provider relaying them shows as scans."
          },
          "unread_estimates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The fields of the carrier's reply that hold a delivery estimate or slot the adapter does not read yet, by their path in the reply."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "stage_source",
                "instant"
              ],
              "properties": {
                "time": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "original_description": {
                  "type": "string",
                  "description": "The carrier's wording as it came, when the adapter moved part of it out, such as a town into location."
                },
                "stage": {
                  "type": "string"
                },
                "stage_source": {
                  "type": "string"
                },
                "instant": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stage_inferred": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "Set when the adapter gave the scan no stage and the shared wording classifier chose it, by a rule or its fallback. Absent on a stage the adapter chose."
                },
                "recipient_action": {
                  "type": "string",
                  "enum": [
                    "tax_id",
                    "duties",
                    "documents"
                  ],
                  "description": "What the scan asks the recipient to do before the parcel can move on: give their tax number, pay the import duties or taxes, or send customs documents. Set only for wordings or carrier codes that say so explicitly."
                },
                "tie_order": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The scan's place among the answer's scans at its instant, from the oldest, in the carrier's order. Set only on scans that share their instant with another."
                },
                "reporting_carrier": {
                  "type": "string",
                  "description": "The carrier a universal provider says reported the scan, by the name the provider gives it, or the catalog's where the provider's key for the carrier says more than its name."
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "Attempt": {
        "type": "object",
        "required": [
          "source",
          "kind",
          "durationMs"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ok",
              "not_found",
              "indeterminate",
              "challenge",
              "rate_limited",
              "maintenance",
              "schema",
              "input_required",
              "invalid_input",
              "transport",
              "budget"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "retryAfterMs": {
            "type": "integer",
            "minimum": 0,
            "description": "The wait this source asked for after its failure, as it came, when it named one."
          }
        },
        "additionalProperties": false
      },
      "FailureHint": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "not_found",
              "indeterminate",
              "challenge",
              "rate_limited",
              "maintenance",
              "schema",
              "input_required",
              "invalid_input",
              "transport",
              "budget"
            ],
            "description": "What failed; `invalid_input` and `not_found` are answers, not outages. Sources that fail differently report the first kind in this order that one of them gave: input_required, budget, rate_limited, challenge, maintenance, transport, schema, indeterminate, not_found, invalid_input."
          },
          "retryAfterMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Milliseconds to wait before repeating the request, what `Retry-After` says in seconds. A held failure gives the time until the server asks again, which is no sooner than the longest wait a source that could not answer asked for; otherwise it is that wait. A 400 leaves the header out, since the request has to change first."
          },
          "field": {
            "type": "string",
            "description": "With input_required, the input a source asks for, as the source names it."
          },
          "carrier": {
            "type": "string",
            "description": "With field, the catalog id of the carrier that asks for it, when it is known."
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "The input a carrier still needs; also in the hint of a failed lookup."
          },
          "carrier": {
            "type": "string",
            "description": "The catalog id of the carrier that asks for field, when it is known."
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "hint": {
            "$ref": "#/components/schemas/FailureHint"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
