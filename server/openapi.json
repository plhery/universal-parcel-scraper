{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Parcel Scraper",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input"
          },
          "401": {
            "description": "Bearer token required"
          },
          "429": {
            "description": "Rate limit or concurrency reached"
          },
          "502": {
            "description": "No enabled upstream answered"
          }
        },
        "security": []
      }
    },
    "/v1/carriers": {
      "get": {
        "operationId": "carriers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input"
          },
          "401": {
            "description": "Bearer token required"
          },
          "429": {
            "description": "Rate limit or concurrency reached"
          },
          "502": {
            "description": "No enabled upstream answered"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/detect": {
      "post": {
        "operationId": "detect",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input"
          },
          "401": {
            "description": "Bearer token required"
          },
          "429": {
            "description": "Rate limit or concurrency reached"
          },
          "502": {
            "description": "No enabled upstream answered"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 16384
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/recognize": {
      "post": {
        "operationId": "recognize",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recognition"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input"
          },
          "401": {
            "description": "Bearer token required"
          },
          "429": {
            "description": "Rate limit or concurrency reached"
          },
          "502": {
            "description": "No enabled upstream answered"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string"
                  },
                  "budgetMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120000
                  }
                },
                "required": [
                  "number"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/track": {
      "post": {
        "operationId": "track",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or required input"
          },
          "401": {
            "description": "Bearer token required"
          },
          "429": {
            "description": "Rate limit or concurrency reached"
          },
          "502": {
            "description": "No enabled upstream answered"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParcelInput"
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ParcelInput": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "minLength": 4,
            "maxLength": 80
          },
          "carrier": {
            "type": "string"
          },
          "postcode": {
            "type": [
              "string",
              "null"
            ]
          },
          "trackingUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          }
        },
        "required": [
          "number"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "Detection": {
        "type": "object",
        "required": [
          "trackingNumber",
          "carrier",
          "confidence",
          "candidates",
          "source"
        ],
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "low",
              "none"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "number",
              "link",
              "text",
              "none"
            ]
          },
          "trackingUrl": {
            "type": "string"
          }
        }
      },
      "Recognition": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unanswered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "choices",
          "asked",
          "unanswered"
        ],
        "additionalProperties": false
      },
      "TrackingResponse": {
        "type": "object",
        "required": [
          "carrier",
          "source",
          "result",
          "attempts"
        ],
        "properties": {
          "carrier": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/CarrierResult"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "kind",
                "durationMs"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "integer"
                }
              }
            }
          },
          "handoff": {
            "type": "object"
          }
        }
      },
      "CarrierResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "current_stage": {
            "type": "string"
          },
          "last_status_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_update": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_delivery": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "stage_source",
                "instant"
              ],
              "properties": {
                "time": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "stage_source": {
                  "type": "string"
                },
                "instant": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
