# Defaults for parcel-scraper serve. Optional values are blank.
HOST=127.0.0.1
PORT=8080
SCRAPER_TOKEN=
SCRAPER_DEMO_PAGE=false
# Requests per client per minute, lookups in progress at once, and how long an
# answer and a failure are shared, in milliseconds.
SCRAPER_RATE_LIMIT=30
SCRAPER_MAX_CONCURRENT=8
SCRAPER_CACHE_MS=600000
SCRAPER_FAILURE_CACHE_MS=60000
# Reverse proxies in front of the server that append to X-Forwarded-For. With 0
# the header is ignored and limits count the socket address.
SCRAPER_TRUSTED_PROXIES=0
# How this install names itself to carriers. Blank uses the package default.
SCRAPER_USER_AGENT=
# Commercial fallbacks require an explicit choice. Empty disables all providers.
SCRAPER_PROVIDERS=UPU
# Optional private browser service and local Chromium executable.
FLARESOLVERR_URL=
TRACKING_CHROMIUM_PATH=
# Replaces the Ukrposhta app bearer built into the adapter. Blank uses the built-in one.
UKRPOSHTA_TRACKING_TOKEN=

# Optional replacement for LBC Express's shared guest-tracking key.
# An empty value disables the direct tier; omit it to use the included key.
# LBC_TRACKING_KEY=

# Optional replacement for Evri UK's shared guest-tracking key.
# An empty value disables the direct tier; omit it to use the included key.
# EVRI_UK_TRACKING_KEY=

# Optional replacement for STO Express's shared request-signing salt.
# An empty value disables the direct tier; omit it to use the included salt.
# STO_TRACKING_SALT=

# Optional replacement for the J&T Indonesia app's shared request-signing secret.
# An empty value turns J&T tracking off; omit it to use the included secret.
# J_AND_T_SIGNING_SECRET=

# Refresh token of an InPost account, for Mondial Relay's app backend. Blank
# leaves Mondial Relay to the browser service.
# MONDIAL_RELAY_REFRESH_TOKEN=
